                                    "content": "<h4>Aanvrager</h4>\n<section>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Burgerservicenummer</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVaststelling?.persoon?.bsn || '-') }}} </dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Naam</dd>\n        <dt class=\"col-6\">{{{(data.gegevensVaststelling?.persoon?.achternaam || data.gegevensVaststelling?.persoon?.voorvoegsel || data.gegevensVaststelling?.persoon?.achternaam) ?  data.gegevensVaststelling?.persoon?.voornamen + ' ' + data.gegevensVaststelling?.persoon?.voorvoegsel + ' ' + data.gegevensVaststelling?.persoon?.achternaam :  '-' }}} </dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Geboortedatum</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVaststelling?.persoon?.geboortedatum ? moment(data.gegevensVaststelling?.persoon?.geboortedatum).format('DD-MM-yyyy') : '-') }}} </dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Verblijfsstatus</dd>\n        <dt class=\"col-6\">\n            {{{ (data?.gegevensVaststelling?.persoon?.nationaliteitOfVerblijfsstatus === 'NEDERLANDSE_NATIONALITEIT' ? 'Ik heb de Nederlandse nationaliteit' : '') }}}\n            {{{ (data?.gegevensVaststelling?.persoon?.nationaliteitOfVerblijfsstatus === 'EU_ONDERDAAN' ? 'Ik ben EU onderdaan' : '') }}}\n            {{{ (data?.gegevensVaststelling?.persoon?.nationaliteitOfVerblijfsstatus === 'GELDIGE_VERBLIJFSVERGUNNING' ? 'Ik heb een geldige verblijfsvergunning' : '') }}}\n            {{{ (data?.gegevensVaststelling?.persoon?.nationaliteitOfVerblijfsstatus === 'GEEN_VERBLIJFSVERGUNNING' ? 'Ik heb geen verblijfsvergunning' : '') }}}\n            {{{ (data?.gegevensVaststelling?.persoon?.nationaliteitOfVerblijfsstatus === 'VERLOPEN_VERBLIJFSVERGUNNING' ? 'Mijn verblijfsvergunning is verlopen' : '') }}}\n            {{{ (data?.gegevensVaststelling?.persoon?.nationaliteitOfVerblijfsstatus ? '' : '-') }}}\n        </dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Adres</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVaststelling?.persoon?.verblijfadres?.straatnaam || '-') }}} {{{data.gegevensVaststelling?.persoon?.verblijfadres?.huisnummer }}} </dt>\n        <dd class=\"col-6\">&nbsp;</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVaststelling?.persoon?.verblijfadres?.postcode || '-') }}} {{{ data.gegevensVaststelling?.persoon?.verblijfadres?.woonplaatsnaam }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Woonsituatie</dd>\n        <dt class=\"col-6\">{{{ ({ \"BRP\": \"Adres volgens brp\", \"PARTNER_INWONEND\": \"Partner woont in\", \"ELDERS\": \"Woont elders\", \"DETENTIE\": \"Zit in detentie\", \"DAKLOOS\": \"Is dakloos\", \"ONBEKEND\": \"Onbekend\" }[data.gegevensVaststelling?.persoon?.woonsituatie] || '-') }}} </dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Reden niet ingeschreven op verblijfadres</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVaststelling?.persoon?.verblijfadres?.toelichtingNietIngeschrevenOpVerblijfadres || '-') }}} </dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Beschikbaarheid (u/week)</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVaststelling?.beschikbaarheidAanvrager?.uurPerWeek || '-') }}} </dt>\n    </dl>\n</section>\n",
