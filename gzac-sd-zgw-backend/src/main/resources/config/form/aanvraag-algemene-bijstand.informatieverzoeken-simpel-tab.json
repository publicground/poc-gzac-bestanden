{
    "display": "form",
    "components": [
        {
            "label": "persoon",
            "key": "gegevensVanuitVaststelling",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "informatieverzoeken",
            "key": "informatieverzoeken",
            "defaultValue": [],
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "openzaak",
            "key": "openzaak",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "persoon",
            "key": "gegevensVaststelling",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "headerIdentificatie",
            "customClass": "border-around-formio-container",
            "tableView": false,
            "validateWhenHidden": false,
            "customConditional": "data.informatieverzoeken?.length > 0 ? show = true : show = false;",
            "key": "headerIdentificatie",
            "type": "container",
            "title": "header",
            "input": true,
            "components": [
                {
                    "label": "headerHTML",
                    "content": "<section class=\"container-fluid p-0\">\n  <div class=\"bg-light border-bottom m-0 py-1 px-3\">\n    <div class=\"row align-items-center mx-0\">\n      <div class=\"col-12 px-1\">\n        <div style=\"font-size: 1.1rem; font-weight: normal; line-height: 1.4; margin: 0; white-space: nowrap; overflow: visible; text-overflow: clip;\" title=\"{{ data.openzaak?.identificatie || '-' }}\">{{{ data.openzaak?.identificatie || '-' }}}</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- BODY MET REGELS -->\n  <div class=\"row align-items-center mx-0 gx-0 px-3 py-2\">\n\n    <!-- LINKERKOLOM -->\n    <div class=\"col-4 mb-0 p-0\">\n      <div class=\"row mb-1 mx-0\">\n        <div class=\"col-6 p-0\">Aanvrager:</div>\n        <div class=\"col-6\"><strong>{{{ data.gegevensVaststelling?.aanvrager?.achternaam ? (data.gegevensVaststelling?.aanvrager?.achternaam + ((data.gegevensVaststelling?.aanvrager?.voorvoegsel || data.gegevensVaststelling?.aanvrager?.tussenvoegsel) ? ', ' + (data.gegevensVaststelling?.aanvrager?.voorvoegsel || data.gegevensVaststelling?.aanvrager?.tussenvoegsel) : '')) : '-' }}}</strong></div>\n      </div>\n      <div class=\"row mb-0 mx-0\">\n        <div class=\"col-6 p-0\">Partner:</div>\n        <div class=\"col-6\"><strong>{{{ data.gegevensVaststelling?.partner?.achternaam ? (data.gegevensVaststelling?.partner?.achternaam + ((data.gegevensVaststelling?.partner?.voorvoegsel || data.gegevensVaststelling?.partner?.tussenvoegsel) ? ', ' + (data.gegevensVaststelling?.partner?.voorvoegsel || data.gegevensVaststelling?.partner?.tussenvoegsel) : '')) : '-' }}}</strong></div>\n      </div>\n    </div>\n\n    <div class=\"col-4 mb-0 px-1\">\n      <div class=\"row mb-1 mx-0\"><div class=\"col-6\">Geb. datum:</div><div class=\"col-6\"><strong>{{{ data.gegevensVaststelling?.aanvrager?.geboortedatum ? moment(data.gegevensVaststelling.aanvrager.geboortedatum).format('DD-MM-YYYY') : '-' }}}</strong></div></div>\n      <div class=\"row mb-0 mx-0\"><div class=\"col-6\">Geb. datum partner:</div><div class=\"col-6\"><strong>{{{ data.gegevensVaststelling?.partner?.geboortedatum ? moment(data.gegevensVaststelling.partner.geboortedatum).format('DD-MM-YYYY') : '-' }}}</strong></div></div>\n    </div>\n\n    <div class=\"col-4 mb-0 px-1\">\n      <div class=\"row mb-1 mx-0\"><div class=\"col-6\">BSN:</div><div class=\"col-6\"><strong>{{{ data.gegevensVaststelling?.aanvrager?.bsn || '-' }}}</strong></div></div>\n      <div class=\"row mb-0 mx-0\"><div class=\"col-6\">BSN partner:</div><div class=\"col-6\"><strong>{{{ data.gegevensVaststelling?.partner?.bsn || '-' }}}</strong></div></div>\n    </div>\n\n  </div>\n</section>",
                    "refreshOnChange": false,
                    "customClass": "no-border-around-formio-container",
                    "key": "html",
                    "type": "htmlelement",
                    "tableView": false,
                    "input": true
                }
            ]
        },
        {
            "label": "informatieverzoeken Grid",
            "reorder": false,
            "addAnotherPosition": "bottom",
            "layoutFixed": false,
            "enableRowGroups": false,
            "initEmpty": false,
            "hideLabel": true,
            "disabled": true,
            "tableView": false,
            "validateWhenHidden": false,
            "key": "informatieverzoeken",
            "customConditional": "data.informatieverzoeken?.length > 0 ? show = true : show = false;",
            "customClass": "formio-component-datagrid-borderless",
            "type": "datagrid",
            "input": true,
            "components": [
                {
                    "label": "Columns",
                    "hideLabel": true,
                    "columns": [
                        {
                            "components": [
                                {
                                    "label": "htmlElement",
                                    "content": "{{ rowIndex > 0 ? '<hr style=\"border:0;height:3px;background:linear-gradient(to right, rgba(0,0,0,0), rgba(0,0,0,.45), rgba(0,0,0,0));margin:1rem 0;\">' : '' }}\n\n<h4>Verzoek</h4>\n<br>\n<section>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Datum uitgezet</dd>\n        <dt class=\"col-6\">{{{ row.verzoek?.datumUitgezet ? moment(row.verzoek.datumUitgezet).format('DD-MM-yyyy') : '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Uitgezet door</dd>\n        <dt class=\"col-6\">{{{ row.verzoek?.uitgezetDoor || '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Deadline</dd>\n        <dt class=\"col-6\">{{{ row.verzoek?.deadlineInformatieverzoek ? moment(row.verzoek.deadlineInformatieverzoek).format('DD-MM-yyyy') : '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Hersteltermijn van toepassing</dd>\n        <dt class=\"col-6\">{{{ { 'JA':'Ja', 'NEE':'Nee' }[row.verzoek?.hersteltermijn] || '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Toelichting zaakbehandelaar</dd>\n        <dt class=\"col-6\">{{ row.verzoek?.berichtNaarAanvrager || '-' }}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6 font-bold\">Status</dd>\n        <dt class=\"col-6\">{{ row.verzoek?.status || '-' }}</dt>\n    </dl>\n    <dl class=\"row mb-0 {{ !!row.verzoek?.geannuleerdDoor ? '' : 'd-none'}}\">\n        <dd class=\"col-6 font-bold\">Geannuleerd door</dd>\n        <dt class=\"col-6\">{{ row.verzoek?.geannuleerdDoor || '-' }}</dt>\n    </dl>\n    <dl class=\"row mb-0 {{ !!row.reactie?.reactiedatum ? '' : 'd-none'}}\">\n        <dd class=\"col-6 font-bold\">Datum reactie ontvangen</dd>\n        <dt class=\"col-6\">{{{ row.reactie?.reactiedatum ? moment(row.reactie.reactiedatum).format('DD-MM-yyyy') : '-' }}}</dt>\n    </dl>\n</section>",
                                    "refreshOnChange": false,
                                    "key": "html1",
                                    "type": "htmlelement",
                                    "hideLabel": true,
                                    "tableView": false,
                                    "input": true
                                }
                            ],
                            "width": 12,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "currentWidth": 12
                        }
                    ],
                    "key": "columns",
                    "type": "columns",
                    "input": false,
                    "tableView": false
                }
            ]
        },
        {
            "label": "createdon",
            "applyMaskOn": "change",
            "tableView": true,
            "key": "createdOn",
