{
    "display": "form",
    "components": [
        {
            "label": "BSN uit bevraging",
            "key": "pv.aanvraagPersoon.bsn",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "BSN",
            "key": "pv.bsn",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "Melding BRP niet gevonden",
            "tag": "div",
            "className": "alert alert-info",
            "refreshOnChange": true,
            "key": "meldingBrpNietGevonden",
            "type": "htmlelement",
            "input": false,
            "tableView": false,
            "content": "<h4>BRP gegevens niet gevonden</h4>\n<p>\n  Het opgegeven BSN <strong>{{{data.pv?.bsn || '-'}}}</strong> kan niet gevonden worden in het BRP.<br/>\n  Dit heeft de volgende oorzaak:<br/>\n  <strong>BSN niet gevonden in Suwinet, of geen connectie kunnen maken.</strong>\n</p>\n<p class=\"pt-1\">\n  Selecteer hieronder een vervolgactie:\n</p>"
        },
        {
            "key": "pv.vervolgActieBrpNietGevonden",
            "type": "radio",
            "input": true,
            "label": "Vervolgactie",
            "inline": false,
            "tableView": false,
            "values": [
                {
                    "label": "Probeer het opnieuw",
                    "value": "OPNIEUW",
                    "shortcut": ""
                },
                {
                    "label": "Doorgaan zonder BRP gegevens",
                    "value": "ZONDER-BRP",
                    "shortcut": ""
                },
                {
                    "label": "Ik heb de BRP gegevens handmatig opgezocht",
                    "value": "HANDMATIG-INGEVOERD",
                    "shortcut": ""
                }
            ],
            "validate": {
                "required": true
            },
            "optionsLabelPosition": "right"
        },
        {
            "label": "Uitleg vervolgacties",
            "tag": "div",
            "className": "alert alert-info",
            "key": "uitlegVervolgActies",
            "type": "htmlelement",
            "input": false,
            "tableView": false,
            "conditional": {
                "show": true,
                "when": "pv.vervolgActieBrpNietGevonden",
                "eq": "OPNIEUW"
            },
            "content": "<p>\nKies <strong>\"Probeer het opnieuw\"</strong> als je met hetzelfde BSN de BRP nogmaals wilt bevragen.\n</p>"
        },
        {
            "label": "Uitleg vervolgacties",
            "tag": "div",
            "className": "alert alert-info",
            "key": "uitlegVervolgActiesZonderBrp",
            "type": "htmlelement",
            "input": false,
            "tableView": false,
            "conditional": {
                "show": true,
                "when": "pv.vervolgActieBrpNietGevonden",
                "eq": "ZONDER-BRP"
            },
            "content": "<p>\nKies <strong>\"Doorgaan zonder BRP gegevens\"</strong> als je het proces wilt vervolgen zonder BRP gegevens.\nHet proces gaat dan verder naar de gebruikerstaak <strong>\"Vaststellen persoon\"</strong>.\n</p>"
        },

        {
            "label": "BSN",
            "applyMaskOn": "change",
            "tableView": true,
            "validate": {
                "required": true,
                "custom": "valid = [...input].reverse().reduce( (accumulator, currentValue, currentIndex) => Number(accumulator) + (currentValue * (currentIndex === 0 ? -1 : currentIndex + 1)), 0 ) % 11 === 0;",
                "minLength": 9,
                "maxLength": 9
            },
            "validateWhenHidden": false,
            "errors": {
                "custom": "Voer een valide BSN in.",
                "minLength": "Voer een valide BSN in.",
                "maxLength": "Voer een valide BSN in."
            },
            "key": "pv.bsn",
            "type": "textfield",
            "input": true,
            "customConditional": "show = data.pv?.vervolgActieBrpNietGevonden === 'HANDMATIG-INGEVOERD';"
        },
        {
            "label": "Columns",
            "columns": [
                {
                    "components": [
                        {
                            "label": "Voorletters",
                            "applyMaskOn": "change",
                            "tableView": true,
                            "validateWhenHidden": false,
                            "key": "pv.aanvraagPersoon.voorletters",
                            "type": "textfield",
                            "input": true
                        }
                    ],
                    "width": 2,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 2
                },
                {
                    "components": [
                        {
                            "label": "Voorvoegsel(s)",
                            "applyMaskOn": "change",
                            "tableView": true,
                            "validateWhenHidden": false,
                            "key": "pv.aanvraagPersoon.voorvoegsel",
                            "type": "textfield",
                            "input": true
                        }
                    ],
                    "width": 2,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 2
                },
                {
                    "components": [
                        {
                            "label": "Achternaam",
                            "applyMaskOn": "change",
                            "tableView": true,
                            "validate": {
                                "required": true,
                                "customMessage": "Dit veld is verplicht."
                            },
                            "validateWhenHidden": false,
                            "key": "pv.aanvraagPersoon.achternaam",
                            "type": "textfield",
                            "input": true
                        }
                    ],
                    "size": "md",
                    "width": 8,
                    "currentWidth": 8
                }
            ],
            "key": "columns2",
            "type": "columns",
            "customConditional": "show = data.pv?.vervolgActieBrpNietGevonden === 'HANDMATIG-INGEVOERD';",
            "input": false,
            "tableView": false
        },
        {
            "label": "Voornamen",
            "placeholder": "Alle voornamen",
            "tableView": true,
            "validate": {
                "required": true
            },
            "validateWhenHidden": false,
            "key": "pv.aanvraagPersoon.voornamen",
            "type": "textfield",
            "input": true,
            "customConditional": "show = data.pv?.vervolgActieBrpNietGevonden === 'HANDMATIG-INGEVOERD';"
        },
        {
            "label": "Geboortedatum",
            "tableView": true,
            "validate": {
                "required": true
            },
            "key": "pv.geboortedatumAanvraag",
            "type": "datetime",
            "input": true,
            "widget": {
                "type": "calendar"
            },
            "format": "dd-MM-yyyy",
            "enableTime": false,
            "customConditional": "show = data.pv?.vervolgActieBrpNietGevonden === 'HANDMATIG-INGEVOERD';"
        },
        {
            "label": "Toelichting",
            "placeholder": "Licht toe hoe je de BRP gegevens hebt achterhaald",
            "applyMaskOn": "change",
            "autoExpand": false,
            "tableView": true,
            "validate": {
                "required": true
            },
            "validateWhenHidden": false,
            "key": "pv.toelichtingConsulent",
            "type": "textarea",
            "input": true,
            "customConditional": "show = data.pv?.vervolgActieBrpNietGevonden === 'HANDMATIG-INGEVOERD';"
        },

        {
            "label": "BSN (BRP)",
            "key": "pv.brpPersoonsgegevensInfo.bsn",
            "type": "hidden",
            "input": true,
            "clearOnHide": true,
            "tableView": false,
            "calculateValue": "if (data.pv?.vervolgActieBrpNietGevonden === 'HANDMATIG-INGEVOERD' && data.pv?.bsn) { value = data.pv.bsn; }"
        },
        {
            "label": "Voornamen (BRP)",
            "key": "pv.brpPersoonsgegevensInfo.voornamen",
            "type": "hidden",
            "input": true,
            "clearOnHide": true,
            "tableView": false,
            "calculateValue": "if (data.pv?.vervolgActieBrpNietGevonden === 'HANDMATIG-INGEVOERD' && data.pv?.aanvraagPersoon?.voornamen) { value = data.pv.aanvraagPersoon.voornamen; }"
        },
        {
            "label": "Voorvoegsel (BRP)",
            "key": "pv.brpPersoonsgegevensInfo.voorvoegsel",
            "type": "hidden",
            "input": true,
            "clearOnHide": true,
            "tableView": false,
            "calculateValue": "if (data.pv?.vervolgActieBrpNietGevonden === 'HANDMATIG-INGEVOERD' && data.pv?.aanvraagPersoon?.voorvoegsel) { value = data.pv.aanvraagPersoon.voorvoegsel; }"
        },
        {
            "label": "Achternaam (BRP)",
            "key": "pv.brpPersoonsgegevensInfo.achternaam",
            "type": "hidden",
            "input": true,
            "clearOnHide": true,
            "tableView": false,
            "calculateValue": "if (data.pv?.vervolgActieBrpNietGevonden === 'HANDMATIG-INGEVOERD' && data.pv?.aanvraagPersoon?.achternaam) { value = data.pv.aanvraagPersoon.achternaam; }"
        },
        {
            "label": "Geboortedatum (BRP raw)",
            "key": "pv.geboortedatumBrp",
            "type": "hidden",
            "input": true,
            "tableView": false,
            "calculateValue": "if (data.pv?.vervolgActieBrpNietGevonden === 'HANDMATIG-INGEVOERD' && data.pv?.geboortedatumAanvraag) { value = data.pv.geboortedatumAanvraag; }"
        },
        {
            "label": "Geboortedatum (BRP geformatteerd bronveld)",
            "key": "pv.brpPersoonsgegevensInfo.geboortedatum",
            "type": "hidden",
            "input": true,
            "clearOnHide": true,
            "tableView": false,
            "calculateValue": "if (data.pv?.vervolgActieBrpNietGevonden === 'HANDMATIG-INGEVOERD' && data.pv?.geboortedatumAanvraag) { value = moment(data.pv.geboortedatumAanvraag).format('YYYY-MM-DD'); }"
        },
        {
            "label": "Indienen",
            "action": "custom",
            "showValidations": false,
            "disableOnInvalid": true,
            "tableView": false,
            "key": "submit",
            "type": "button",
            "custom": "form.submit(); if (data.pv?.vervolgActieBrpNietGevonden === 'ZONDER-BRP') {delete data.pv?.brpPersoonsgegevensInfo;} component.disabled = true;",
            "input": true
        }
    ]
}
