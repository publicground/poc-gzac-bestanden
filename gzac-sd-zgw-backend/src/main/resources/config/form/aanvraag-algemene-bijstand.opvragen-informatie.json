        {
            "label": "Informatieverzoek uitzetten",
            "action": "custom",
            "showValidations": false,
            "disableOnInvalid": true,
            "tableView": false,
            "key": "submit",
            "customConditional": "if (data.pv.verzoek.woonsituatie.opTeVragenInformatie.length > 0 || data.pv.verzoek.inkomen.opTeVragenInformatie.length > 0 || data.pv.verzoek.vermogen.opTeVragenInformatie.length > 0) {\n  component.disabled = false;\n} else {\n  component.disabled = true;\n}",
            "type": "button",
            "custom": "const verzoekItems = [];\nif (data.pv.verzoek.woonsituatie.opTeVragenInformatie.length > 0) { verzoekItems.push(...data.pv.verzoek.woonsituatie.opTeVragenInformatie); }\nif (data.pv.verzoek.inkomen.opTeVragenInformatie.length > 0) { verzoekItems.push(...data.pv.verzoek.inkomen.opTeVragenInformatie); }\nif (data.pv.verzoek.vermogen.opTeVragenInformatie.length > 0) { verzoekItems.push(...data.pv.verzoek.vermogen.opTeVragenInformatie); }\ndata.pv.verzoek.opTeVragenInformatie = verzoekItems; \ndata.pv.verzoek.documenten = verzoekItems.map((item, index) => `/informatieverzoek/opTeVragenInformatie/${index}/documentUpload`);\nconst submitVerzoek = _.cloneDeep(data.pv.verzoek);\ndelete submitVerzoek.woonsituatie;\ndelete submitVerzoek.inkomen;\ndelete submitVerzoek.vermogen;\ndata.informatieverzoeken.push({'verzoek': submitVerzoek});\nform.submit(); \ncomponent.disabled = true;",
            "input": true
