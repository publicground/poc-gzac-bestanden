        {
            "label": "soort aanvraag",
            "key": "pv.dossierType",
            "type": "hidden",
            "properties": {
                "sourceKey": "case:definitionId.name"
            },
            "input": true,
            "tableView": false
        },
        {
            "label": "selectBoxItems",
            "customDefaultValue": "window.forceRefresh = instance;\nfetch('../api/v1/object/management/configuration/ALO: Informatieverzoek Items/objects', { method: 'GET', headers: { 'Authorization': 'Bearer ' + localStorage.getItem('formioToken') } })\n.then(response => response.json())\n.then(informatieverzoekItems => {\n const items = informatieverzoekItems.filter(item => item.record.data.informatieverzoekItem.dossierType.find(type => type === data.pv.dossierType));\n const selectBoxes = {};\n woonsituatie = items.filter(item => item.record.data.informatieverzoekItem.categorie.find(categorie => categorie === 'woonsituatie'));\n inkomen = items.filter(item => item.record.data.informatieverzoekItem.categorie.find(categorie => categorie === 'inkomen'));\n vermogen = items.filter(item => item.record.data.informatieverzoekItem.categorie.find(categorie => categorie === 'vermogen'));\n selectBoxes.woonsituatie = structuredClone(woonsituatie);\n selectBoxes.inkomen = structuredClone(inkomen);\n selectBoxes.vermogen = structuredClone(vermogen);\n window.forceRefresh.setValue(selectBoxes);\n});\n",
            "key": "pv.selectBoxItems",
            "type": "hidden",
            "tableView": true,
            "refreshOnChange": true,
            "input": true
        },
        {
            "label": "Informatieverzoek",
            "key": "informatieverzoeken",
            "type": "hidden",
            "defaultValue": [],
            "input": true
        },
        {
            "label": "datum uitgezet",
            "key": "pv.verzoek.datumUitgezet",
            "type": "hidden",
            "calculateValue": "value = moment();",
            "input": true,
            "tableView": false
        },
        {
            "label": "Uitgezet door",
            "customDefaultValue": "value = JSON.parse(localStorage.getItem('userIdentity'))?.firstName + ' ' + JSON.parse(localStorage.getItem('userIdentity'))?.lastName;",
            "key": "pv.verzoek.uitgezetDoor",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "Hersteltermijn in dagen",
            "type": "hidden",
            "conditional": {
                "eq": "JA",
                "show": true,
                "when": "pv.verzoek.hersteltermijn"
            },
            "calculateValue": "value = moment(data.pv.verzoek.deadlineInformatieverzoek).endOf('day').diff(moment().startOf('day'), 'days');",
            "key": "pv.verzoek.hersteltermijnInDagen",
            "input": true,
            "tableView": false
        },
