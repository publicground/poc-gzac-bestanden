{
    "display": "form",
    "components": [
        {
            "label": "statusOmschrijving",
            "key": "openzaak",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "HTML",
            "tag": "div",
            "className": "alert alert-info",
            "content": "<p>De taak 'Contactgegevens wijzigen' kan niet worden gestart, omdat het proces zich in de bezwaarperiode bevindt.</p>",
            "refreshOnChange": false,
            "key": "html1",
            "customConditional": "show = data.openzaak?.statusOmschrijving === 'Beslist'",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "HTML",
            "tag": "div",
            "className": "alert alert-info",
            "content": "<p>Dit dossier is al afgehandeld.</p>",
            "refreshOnChange": false,
            "key": "html1",
            "customConditional": "show = data.openzaak?.statusOmschrijving === 'Afgehandeld'",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "HTML",
            "content": "<p>Wijzigen contactgegevens aanvrager</p><br>",
            "refreshOnChange": false,
            "key": "html2",
            "customConditional": "show = !['Afgehandeld', 'Beslist'].includes(data.openzaak?.statusOmschrijving)",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "Doorgaan",
            "action": "custom",
            "showValidations": false,
            "disableOnInvalid": true,
            "tableView": false,
            "key": "submit",
            "customConditional": "show = !['Afgehandeld', 'Beslist'].includes(data.openzaak?.statusOmschrijving)",
            "type": "button",
            "custom": "form.submit(); component.disabled = true;",
            "input": true
        }
    ]
}