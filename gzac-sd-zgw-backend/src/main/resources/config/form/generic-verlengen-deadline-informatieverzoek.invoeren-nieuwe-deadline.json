{
    "display": "form",
    "components": [
        {
            "label": "verzoek",
            "key": "pv.verzoek",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "HTML",
            "className": "alert alert-info",
            "content": "Pas hieronder de deadline van het informatieverzoek aan, zodat de aanvrager meer tijd heeft om de aangevraagde stukken aan te leveren.",
            "refreshOnChange": false,
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "Deadline informatieverzoek",
            "format": "dd-MM-yyyy",
            "tableView": true,
            "datePicker": {
                "disableWeekends": false,
                "disableWeekdays": false,
                "minDate": "moment().add(1,'days').startOf('day')"
            },
            "enableTime": false,
            "validate": {
                "required": true
            },
            "enableMinDateInput": false,
            "enableMaxDateInput": false,
            "validateWhenHidden": false,
            "key": "pv.deadlineInformatieverzoek",
            "customDefaultValue": "value = data.pv.verzoek?.deadlineInformatieverzoek",
            "type": "datetime",
            "input": true,
            "widget": {
                "type": "calendar",
                "displayInTimezone": "viewer",
                "locale": "en",
                "useLocaleSettings": false,
                "allowInput": true,
                "mode": "single",
                "enableTime": false,
                "noCalendar": false,
                "format": "dd-MM-yyyy",
                "hourIncrement": 1,
                "minuteIncrement": 1,
                "time_24hr": false,
                "minDate": "moment().add(1,'days').startOf('day')",
                "disableWeekends": false,
                "disableWeekdays": false,
                "maxDate": null
            }
        },
        {
            "label": "Hersteltermijn in dagen",
            "type": "hidden",
            "calculateValue": "value = moment(data.pv?.deadlineInformatieverzoek).endOf('day').diff(moment().startOf('day'), 'days');",
            "key": "pv.hersteltermijnInDagen",
            "input": true,
            "tableView": false
        },
        {
            "label": "Doorgaan",
            "action": "custom",
            "showValidations": false,
            "disableOnInvalid": true,
            "tableView": false,
            "key": "submit",
            "type": "button",
            "custom": "if (data.pv.deadlineInformatieverzoek) {\n  const picked = new Date(data.pv.deadlineInformatieverzoek);\n  const year = picked.getFullYear();\n  const month = picked.getMonth();\n  const day = picked.getDate();\n  const utcDate = new Date(Date.UTC(year, month, day, 0, 0, 0));\n  data.pv.deadlineInformatieverzoek = utcDate.toISOString();\n}\n\ndata.pv.verzoek = {...data.pv.verzoek,  hersteltermijnInDagen: data.pv.hersteltermijnInDagen,\n    deadlineInformatieverzoek: data.pv.deadlineInformatieverzoek\n}; form.submit(); component.disabled = true;",
            "input": true
        }
    ]
}