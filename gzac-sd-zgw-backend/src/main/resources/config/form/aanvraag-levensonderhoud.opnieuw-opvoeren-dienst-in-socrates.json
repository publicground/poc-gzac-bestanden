{
    "display": "form",
    "components": [
        {
            "label": "Aanvrager",
            "key": "pv.gegevensVaststelling",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "Socrates error",
            "key": "pv.socratesError",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "Overslaan",
            "key": "pv.overslaan",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "Titel blok",
            "content": "<h4>Opvoer in Socrates is mislukt. Probeer het opnieuw of raadpleeg Socrates en voer zo nodig de gegevens handmatig op.</h4>",
            "refreshOnChange": false,
            "customClass": "alert alert-warning",
            "key": "titelBlok",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "type": "htmlelement",
            "key": "pv.socratesError",
            "label": "Error",
            "input": false,
            "tableView": false,
            "content": "<div class='card border-danger mb-3 shadow-sm'>\n    <div class='card-header bg-danger m-0 text-white d-flex justify-content-between align-items-center'>\n        <strong class=\"pl-2\">Foutmelding</strong>\n        <span class='badge badge-light text-danger pr-1'>{{ data.pv.socratesError.errorCode || 'ERROR' }}</span>\n    </div>\n    <div class='card-body'>\n        <div class='mb-3'>\n            <div class='text-uppercase text-muted medium'>Message</div>\n            <div class='text-break pt-1' style='word-break:break-word;'>{{ data.pv.socratesError.message || '-' }}</div>\n        </div>\n        <div class='mb-3'>\n            <div class='text-uppercase text-muted medium'>Cause</div>\n            <div class='text-break pt-1' style='word-break:break-word;'>{{ data.pv.socratesError.cause || '-' }}</div>\n        </div>\n        <div class='mb-3'>\n            <div class='text-uppercase text-muted medium'>Body</div>\n            <div class='text-break pt-1' style='word-break:break-word;'>{{ data.pv.socratesError.body || '-' }}</div>\n        </div>\n        <details class='mt-2'>\n            <summary class='btn btn-sm btn-outline-secondary'>Toon raw JSON</summary>\n            <pre class='bg-light p-2 mt-2 mb-0 rounded text-monospace' style='white-space:pre-wrap;word-break:break-word;'>{{ JSON.stringify(data.pv.socratesError || {}, null, 2) }}</pre>\n        </details>\n    </div>\n</div>"
        },
        {
            "label": "Columns",
            "columns": [
                {
                    "components": [
                        {
                            "label": "Overslaan",
                            "action": "custom",
                            "theme": "warning",
                            "showValidations": false,
                            "disableOnInvalid": true,
                            "tableView": false,
                            "key": "overslaan",
                            "type": "button",
                            "custom": "data.pv.overslaan = true; form.submit(); component.disabled = true;",
                            "input": true
                        }
                    ],
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 8,
                    "width": 8
                },
                {
                    "components": [
                        {
                            "label": "Probeer het opnieuw",
                            "key": "submit",
                            "type": "button",
                            "input": true,
                            "action": "custom",
                            "custom": "form.submit(); component.disabled = true;",
                            "tableView": false,
                            "showValidations": false,
                            "disableOnInvalid": true
                        }
                    ],
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 4,
                    "width": 4
                }
            ],
            "key": "columns",
            "type": "columns",
            "input": false,
            "tableView": false
        }
    ]
}