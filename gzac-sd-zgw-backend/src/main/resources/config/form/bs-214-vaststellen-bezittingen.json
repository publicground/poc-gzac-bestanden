{
    "display": "form",
    "components": [
        {
            "label": "vastgesteldeBezittingen",
            "key": "pv.vastgesteldeBezittingen",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "aanvraagBezittingen",
            "key": "pv.aanvraagBezittingen",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "Vaststellen bezittingen",
            "content": "<h2 class=\"mb-3\">Vaststellen bezittingen</h2>",
            "refreshOnChange": false,
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "Er zijn geen opgegeven bezittingen gevonden. Wil je deze alsnog toevoegen?",
            "optionsLabelPosition": "right",
            "inline": false,
            "tableView": false,
            "defaultValue": "NEE",
            "values": [
                {
                    "label": "Ja",
                    "value": "JA",
                    "shortcut": ""
                },
                {
                    "label": "Nee",
                    "value": "NEE",
                    "shortcut": ""
                }
            ],
            "validate": {
                "required": true
            },
            "validateWhenHidden": false,
            "key": "pv.bezittingenVaststellen",
            "customConditional": "show = data.pv.aanvraagBezittingen.length === 0;",
            "type": "radio",
            "input": true
        },
        {
            "label": "Bezittingen",
            "reorder": false,
            "addAnotherPosition": "bottom",
            "layoutFixed": false,
            "enableRowGroups": false,
            "initEmpty": false,
            "hideLabel": true,
            "tableView": false,
            "validateWhenHidden": false,
            "key": "pv.bezittingen",
            "customConditional": "show =\n    data.pv.bezittingenVaststellen === 'JA' ||\n    (\n        !data.pv.bezittingenVaststellen &&\n        (\n            data.pv.vastgesteldeBezittingen.length > 0 ||\n            data.pv.aanvraagBezittingen.length > 0\n        )\n    );\n",
            "addAnother": "Bezitting toevoegen",
            "type": "datagrid",
            "input": true,
            "components": [
                {
                    "label": "Columns",
                    "columns": [
                        {
                            "components": [
                                {
                                    "label": "Soort vermogen",
                                    "widget": "choicesjs",
                                    "tableView": true,
                                    "dataSrc": "custom",
                                    "data": {
                                        "custom": "values = [\n                { \"code\": \"2\", \"name\": \"Contanten\" },\n                { \"code\": \"4\", \"name\": \"Overig onroerend goed\" },\n                { \"code\": \"5\", \"name\": \"Waardepapieren\" },\n                { \"code\": \"6\", \"name\": \"Motorvoertuigen\" },\n                { \"code\": \"7\", \"name\": \"Caravans\" },\n                { \"code\": \"8\", \"name\": \"Antiek/sieraden\" },\n                { \"code\": \"9\", \"name\": \"Overige bezittingen\" },\n                { \"code\": \"10\", \"name\": \"Aandeel onverdeelde boedel\" },\n                { \"code\": \"11\", \"name\": \"Leningen aan derden\" },\n                { \"code\": \"13\", \"name\": \"Levensverzekering/belegging niet gekoppeld aan hypotheek\" },\n                { \"code\": \"16\", \"name\": \"Beleggingsproduct (Aandeel, Lease, Effect, Obligatie, e.d.)\" },\n                { \"code\": \"18\", \"name\": \"Aanspraak op erfenis binnen zes maanden\" },\n                { \"code\": \"19\", \"name\": \"Digitale valuta (cryptomunten)\" }\n  ]"
                                    },
                                    "template": "<span>{{ item.name }} ({{ item.code }})</span>",
                                    "validate": {
                                        "required": true
                                    },
                                    "validateWhenHidden": false,
                                    "key": "soortVermogenscomponent",
                                    "placeholder": "Kies een soort vermogen",
                                    "type": "select",
                                    "input": true
                                }
                            ],
                            "size": "md",
                            "width": 12,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "currentWidth": 12
                        },
                        {
                            "components": [
                                {
                                    "label": "Omschrijving",
                                    "applyMaskOn": "change",
                                    "tableView": true,
                                    "validateWhenHidden": false,
                                    "key": "omschrijving",
                                    "customConditional": "show = !!row.soortVermogenscomponent && row.soortVermogenscomponent?.code !== '6';",
                                    "type": "textfield",
                                    "input": true
                                },
                                {
                                    "label": "Kenteken",
                                    "applyMaskOn": "change",
                                    "tableView": true,
                                    "validate": {
                                        "required": true
                                    },
                                    "validateWhenHidden": false,
                                    "key": "kenteken",
                                    "customConditional": "show = (row.soortVermogenscomponent?.code === '6');",
                                    "type": "textfield",
                                    "input": true
                                }
                            ],
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "currentWidth": 4,
                            "width": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "Waarde",
                                    "applyMaskOn": "change",
                                    "mask": false,
                                    "tableView": false,
                                    "currency": "EUR",
                                    "inputFormat": "plain",
                                    "truncateMultipleSpaces": false,
                                    "validate": {
                                        "required": true
                                    },
                                    "validateWhenHidden": false,
                                    "key": "waarde",
                                    "customConditional": "show = !!row.soortVermogenscomponent;",
                                    "type": "currency",
                                    "input": true,
                                    "delimiter": true
                                }
                            ],
                            "width": 4,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "currentWidth": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "Peildatum",
                                    "format": "dd-MM-yyyy",
                                    "tableView": false,
                                    "datePicker": {
                                        "disableWeekends": false,
                                        "disableWeekdays": false
                                    },
                                    "enableTime": false,
                                    "defaultDate": "moment()",
                                    "validate": {
                                        "required": true
                                    },
                                    "enableMinDateInput": false,
                                    "enableMaxDateInput": false,
                                    "validateWhenHidden": false,
                                    "key": "datumVaststelling",
                                    "customConditional": "show = !!row.soortVermogenscomponent;",
                                    "type": "datetime",
                                    "input": true,
                                    "widget": {
                                        "type": "calendar",
                                        "displayInTimezone": "viewer",
                                        "locale": "en",
                                        "useLocaleSettings": false,
                                        "allowInput": true,
                                        "mode": "single",
                                        "enableTime": false,
                                        "noCalendar": false,
                                        "format": "dd-MM-yyyy",
                                        "hourIncrement": 1,
                                        "minuteIncrement": 1,
                                        "time_24hr": false,
                                        "minDate": null,
                                        "disableWeekends": false,
                                        "disableWeekdays": false,
                                        "maxDate": null
                                    }
                                }
                            ],
                            "size": "md",
                            "width": 4,
                            "currentWidth": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "Soort",
                                    "widget": "choicesjs",
                                    "tableView": true,
                                    "dataSrc": "custom",
                                    "data": {
                                        "custom": "values = [\n            { \"code\": \"A\", \"name\": \"Aanhangwagen\" },\n            { \"code\": \"B\", \"name\": \"Bedrijfsauto\" },\n            { \"code\": \"C\", \"name\": \"Bromfiets\" },\n            { \"code\": \"D\", \"name\": \"Driewielig motorrijtuig\" },\n            { \"code\": \"M\", \"name\": \"Motorfiets\" },\n            { \"code\": \"P\", \"name\": \"Personenauto\" }\n  ]"
                                    },
                                    "template": "<span>{{ item.name }} ({{ item.code }})</span>",
                                    "validate": {
                                        "required": true
                                    },
                                    "validateWhenHidden": false,
                                    "key": "soortMotorvoertuig",
                                    "customConditional": "show = (row.soortVermogenscomponent?.code === '6');",
                                    "placeholder": "Kies een motorvoertuig",
                                    "type": "select",
                                    "input": true
                                },
                                {
                                    "label": "Toelichting",
                                    "applyMaskOn": "change",
                                    "autoExpand": false,
                                    "tableView": true,
                                    "validate": {
                                        "required": true
                                    },
                                    "validateWhenHidden": false,
                                    "key": "toelichting",
                                    "customConditional": "show = (row.soortVermogenscomponent?.code === '4');",
                                    "type": "textarea",
                                    "input": true
                                }
                            ],
                            "size": "md",
                            "width": 12,
                            "currentWidth": 12
                        }
                    ],
                    "key": "columns",
                    "type": "columns",
                    "hideLabel": true,
                    "input": false,
                    "tableView": false
                }
            ]
        },
        {
            "label": "Toelichting",
            "applyMaskOn": "change",
            "validate": {
                "required": true
            },
            "autoExpand": false,
            "tableView": true,
            "validateWhenHidden": false,
            "key": "pv.bezittingenToelichting",
            "type": "textarea",
            "input": true
        },
        {
            "label": "ButtonColumns",
            "columns": [
                {
                    "components": [
                        {
                            "type": "button",
                            "label": "Vorige",
                            "key": "back",
                            "theme": "warning",
                            "input": true,
                            "custom": "form.submit();\n",
                            "action": "custom",
                            "tableView": false
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                },
                {
                    "components": [
                        {
                            "label": "Volgende",
                            "action": "custom",
                            "showValidations": false,
                            "disableOnInvalid": true,
                            "tableView": false,
                            "key": "submit",
                            "type": "button",
                            "custom": "if (data.pv?.bezittingenVaststellen === 'NEE') { data.pv.bezittingen = []; form.submit(); }\nelse { form.submit(); }",
                            "input": true
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                }
            ],
            "key": "buttonColumns",
            "type": "columns",
            "input": false,
            "tableView": false
        }
    ]
}