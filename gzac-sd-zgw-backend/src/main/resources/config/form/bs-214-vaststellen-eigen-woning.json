{
    "display": "form",
    "components": [
        {
            "label": "vastgesteldeEigenWoning",
            "key": "pv.vastgesteldeEigenWoning",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "aanvraagEigenWoning",
            "key": "pv.aanvraagEigenWoning",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "Vaststellen eigen woning",
            "content": "<h2 class=\"mb-3\">Vaststellen eigen woning</h2>",
            "refreshOnChange": false,
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "Er is geen opgegeven eigen woning gevonden. Wil je deze alsnog toevoegen?",
            "optionsLabelPosition": "right",
            "inline": false,
            "tableView": false,
            "defaultValue": "NEE",
            "values": [
                {
                    "label": "Ja",
                    "value": "JA",
                    "shortcut": ""
                },
                {
                    "label": "Nee",
                    "value": "NEE",
                    "shortcut": ""
                }
            ],
            "validate": {
                "required": true
            },
            "validateWhenHidden": false,
            "key": "pv.eigenWoningVaststellen",
            "customConditional": "show = data.pv.aanvraagEigenWoning.length === 0;",
            "type": "radio",
            "input": true
        },
        {
            "label": "Eigen woning",
            "reorder": false,
            "addAnotherPosition": "bottom",
            "layoutFixed": false,
            "enableRowGroups": false,
            "initEmpty": false,
            "hideLabel": true,
            "tableView": false,
            "validateWhenHidden": false,
            "key": "pv.eigenWoning",
            "addAnother": "Woning toevoegen",
            "customConditional": "show =\n    data.pv.eigenWoningVaststellen === 'JA' ||\n    (\n        !data.pv.eigenWoningVaststellen &&\n        (\n            data.pv.vastgesteldeEigenWoning.length > 0 ||\n            data.pv.aanvraagEigenWoning.length > 0\n        )\n    );\n",
            "type": "datagrid",
            "input": true,
            "components": [
                {
                    "label": "Columns",
                    "columns": [
                        {
                            "components": [
                                {
                                    "label": "Soort woning gerelateerd vermogen",
                                    "widget": "choicesjs",
                                    "tableView": true,
                                    "dataSrc": "custom",
                                    "data": {
                                        "custom": "values = [\n                { \"code\": \"1\", \"name\": \"Eigen woning (huis/woonschip/woonwagen in eigendom)\" },\n                { \"code\": \"15\", \"name\": \"Levensverzekering/belegging gekoppeld aan hypotheek\" },\n                { \"code\": \"17\", \"name\": \"Hypotheek eigen woning\" },\n  ]"
                                    },
                                    "template": "<span>{{ item.name }} ({{ item.code }})</span>",
                                    "validate": {
                                        "required": true
                                    },
                                    "validateWhenHidden": false,
                                    "key": "soortVermogenscomponent",
                                    "placeholder": "Kies een soort vermogen",
                                    "type": "select",
                                    "input": true
                                }
                            ],
                            "size": "md",
                            "width": 12,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "currentWidth": 12
                        },
                        {
                            "components": [
                                {
                                    "label": "Omschrijving",
                                    "applyMaskOn": "change",
                                    "tableView": true,
                                    "validateWhenHidden": false,
                                    "key": "omschrijving",
                                    "customConditional": "show = !!row.soortVermogenscomponent;",
                                    "type": "textfield",
                                    "input": true
                                }
                            ],
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "currentWidth": 4,
                            "width": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "Waarde",
                                    "applyMaskOn": "change",
                                    "mask": false,
                                    "tableView": false,
                                    "currency": "EUR",
                                    "inputFormat": "plain",
                                    "truncateMultipleSpaces": false,
                                    "validate": {
                                        "required": true
                                    },
                                    "validateWhenHidden": false,
                                    "key": "waarde",
                                    "customConditional": "show = !!row.soortVermogenscomponent;",
                                    "type": "currency",
                                    "input": true,
                                    "delimiter": true
                                }
                            ],
                            "width": 4,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "currentWidth": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "Peildatum",
                                    "format": "dd-MM-yyyy",
                                    "tableView": false,
                                    "datePicker": {
                                        "disableWeekends": false,
                                        "disableWeekdays": false
                                    },
                                    "enableTime": false,
                                    "defaultDate": "moment()",
                                    "validate": {
                                        "required": true
                                    },
                                    "enableMinDateInput": false,
                                    "enableMaxDateInput": false,
                                    "validateWhenHidden": false,
                                    "key": "datumVaststelling",
                                    "customConditional": "show = !!row.soortVermogenscomponent;",
                                    "type": "datetime",
                                    "input": true,
                                    "widget": {
                                        "type": "calendar",
                                        "displayInTimezone": "viewer",
                                        "locale": "en",
                                        "useLocaleSettings": false,
                                        "allowInput": true,
                                        "mode": "single",
                                        "enableTime": false,
                                        "noCalendar": false,
                                        "format": "dd-MM-yyyy",
                                        "hourIncrement": 1,
                                        "minuteIncrement": 1,
                                        "time_24hr": false,
                                        "minDate": null,
                                        "disableWeekends": false,
                                        "disableWeekdays": false,
                                        "maxDate": null
                                    }
                                }
                            ],
                            "size": "md",
                            "width": 4,
                            "currentWidth": 4
                        }
                    ],
                    "key": "columns",
                    "type": "columns",
                    "hideLabel": true,
                    "input": false,
                    "tableView": false
                }
            ]
        },
        {
            "label": "Toelichting",
            "applyMaskOn": "change",
            "autoExpand": false,
            "tableView": true,
            "validate": {
                "required": true
            },
            "validateWhenHidden": false,
            "key": "pv.eigenWoningToelichting",
            "type": "textarea",
            "input": true
        },
        {
            "label": "ButtonColumns",
            "columns": [
                {
                    "components": [
                        {
                            "type": "button",
                            "label": "Vorige",
                            "key": "back",
                            "custom": "form.submit();",
                            "action": "custom",
                            "theme": "warning",
                            "input": true,
                            "tableView": false
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                },
                {
                    "components": [
                        {
                            "label": "Volgende",
                            "action": "custom",
                            "showValidations": false,
                            "disableOnInvalid": true,
                            "tableView": false,
                            "key": "submit",
                            "type": "button",
                            "custom": "if (data.pv?.eigenWoningVaststellen === 'NEE') { data.pv.eigenWoning = []; form.submit(); }\nelse { form.submit(); }",
                            "input": true
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                }
            ],
            "key": "buttonColumns",
            "type": "columns",
            "input": false,
            "tableView": false
        }
    ]
}