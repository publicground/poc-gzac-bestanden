                        {
                            "key": "submit",
                            "type": "button",
                            "input": true,
                            "label": "Indienen",
                            "action": "custom",
                            "custom": "delete data.container; delete data.container1; delete data.container2; delete data.container3; delete data.container4;const notes = {\n  'Bankrekeningen': data.pv.bankrekeningenToelichting,\n  'Bezittingen met vrijlatingen': data.pv.bezittingenToelichting,\n  'Overige bezittingen': data.pv.bezittingenToelichting,\n  'Schulden': data.pv.schuldenToelichting,\n  'Eigen woning': data.pv.eigenWoningToelichting,\n};\n\nconst nonBlank = v => typeof v === 'string';\n\nconst list = Array.isArray(data.pv.inAanmerkingTeNemenVermogen)\n  ? data.pv.inAanmerkingTeNemenVermogen\n  : (data.pv.inAanmerkingTeNemenVermogen = []);\n\nlet noteKey = Object.keys(notes);\nnoteKey.forEach(comment => {\n  const note = notes[comment];\n  if (!nonBlank(note)) return;\n  const matches = list.filter(it => it && it.commentaar === comment);\n  if (matches.length) {\n    matches.forEach(it => { it.toelichting = note.trim(); });\n  } else {\n    list.push({ commentaar: comment, componenten: [], toelichting: note.trim() });\n  }\n}); \nif (!data.pv.aanpassenVermogen){data.pv.inAanmerkingTeNemenVermogenToelichting = '';}\n\nconst ordered = [\n  ...noteKey.flatMap(k => list.filter(it => it?.commentaar === k)),\n  ...list.filter(it => !noteKey.includes(it.commentaar))\n];\ndata.pv.inAanmerkingTeNemenVermogen = ordered;\nform.submit(); \ncomponent.disabled = true;",
