        {
            "key": "bankBucket",
            "type": "hidden",
            "input": false,
            "label": "bankrekeningenComponent",
            "tableView": false,
            "calculateValue": "const vc = data.pv?.inAanmerkingTeNemenVermogen || [];\nconst bucket = vc.find(x => (x?.commentaar || '').toLowerCase().includes('bankrekeningen')) || {};\nvalue = bucket || null;\n"
        },
        {
            "key": "bezittingenBucket",
            "type": "hidden",
            "input": false,
            "label": "bezittingenComponent",
            "tableView": false,
            "calculateValue": "const vc = data.pv?.inAanmerkingTeNemenVermogen || [];\nconst bucket = vc.find(x => (x?.commentaar || '').toLowerCase().includes('bezittingen met vrijlatingen')) || {};\nvalue = bucket || null;\n"
        },
        {
            "key": "overigeBezittingenBucket",
            "type": "hidden",
            "input": false,
            "label": "overigeBezittingenComponent",
            "tableView": false,
            "calculateValue": "const vc = data.pv?.inAanmerkingTeNemenVermogen || [];\nconst bucket = vc.find(x => (x?.commentaar || '').toLowerCase().includes('overige bezittingen')) || {};\nvalue = bucket || null;"
        },
        {
            "key": "bezittingenTotaal",
            "type": "hidden",
            "input": false,
            "label": "bezittingenTotaal",
            "tableView": false,
            "calculateValue": "const vc = data.pv?.inAanmerkingTeNemenVermogen || [];\n\nconst bez = vc.filter(x => (x?.commentaar || '').toLowerCase().includes('bezittingen'));\n\nvalue = {\n  brutoSubtotaal: bez.reduce((s, x) => s + (x.brutoSubtotaal || 0), 0),\n  vrijlating:     bez.reduce((s, x) => s + (x.vrijlating     || 0), 0),\n  nettoSubtotaal: bez.reduce((s, x) => s + (x.nettoSubtotaal || 0), 0),\n  rekenwaarde:    bez.reduce((s, x) => s + (x.rekenwaarde    || 0), 0)\n};\n"
        },
        {
            "key": "schuldenBucket",
            "type": "hidden",
            "input": false,
            "label": "schuldenComponent",
            "tableView": false,
            "calculateValue": "const vc = data.pv?.inAanmerkingTeNemenVermogen || [];\nconst bucket = vc.find(x => (x?.commentaar || '').toLowerCase().includes('schulden')) || {};\nvalue = bucket || null;\n"
        },
        {
            "key": "eigenWoningBucket",
            "type": "hidden",
            "input": false,
            "label": "eigenWoningComponent",
            "tableView": false,
            "calculateValue": "const vc = data.pv?.inAanmerkingTeNemenVermogen || [];\nconst bucket = vc.find(x => (x?.commentaar || '').toLowerCase().includes('eigen woning')) || {};\nvalue = bucket || null;\n"
        },
        {
            "key": "pv.berekendVermogen",
            "type": "hidden",
            "input": true,
            "label": "berekendVermogen",
            "tableView": false,
            "calculateValue": "value = Math.max(0,\n  (data.bankBucket?.nettoSubtotaal || 0) +\n  (data.bezittingenTotaal?.nettoSubtotaal || 0) -\n  (data.schuldenBucket?.nettoSubtotaal || 0));"
        },
        {
            "key": "pv.voorheenVastgesteldVermogen",
            "type": "hidden",
            "input": true,
            "label": "voorheenVastgesteldVermogen",
            "tableView": false
        },
        {
            "key": "pv.vermogenAangepast",
            "type": "hidden",
            "input": true,
            "label": "vermogenAangepast",
            "tableView": false
        },
        {
            "key": "eigenWoningCalc",
            "type": "hidden",
            "input": false,
            "label": "eigenWoningCalc",
            "tableView": false,
            "calculateValue": "const c = (data.pv && data.eigenWoningBucket && Array.isArray(data.eigenWoningBucket.componenten)) ? data.eigenWoningBucket.componenten : [];\n\nconst n = (v) => (typeof v === 'number' ? v : 0);\nconst sum = (rows, pred) => rows.filter(pred).reduce((s, r) => s + n(r?.waarde), 0);\n\n// WOZ (code 1)\nconst woz = sum(c, r => r?.soortVermogenscomponent?.code === '1');\n\n// Hypotheek (code 17) may be negative; show as positive subtraction\nconst hypRaw = sum(c, r => r?.soortVermogenscomponent?.code === '17');\nconst hypotheek = Math.abs(hypRaw);\n\n// Levensverzekering / belegging (adjust codes if needed)\nconst levensBelegging = sum(c, r => ['15'].includes(r?.soortVermogenscomponent?.code));\n\n// Vrijlating/buiten beschouwing\nconst buitenBeschouwing = n(data.eigenWoningBucket?.vrijlating);\n\n// Beschikbaar = WOZ - hypotheek + levens/belegging - buiten beschouwing\nconst beschikbaar = woz - hypotheek + levensBelegging - buitenBeschouwing;\n\n// Toelichting (first non-empty)\nconst toelichting = (c.find(r => typeof r?.toelichting === 'string' && r.toelichting.trim().length) || {}).toelichting || '';\n\nvalue = {\n  woz,\n  hypotheek,\n  levensBelegging,\n  buitenBeschouwing,\n  beschikbaar,\n  toelichting\n};"
        },
