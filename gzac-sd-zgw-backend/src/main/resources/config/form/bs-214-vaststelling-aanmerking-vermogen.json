                    "content": "<div>\n  <table class=\"table\" style=\"margin-bottom:0 table-layout: fixed; width:100%;\" >\n    <tbody>\n      <tr style=\"border-bottom:1px;\" class=\"font-weight-bold\">\n        <th class=\"col-2\" style=\"text-align:right\"></th>\n        <th class=\"col-2 text-nowrap\" style=\"text-align:right\">WOZ waarde</th>\n        <th class=\"col-2 text-nowrap\" style=\"text-align:right\">- Hypotheek</th>\n        <th class=\"col-2 text-nowrap\" style=\"text-align:right\">+ Levensverzekering<br>/ belegging</th>\n        <th class=\"col-2 text-nowrap\" style=\"text-align:right\">- Buiten beschouwing<br>te laten waarde</th>\n        <th class=\"col-2 text-nowrap\" style=\"text-align:right\">= Beschikbare waarde<br>eigen woning</th>\n      </tr>\n      <tr style=\"border-bottom:1px;\">\n        <td><strong>Waarde</strong></td>\n        <td style=\"text-align:right\">{{ (typeof data.eigenWoningCalc?.woz === 'number') ? data.eigenWoningCalc.woz.toLocaleString('nl-NL',{style:'currency',currency:'EUR'}) : '€ 0,00' }}</td>\n        <td style=\"text-align:right\">{{ (typeof data.eigenWoningCalc?.hypotheek === 'number') ? data.eigenWoningCalc.hypotheek.toLocaleString('nl-NL',{style:'currency',currency:'EUR'}) : '€ 0,00' }}</td>\n        <td style=\"text-align:right\">{{ (typeof data.eigenWoningCalc?.levensBelegging === 'number') ? data.eigenWoningCalc.levensBelegging.toLocaleString('nl-NL',{style:'currency',currency:'EUR'}) : '€ 0,00' }}</td>\n        <td style=\"text-align:right\">{{ (typeof data.eigenWoningCalc?.buitenBeschouwing === 'number') ? data.eigenWoningCalc.buitenBeschouwing.toLocaleString('nl-NL',{style:'currency',currency:'EUR'}) : '€ 0,00' }}</td>\n        <td style=\"text-align:right\"><strong>{{ (typeof data.eigenWoningCalc?.beschikbaar === 'number' && data.eigenWoningCalc?.beschikbaar > 0) ? data.eigenWoningCalc.beschikbaar.toLocaleString('nl-NL',{style:'currency',currency:'EUR'}) : '€ 0,00' }}</strong></td>\n      </tr>\n      <tr