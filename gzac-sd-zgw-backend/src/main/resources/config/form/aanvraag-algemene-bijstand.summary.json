                                {
                                    "label": "html",
                                    "tag": "div",
                                    "content": "<h4>Poortonderzoek handhaving</h4>\n<section>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Poortonderzoek uitvoeren?</dd>\n        <dt class=\"col-6\">{{{ { 'JA': 'Ja', 'NEE': 'Nee' }[data.poortonderzoek?.uitvoeren] || '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Datum poortonderzoek aangevraagd</dd>\n        <dt class=\"col-6\">{{{ data.poortonderzoek?.datumAangevraagd ? moment(data.poortonderzoek.datumAangevraagd).format('DD-MM-yyyy') : '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Toelichting uitvoeren poortonderzoek</dd>\n        <dt class=\"col-6\">{{{ data.poortonderzoek?.toelichting || '-' }}}</dt>\n    </dl>\n    <br>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Datum ontvangst uitkomst poortonderzoek</dd>\n        <dt class=\"col-6\">{{{ data.poortonderzoek?.datumUitkomst  ? moment(data.poortonderzoek.datumUitkomst).format('DD-MM-yyyy') : '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Uitkomst poortonderzoek</dd>\n        <dt class=\"col-6\">{{{ data.poortonderzoek?.uitkomst || '-' }}}</dt>\n    </dl>\n</section>",
