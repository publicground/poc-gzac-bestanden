                            "key": "openzaak",
                            "type": "container",
                            "title": "client",
                            "input": true,
                            "components": [
                                {
                                    "label": "zaakInformatieHTML",
                                    "content": "<h4>Zaak informatie</h4>\n<section>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Zaaknummer</dd>\n        <dt class=\"col-6\">{{{ data.openzaak?.identificatie || '-'}}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Zaakstatus</dd>\n        <dt class=\"col-6\">{{{ data.openzaak?.statusOmschrijving || '-'}}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Aanvraagdatum</dd>\n        <dt class=\"col-6\">{{{ data.createdOn ? moment(data.createdOn).format('DD-MM-yyyy') : '-'}}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Uiterste afhandelingsdatum</dd>\n        <dt class=\"col-6\">{{{ data.uiterlijkeEinddatumAfdoening ? moment(data.uiterlijkeEinddatumAfdoening).format('DD-MM-yyyy') : '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Recht op eerste voorschot*</dd>\n        <dt class=\"col-6\">{{{'-'}}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Reden aanvraag</dd>\n        <dt class=\"col-6\">{{{data.gegevensVaststelling?.redenAanvraag?.reden?.name || '-'}}}</dt>\n    </dl>\n    <dl class=\"row mb-0 pt-1\">\n        <dd class=\"col-6\"></dd>\n        <dt class=\"col-6\">\n            {{ (() => {\n            const reason = data.gegevensVaststelling?.redenAanvraag?.reden?.name;\n            const reasonsData = data.gegevensVaststelling?.redenAanvraag;\n\n            if (reason === 'Geen of te weinig inkomen') {\n            return reasonsData?.onvoldoendeInkomen?.name || '-';\n            } else if (reason === 'Wijziging gezin') {\n            return reasonsData?.wijzigingGezin?.name || '-';\n            } else if (reason === '(ex)Zelfstandige') {\n            return reasonsData?.zelfstandige?.name || '-';\n            } else if (reason === 'Verblijfsstatus') {\n            return reasonsData?.verblijfstatus?.name || '-';\n            } else if (reason === 'Ik kom vrij na gevangenisstraf') {\n            const detentieDuur = reasonsData?.gestopteDetentie[0]?.detentieDuur?.name;\n            return detentieDuur === 'Ja' ? 'Langer dan 31 dagen' : detentieDuur === 'Nee' ? '30 dagen of minder' : '-';\n            } else if (reason === 'Anders') {\n            return reasonsData?.andereRedenVerzoek[0]?.geldtekortSpecificatie || '-';\n            } else {\n            return '-';\n            }\n            })() }}\n        </dt>\n    </dl>\n</section>",
                                    "refreshOnChange": false,
                                    "customClass": "no-border-around-formio-container",
                                    "key": "html",
                                    "type": "htmlelement",
                                    "tableView": false,
                                    "input": true
                                }
                            ]
                        },
                        {
                            "label": "aanvragerContainer",
