                            "components": [
                                {
                                    "label": "zaakInformatieHTML",
                                    "content": "<h4>Contactpersoon</h4>\n<section>\n    <dl class=\"row mb-0\"> \n    <dd class=\"col-6\">Naam contactpersoon</dd> \n    <dt class=\"col-6\">{{{ (data?.gegevensVaststelling?.contactpersoon?.naamContactpersoon || '-') }}} </dt> \n  </dl>\n  <dl class=\"row mb-0\"> \n    <dd class=\"col-6\">Telefoon contactpersoon</dd> \n    <dt class=\"col-6\">{{{ (data?.gegevensVaststelling?.contactpersoon?.telefoon || '-') }}} </dt> \n  </dl>\n    <dl class=\"row mb-0\"> \n    <dd class=\"col-6\">Relatie</dd> \n   <dt class=\"col-6\">\n        <div class=\"status-item\">{{{ (data?.gegevensVaststelling?.contactpersoon?.relatieTotAanvrager === 'FAMILIE' ? 'Familie' : '') }}}</div>\n        <div class=\"status-item\">{{{ (data?.gegevensVaststelling?.contactpersoon?.relatieTotAanvrager === 'BUURMAN_VROUW' ? 'Buurman / -vrouw' : '') }}}</div>\n        <div class=\"status-item\">{{{ (data?.gegevensVaststelling?.contactpersoon?.relatieTotAanvrager === 'KENNIS' ? 'Kennis' : '') }}}</div>\n        <div class=\"status-item\">{{{ (data?.gegevensVaststelling?.contactpersoon?.relatieTotAanvrager === 'HULPVERLENER' ? 'Hulpverlener' : '') }}}</div>\n        <div class=\"status-item\">{{{ (data?.gegevensVaststelling?.contactpersoon?.relatieTotAanvrager === 'BEWINDVOERDER' ? 'Bewindvoerder' : '') }}}</div>\n        <div class=\"status-item\">{{{ (data?.gegevensVaststelling?.contactpersoon?.relatieTotAanvrager === 'BOEKHOUDER' ? 'Boekhouder' : '') }}}</div>\n        <div class=\"status-item\">{{{ (data?.gegevensVaststelling?.contactpersoon?.relatieTotAanvrager === 'MEDEWERKER_VAN_DE_GEMEENTE' ? 'Medewerker van de gemeente' : '') }}}</div>\n    </dt> \n    </dl>\n</section>",
