                            "components": [
                                {
                                    "label": "zaakInformatieHTML",
                                    "content": "<h4>Conclusie na beoordeling</h4>\n<section>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Beslisser*</dd>\n        <dt class=\"col-6\">{{{ '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Besluit</dd>\n        <dt class=\"col-6\">{{{ data.besluit?.genomenBesluit ?  {'TOEGEKEND': 'Toekennen', 'AFGEWEZEN': 'Afwijzen', 'BUITEN_BEHANDELING_GESTELD': 'Buiten behandeling stellen', 'INGETROKKEN': 'Intrekken'}[data.besluit.genomenBesluit] : '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Afwijzing*</dd>\n        <dt class=\"col-6\">{{{ '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Ingangsdatum uitkering*</dd>\n        <dt class=\"col-6\">{{{ '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Norm*</dd>\n        <dt class=\"col-6\">{{{'-'}}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Lening*</dd>\n        <dt class=\"col-6\">{{{'-'}}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Maatregel*</dd>\n        <dt class=\"col-6\">{{{'-'}}}</dt>\n    </dl>\n</section>",
                                    "refreshOnChange": false,
