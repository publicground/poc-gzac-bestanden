                                                            "label": "Totaal netto inkomsten",
                                                            "calculateValue": "let totaal = 0;\nif(!isNaN(Number(row?.nettoInkomsten))) {\n totaal += row?.nettoInkomsten; \n}\n\n\nvalue = totaal;",
                                                            "key": "totaalNettoInkomsten",
                                                            "type": "hidden",
                                                            "applyMaskOn": "change",
                                                            "tableView": false,
                                                            "validateWhenHidden": false,
                                                            "input": true
                                                        },
                                                        {
                                                            "label": "Totaal netto maandelijkse inkomsten",
                                                            "calculateValue": "let totaal = 0;\nlet totaalNettoInkomsten = Number(row?.totaalNettoInkomsten);\nif (totaalNettoInkomsten >= 0 && row?.periodiciteitUitbetaling) {\n if (row.periodiciteitUitbetaling.code === '1') {\n    totaal = totaalNettoInkomsten * 260 / 12;\n  } else if (row.periodiciteitUitbetaling.code === '2') {\n    totaal = (totaalNettoInkomsten * 52 / 12);\n  } else if (row.periodiciteitUitbetaling.code === '4') {\n    totaal = totaalNettoInkomsten * 13 / 12;\n  } else if (row.periodiciteitUitbetaling.code === '6') {\n    totaal = totaalNettoInkomsten;\n  } else if (row.periodiciteitUitbetaling.code === '7') {\n    totaal = (totaalNettoInkomsten / 3);\n  } else if (row.periodiciteitUitbetaling.code === '8') {\n    totaal = (totaalNettoInkomsten / 12);\n  } \n} \n  \nvalue = totaal;\n",
                                                            "key": "totaalNettomaandelijkseInkomsten",
                                                            "type": "hidden",
                                                            "applyMaskOn": "change",
                                                            "tableView": false,
                                                            "validateWhenHidden": false,
                                                            "input": true
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "label": "Totaal netto maandelijkse inkomsten van een stap",
                                    "calculateValue": "let totaalStap = 0;\n\nif(data.pv.onderneming?.inkomstenComponenten?.length > 0) {\n  totaalStap = data.pv.onderneming.inkomstenComponenten.map(onderneming => Number(onderneming?.totaalNettomaandelijkseInkomsten) || 0).reduce((sum, n) => sum + n, 0);\n}\n\n\nvalue = Number(totaalStap);",
                                    "key": "pv.onderneming.totaalNettomaandelijkseInkomstenVanEenStap",
                                    "type": "hidden",
                                    "applyMaskOn": "change",
                                    "tableView": false,
                                    "validateWhenHidden": false,
                                    "input": true
                                }
