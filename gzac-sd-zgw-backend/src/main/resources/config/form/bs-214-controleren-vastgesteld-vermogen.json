                    "components": [
                        {
                            "type": "button",
                            "label": "Vorige",
                            "showValidations": false,
                            "disableOnInvalid": true,
                            "tableView": false,
                            "action": "custom",
                            "custom": "data.pv.goBack = 'true'; form.submit();",
                            "theme": "warning",
