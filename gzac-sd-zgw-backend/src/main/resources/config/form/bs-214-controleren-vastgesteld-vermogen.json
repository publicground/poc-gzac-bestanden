                            "input": true
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                },
                {
                    "components": [
                        {
                            "label": "Indienen",
                            "action": "custom",
                            "showValidations": false,
                            "disableOnInvalid": true,
                            "logic": [
                                {
                                    "name": "CheckAllVermogenLength",
                                    "trigger": {
                                        "type": "javascript",
                                        "javascript": "const totalLength = (\n  data.pv?.bankrekeningen?.length +\n  data.pv?.bezittingen?.length +\n  data.pv?.schulden?.length +\n  data.pv?.eigenWoning?.length\n);\n\nresult = (totalLength === 0);\n"
                                    },
                                    "actions": [
                                        {
                                            "name": "DisableButton",
                                            "type": "property",
                                            "property": {
                                                "label": "Disabled",
                                                "value": "disabled",
                                                "type": "boolean"
                                            },
                                            "state": true
                                        }
                                    ]
                                }
                            ],
                            "tableView": false,
                            "key": "submit",
                            "type": "button",
                            "custom": "const isNonEmptyObject = v =>\n  v && typeof v === 'object' && !Array.isArray(v) && Object.keys(v).length > 0;\n\nconst clean = arr => Array.isArray(arr) ? arr.filter(isNonEmptyObject) : [];\n\nlet vermogensComponenten = [];\n\n['bankrekeningen', 'bezittingen', 'eigenWoning', 'schulden'].forEach(key => {\n  const cleaned = clean(data.pv?.[key]);\n  if (cleaned.length > 0) {\n    vermogensComponenten.push(...cleaned);\n  }\n}); data.pv.vermogensComponenten = vermogensComponenten; form.submit(); component.disabled = true;",
                            "input": true
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                }
            ],
