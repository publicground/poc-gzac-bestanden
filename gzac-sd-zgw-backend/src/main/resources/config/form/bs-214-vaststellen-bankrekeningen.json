{
    "display": "form",
    "components": [
        {
            "label": "aanvraagBankrekeningen",
            "key": "pv.aanvraagBankrekeningen",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "vastgesteldeBankrekeningen",
            "key": "pv.vastgesteldeBankrekeningen",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "Vaststellen bankrekeningen",
            "content": "<h2 class=\"mb-3\">Vaststellen bankrekeningen</h2>",
            "refreshOnChange": false,
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "Er zijn geen opgegeven bankrekeningen gevonden. Wil je deze alsnog toevoegen?",
            "optionsLabelPosition": "right",
            "inline": false,
            "tableView": false,
            "defaultValue": "NEE",
            "values": [
                {
                    "label": "Ja",
                    "value": "JA",
                    "shortcut": ""
                },
                {
                    "label": "Nee",
                    "value": "NEE",
                    "shortcut": ""
                }
            ],
            "validate": {
                "required": true
            },
            "validateWhenHidden": false,
            "key": "pv.bankrekeningenVaststellen",
            "customConditional": "show = data.pv.aanvraagBankrekeningen.length === 0;",
            "type": "radio",
            "input": true
        },
        {
            "label": "Bankrekeningen",
            "reorder": false,
            "addAnotherPosition": "bottom",
            "layoutFixed": false,
            "enableRowGroups": false,
            "initEmpty": false,
            "hideLabel": true,
            "tableView": false,
            "addAnother": "Bankrekening toevoegen",
            "customConditional": "show =\n  data.pv.bankrekeningenVaststellen === 'JA' ||\n  (\n    !data.pv.bankrekeningenVaststellen &&\n    (\n      data.pv.vastgesteldeBankrekeningen.length > 0 ||\n      data.pv.aanvraagBankrekeningen.length > 0\n    )\n  );\n",
            "validateWhenHidden": false,
            "key": "pv.bankrekeningen",
            "type": "datagrid",
            "input": true,
            "components": [
                {
                    "label": "Columns",
                    "hideLabel": true,
                    "columns": [
                        {
                            "components": [
                                {
                                    "label": "Soort vermogenscomponent",
                                    "widget": "choicesjs",
                                    "disabled": true,
                                    "tableView": true,
                                    "dataSrc": "custom",
                                    "data": {
                                        "custom": "values = [{\"code\": \"3\", \"name\": \"Bank-/Girorekening\"}]"
                                    },
                                    "template": "<span>{{ item.name }} ({{item.code}})</span>",
                                    "validateWhenHidden": false,
                                    "key": "soortVermogenscomponent",
                                    "type": "select",
                                    "input": true,
                                    "defaultValue": {
                                        "code": "3",
                                        "name": "Bank-/Girorekening"
                                    }
                                },
                                {
                                    "label": "IBAN",
                                    "applyMaskOn": "change",
                                    "tableView": true,
                                    "validateWhenHidden": false,
                                    "key": "iban",
                                    "type": "iban",

                                    "input": true
                                },
                                {
                                    "label": "Bankrekeningnummer",
                                    "applyMaskOn": "change",
                                    "tableView": true,
                                    "validateWhenHidden": false,
                                    "key": "bankrekeningnummer",
                                    "type": "textfield",
                                    "input": true
                                },
                                {
                                    "label": "Tenaamstelling",
                                    "applyMaskOn": "change",
                                    "tableView": true,
                                    "validateWhenHidden": false,
                                    "key": "tenaamstelling",
                                    "validate": {
                                        "required": false
                                    },
                                    "type": "textfield",
                                    "input": true
                                },
                                {
                                    "label": "Waarde",
                                    "mask": false,
                                    "spellcheck": true,
                                    "tableView": false,
                                    "currency": "EUR",
                                    "inputFormat": "plain",
                                    "truncateMultipleSpaces": false,
                                    "key": "waarde",
                                    "type": "currency",
                                    "validate": {
                                        "required": true
                                    },
                                    "input": true,
                                    "delimiter": true
                                },
                                {
                                    "label": "Peildatum",
                                    "format": "dd-MM-yyyy",
                                    "tableView": false,
                                    "datePicker": {
                                        "disableWeekends": false,
                                        "disableWeekdays": false
                                    },
                                    "enableTime": false,
                                    "defaultDate": "moment()",
                                    "validate": {
                                        "required": true
                                    },
                                    "enableMinDateInput": false,
                                    "enableMaxDateInput": false,
                                    "validateWhenHidden": false,
                                    "key": "datumVaststelling",
                                    "type": "datetime",
                                    "input": true,
                                    "widget": {
                                        "type": "calendar",
                                        "displayInTimezone": "viewer",
                                        "locale": "en",
                                        "useLocaleSettings": false,
                                        "allowInput": true,
                                        "mode": "single",
                                        "enableTime": false,
                                        "noCalendar": false,
                                        "format": "dd-MM-yyyy",
                                        "hourIncrement": 1,
                                        "minuteIncrement": 1,
                                        "time_24hr": false,
                                        "minDate": null,
                                        "disableWeekends": false,
                                        "disableWeekdays": false,
                                        "maxDate": null
                                    }
                                }
                            ],
                            "width": 12,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "currentWidth": 12
                        }
                    ],
                    "key": "columns",
                    "type": "columns",
                    "input": false,
                    "tableView": false
                }
            ]
        },
        {
            "label": "Toelichting",
            "applyMaskOn": "change",
            "tableView": true,
            "validateWhenHidden": false,
            "validate": {
                "required": true
            },
            "key": "pv.bankrekeningenToelichting",
            "type": "textarea",
            "input": true
        },
        {
            "label": "Volgende",
            "action": "custom",
            "showValidations": false,
            "disableOnInvalid": true,
            "tableView": false,
            "key": "submit",
            "type": "button",
            "custom": "if (data.pv?.bankrekeningenVaststellen === 'NEE') { data.pv.bankrekeningen = []; form.submit(); }\nelse { form.submit(); }",
            "input": true
        }
    ]
}