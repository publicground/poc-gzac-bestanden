            "disableOnInvalid": true,
            "tableView": false,
            "key": "submit",
            "type": "button",
            "custom": "const verzoekItems = []; if (data.pv.verzoek?.informatieverzoekItemsContainer?.opTeVragenInformatie?.length > 0) { verzoekItems.push(...data.pv.verzoek?.informatieverzoekItemsContainer?.opTeVragenInformatie) }; if (data.pv.verzoek?.informatieverzoekItemsContainer2?.opTeVragenInformatie.length > 0) { verzoekItems.push(...data.pv.verzoek?.informatieverzoekItemsContainer2?.opTeVragenInformatie) }; if (data.pv.verzoek?.informatieverzoekItemsContainer3?.opTeVragenInformatie?.length > 0) { verzoekItems.push(...data.pv.verzoek?.informatieverzoekItemsContainer3?.opTeVragenInformatie) }; data.pv.verzoek.opTeVragenInformatie = verzoekItems; form.submit(); component.disabled = true;",
            "customConditional": "show = (data.pv.vervolgactieUitzettenInformatieverzoek == 'nogMeerItemsBepalen'  || data.pv.vervolgactieUitzettenInformatieverzoek == 'informatieverzoekAnnuleren')",
            "input": true
        },
        {
            "label": "Informatieverzoek uitzetten",
            "action": "custom",
            "showValidations": false,
            "disableOnInvalid": true,
            "tableView": false,
            "key": "submit",
            "customConditional": "show = data.pv.vervolgactieUitzettenInformatieverzoek == 'informatieverzoekUitzetten'",
            "logic": [
                {
                    "name": "disable logic",
                    "trigger": {
                        "type": "javascript",
                        "javascript": "const arrayWoonsituatie = data.pv?.verzoekNotSave?.informatieverzoekItemsContainer?.opTeVragenInformatie || [];\nconst arrayInkomen = data.pv?.verzoekNotSave?.informatieverzoekItemsContainer2?.opTeVragenInformatie || [];\nconst arrayVermogen = data.pv?.verzoekNotSave?.informatieverzoekItemsContainer3?.opTeVragenInformatie || [];\n\nconst combinedArray = arrayWoonsituatie.concat(arrayInkomen, arrayVermogen);\n\n// Ignore placeholder items like [{}] or empty objects\nconst filtered = combinedArray.filter(item => item && Object.keys(item).length > 0);\n\nresult = filtered.length === 0;\n"
                    },
                    "actions": [
                        {
                            "name": "disable",
                            "type": "property",
                            "property": {
                                "label": "Disabled",
                                "value": "disabled",
                                "type": "boolean"
                            },
                            "state": true
                        }
                    ]
                }
