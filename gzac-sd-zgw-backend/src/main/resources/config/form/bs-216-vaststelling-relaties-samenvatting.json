                            "type": "button",
                            "custom": "const partnerRelaties = [];\nconst relaties = data.pv.relaties.map(relatie => {\n  delete relatie.soortOpleiding;\n  delete relatie.volgtOpleiding;\n  delete relatie.kinderbijslag;\n  delete relatie.gezamenlijkTijdsbesteding;\n  delete relatie.samenlevingsvorm;\n  delete relatie.relatieMedebewoner;\n  delete relatie.gezamenlijkHuishouden;\n  delete relatie.omschrijvingVolgtOpleiding;\n  delete relatie.volgtBblTraject;\n  delete relatie.soortBblTraject;\n  delete relatie.toelichtingRelatieTotMedebewoner;\n  delete relatie.teOntvangenHuur;\n  delete relatie.frequentieOntvangenHuur;\n  delete relatie.gezamenlijkeTijdsbesteding;\n  delete relatie.medebewonerVolgtOpleiding;\n  delete relatie.leeftijd;\n  delete relatie.relatiesVaststellen;\n  \n  if(!relatie.isKindVan) {\n    delete relatie.isKindVan;\n  }\n  \n  if (relatie.isKindVan === 'AANVRAGER_EN_PARTNER') {\n    partnerRelaties.push(relatie);\n  } else if (relatie.isKindVan === 'PARTNER') {\n    partnerRelaties.push(relatie);\n  }\n  return relatie;\n});\ndata.pv.relaties = relaties;\ndata.pv.partnerRelaties = partnerRelaties;\n\n\nconst order = [\"ouderKind\", \"kindOuder\", \"medebewoner\", \"partner\", \"exPartner\", \"algemeneRelatie\"];\n\nrelaties.sort((a, b) => order.indexOf(a.relatietype) - order.indexOf(b.relatietype));\n\n\nform.submit(); \ncomponent.disabled = true;",
