}\n            {{{ (data?.gegevensVanuitAanvraag?.partner?.nationaliteitOfVerblijfsstatus ? '' : '-') }}}\n        </dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Adres</dd>\n        <dt class=\"col-6\">{{{ (data?.gegevensVanuitAanvraag?.partner?.verblijfadres?.straatnaam || '-') }}} {{{data?.gegevensVanuitAanvraag?.partner?.verblijfadres?.huisnummer }}} </dt>\n        <dd class=\"col-6\">&nbsp;</dd>\n        <dt class=\"col-6\">{{{ (data?.gegevensVanuitAanvraag?.partner?.verblijfadres?.postcode || '-') }}} {{{ data?.gegevensVanuitAanvraag?.partner?.verblijfadres?.woonplaatsnaam }}}</dt>\n    </dl>\n\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Woonsituatie</dd>\n        <dt class=\"col-6\">{{{ ({ \"BRP\": \"Adres volgens brp\", \"PARTNER_INWONEND\": \"Partner woont in\", \"ELDERS\": \"Woont elders\", \"DETENTIE\": \"Zit in detentie\", \"DAKLOOS\": \"Is dakloos\", \"ONBEKEND\": \"Onbekend\" }[data.gegevensVanuitAanvraag?.partner?.woonsituatie] || '-') }}} </dt>\n    </dl>\n</section>",
