                                    "label": "aanvragerHTML",
                                    "content": "<h4>Aanvrager</h4><section>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Naam</dd>\n        <dt class=\"col-6\">{{{ _.compact([\n            data.gegevensVanuitAanvraag?.aanvrager?.voorletters && data.gegevensVanuitAanvraag.aanvrager.voorletters.trim(),\n            data.gegevensVanuitAanvraag?.aanvrager?.voorvoegsel && data.gegevensVanuitAanvraag.aanvrager.voorvoegsel.trim(),\n            data.gegevensVanuitAanvraag?.aanvrager?.achternaam && data.gegevensVanuitAanvraag.aanvrager.achternaam.trim()\n            ]).join(' ') || '-' }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Geboortedatum</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVanuitAanvraag?.aanvrager?.geboortedatum ? moment(data.gegevensVanuitAanvraag?.aanvrager?.geboortedatum).format('DD-MM-yyyy') : '-') }}} </dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">BRP adres</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVanuitAanvraag?.aanvrager?.adresBrp?.straatnaam || '-') }}} {{{data.gegevensVanuitAanvraag?.aanvrager?.adresBrp?.huisnummer }}}{{{data.gegevensVanuitAanvraag?.aanvrager?.adresBrp?.huisletter }}} {{{data.gegevensVanuitAanvraag?.aanvrager?.adresBrp?.huisnummertoevoeging }}} </dt>\n        <dd class=\"col-6\">&nbsp;</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVanuitAanvraag?.aanvrager?.adresBrp?.postcode || '-') }}} {{{ data.gegevensVanuitAanvraag?.aanvrager?.adresBrp?.woonplaatsnaam }}}</dt>\n    </dl>\n\n\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Woonsituatie</dd>\n        <dt class=\"col-6\">{{{ ({ \"BRP\": \"Adres volgens brp\", \"PARTNER_INWONEND\": \"Partner woont in\", \"ELDERS\": \"Woont elders\", \"DETENTIE\": \"Zit in detentie\", \"DAKLOOS\": \"Is dakloos\", \"ONBEKEND\": \"Onbekend\" }[data.gegevensVanuitAanvraag?.aanvrager?.woonsituatie] || '-') }}} </dt>\n    </dl>\n\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">{{{ (data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.toelichtingNietIngeschrevenOpVerblijfadres ? 'Reden ander adres:' : '' ) }}} </dd>\n        <dt class=\"col-6\">{{{ data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.toelichtingNietIngeschrevenOpVerblijfadres }}}</dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">{{{ (data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.straatnaam ? 'Ander adres': '' ) }}}</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.straatnaam ? data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.straatnaam  + ' ' : '' ) }}} {{{ ( data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.huisnummer ? data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.huisnummer + ' ' : '' ) }}} {{{ ( data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.huisletter ? data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.huisletter + ' ' : '' ) }}} {{{ ( data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.huisnummertoevoeging ? data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.huisnummertoevoeging : '' ) }}} </dt>\n        <dd class=\"col-6\">{{{ (data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.postcode ? ' ' : '' ) }}}</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.postcode || '' ) }}} {{{ (data.gegevensVanuitAanvraag?.aanvrager?.verblijfadres?.woonplaatsnaam || '') }}}</dt>\n    </dl>\n\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">&nbsp;</dd>\n        <dt class=\"col-6\">&nbsp;</dt>\n    </dl>\n\n\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">BSN</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVanuitAanvraag?.aanvrager?.bsn || '-') }}} </dt>\n    </dl>\n\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Nationaliteit/verblijfsstatus</dd>\n        <dt class=\"col-6\">\n            {{{ (data?.gegevensVanuitAanvraag?.aanvrager?.nationaliteitOfVerblijfsstatus === 'NEDERLANDSE_NATIONALITEIT' ? 'Nederlandse nationaliteit' :\n            (data?.gegevensVanuitAanvraag?.aanvrager?.nationaliteitOfVerblijfsstatus === 'EU_ONDERDAAN' ? 'EU onderdaan' :\n            (data?.gegevensVanuitAanvraag?.aanvrager?.nationaliteitOfVerblijfsstatus === 'GELDIGE_VERBLIJFSVERGUNNING' ? 'Geldige verblijfsvergunning' :\n            (data?.gegevensVanuitAanvraag?.aanvrager?.nationaliteitOfVerblijfsstatus === 'GEEN_VERBLIJFSVERGUNNING' ? 'Geen verblijfsvergunning' :\n            (data?.gegevensVanuitAanvraag?.aanvrager?.nationaliteitOfVerblijfsstatus === 'VERLOPEN_VERBLIJFSVERGUNNING' ? 'Verlopen verblijfsvergunning' :\n            (data?.gegevensVanuitAanvraag?.aanvrager?.nationaliteitOfVerblijfsstatus ? data?.gegevensVanuitAanvraag?.aanvrager?.nationaliteitOfVerblijfsstatus : '-' )\n            )\n            )\n            )\n            )\n            ) }}} </dt>\n    </dl>\n\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Telefoon</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVanuitAanvraag?.aanvrager?.contactgegevens?.telefoon || '-') }}} </dt>\n        <dd class=\"col-6\">E-mailadres</dd>\n        <dt class=\"col-6\">{{{ (data.gegevensVanuitAanvraag?.aanvrager?.contactgegevens?.email || '-') }}} </dt>\n    </dl>\n\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">{{{ ( data.gegevensVanuitAanvraag?.contactpersoon?.naamContactpersoon ? 'Naam contactpoersoon' : '' ) }}} </dd>\n        <dt class=\"col-6\">{{{ ( data.gegevensVanuitAanvraag?.contactpersoon?.naamContactpersoon || '') }}} </dt>\n        <dd class=\"col-6\">{{{ ( data.gegevensVanuitAanvraag?.contactpersoon?.relatieTotAanvrager ? 'Relatie tot aanvrager' : '' ) }}} </dd>\n        <dt class=\"col-6\"> {{{ (data.gegevensVanuitAanvraag?.contactpersoon?.relatieTotAanvrager === 'FAMILIE' ? 'Familie' :\n            (data.gegevensVanuitAanvraag?.contactpersoon?.relatieTotAanvrager === 'BUURMAN_VROUW' ? 'Buurman/buurvrouw' :\n            (data.gegevensVanuitAanvraag?.contactpersoon?.relatieTotAanvrager === 'KENNIS' ? 'Kennis' :\n            (data.gegevensVanuitAanvraag?.contactpersoon?.relatieTotAanvrager === 'HULPVERLENER' ? 'Hulpverlener' :\n            (data.gegevensVanuitAanvraag?.contactpersoon?.relatieTotAanvrager === 'BOEKHOUDER' ? 'Boekhouder' :\n            (data.gegevensVanuitAanvraag?.contactpersoon?.relatieTotAanvrager === 'BEWINDVOERDER' ? 'Bewindvoerder' :\n            (data.gegevensVanuitAanvraag?.contactpersoon?.relatieTotAanvrager === 'MEDEWERKER_VAN_DE_GEMEENTE' ? 'Medewerker van de Gemeente' :\n            (data.gegevensVanuitAanvraag?.contactpersoon?.relatieTotAanvrager === 'ONBEKEND' ? 'Onbekend' : data.gegevensVanuitAanvraag?.contactpersoon?.relatieTotAanvrager)\n            )\n            )\n            )\n            )\n            )\n            )\n            )  }}} </dt>\n        <dd class=\"col-6\">{{{ ( data.gegevensVanuitAanvraag?.contactpersoon?.telefoon ? 'Telefoonnummer' : '' ) }}} </dd>\n        <dt class=\"col-6\">{{{ ( data.gegevensVanuitAanvraag?.contactpersoon?.telefoon || '') }}} </dt>\n    </dl>\n    <dl class=\"row mb-0\">\n        <dd class=\"col-6\">Reden aanvraag</dd>\n        <dt class=\"col-6\">{{{data.gegevensVanuitAanvraag?.redenAanvraag?.reden?.name || '-'}}}</dt>\n    </dl>\n    <dl class=\"row mb-0 pt-1\">\n        <dd class=\"col-6\"></dd>\n        <dt class=\"col-6\">\n            {{ (() => {\n            const reason = data.gegevensVanuitAanvraag?.redenAanvraag?.reden?.name;\n            const reasonsData = data.gegevensVanuitAanvraag?.redenAanvraag;\n\n            if (reason === 'Geen of te weinig inkomen') {\n            return reasonsData?.onvoldoendeInkomen?.name || '-';\n            } else if (reason === 'Wijziging gezin') {\n            return reasonsData?.wijzigingGezin?.name || '-';\n            } else if (reason === '(ex)Zelfstandige') {\n            return reasonsData?.zelfstandige?.name || '-';\n            } else if (reason === 'Verblijfsstatus') {\n            return reasonsData?.verblijfstatus?.name || '-';\n            } else if (reason === 'Ik kom vrij na gevangenisstraf') {\n            const detentieDuur = reasonsData?.gestopteDetentie[0]?.detentieDuur?.name;\n            return detentieDuur === 'Ja' ? 'Langer dan 31 dagen' : detentieDuur === 'Nee' ? '30 dagen of minder' : '-';\n            } else if (reason === 'Anders') {\n            return reasonsData?.andereRedenVerzoek[0]?.geldtekortSpecificatie || '-';\n            } else {\n            return '-';\n            }\n            })() }}\n        </dt>\n    </dl>\n</section>",
