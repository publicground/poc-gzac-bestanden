                        {
                            "label": "headerHTML",
                            "content": "<section class=\"container-fluid p-0\">\n  <div class=\"bg-light border-bottom m-0 py-1 px-3\">\n    <div class=\"row align-items-center mx-0\">\n      <div class=\"col-12 px-1\">\n        <div style=\"font-size: 1.1rem; font-weight: normal; line-height: 1.4; margin: 0; white-space: nowrap; overflow: visible; text-overflow: clip;\" title=\"{{ data.openzaak?.identificatie || '-' }}\">{{{ data.openzaak?.identificatie || '-' }}}</div>\n      </div>\n    </div>\n  </div> \n  \n      <div  class=\"row align-items-center mx-0 mb-1 gx-0\">\n        <div class=\"col-4 mb-0 px-1\">\n            <div class=\"row\" style=\"margin-right:0px; margin-left:0px\"><div class=\"col-6\">Aanvrager:</div> <div class=\"col-6\">{{{(data.gegevensVaststelling?.aanvrager?.naamVolledig ||\n        [data.gegevensVaststelling?.aanvrager?.voorletters, data.gegevensVaststelling?.aanvrager?.tussenvoegsel, data.gegevensVaststelling?.aanvrager?.achternaam].filter(Boolean).join(' ') ||\n        [data.gegevensVaststelling?.aanvrager?.voornaam, data.gegevensVaststelling?.aanvrager?.tussenvoegsel, data.gegevensVaststelling?.aanvrager?.achternaam].filter(Boolean).join(' ')\n      ) || '-' }}}</div></div>\n            <div class=\"row\" style=\"margin-right:0px; margin-left:0px\"><div class=\"col-6\">Partner:</div> <div class=\"col-6\">{{{ (\n        data.gegevensVaststelling?.partner?.naamVolledig ||\n        [data.gegevensVaststelling?.partner?.voorletters, data.gegevensVaststelling?.partner?.tussenvoegsel, data.gegevensVaststelling?.partner?.achternaam].filter(Boolean).join(' ') ||\n        [data.gegevensVaststelling?.partner?.voornaam, data.gegevensVaststelling?.partner?.tussenvoegsel, data.gegevensVaststelling?.partner?.achternaam].filter(Boolean).join(' ')\n      ) || '-' }}}</div></div>\n          </div>\n\n        <div class=\"col-4 mb-0 px-1\">\n            <div class=\"row\" style=\"margin-right:0px; margin-left:0px\"><div class=\"col-6\">Geb. datum:</div> <div class=\"col-6\">{{{ data.gegevensVaststelling?.aanvrager?.geboortedatum ? moment(data.gegevensVaststelling.aanvrager.geboortedatum).format('DD-MM-YYYY') : '-' }}}</div></div>\n            <div class=\"row\" style=\"margin-right:0px; margin-left:0px\"><div class=\"col-6\">Geb. datum partner:</div> <div class=\"col-6\">{{{ data.gegevensVaststelling?.partner?.geboortedatum ? moment(data.gegevensVaststelling.partner.geboortedatum).format('DD-MM-YYYY') : '-' }}}</div></div>\n        </div>\n        <div class=\"col-4 mb-0 px-1\">\n            <div class=\"row\" style=\"margin-right:0px; margin-left:0px\"><div class=\"col-6\">BSN:</div> <div class=\"col-6\">{{{ data.gegevensVaststelling?.aanvrager?.bsn || '-' }}}</div></div>\n            <div class=\"row\" style=\"margin-right:0px; margin-left:0px\"><div class=\"col-6\">BSN partner:</div> <div class=\"col-6\">{{{ data.gegevensVaststelling?.partner?.bsn || '-' }}}</div></div>\n        </div>\n      </div>\n</section>",
