{
    "display": "form",
    "components": [
        {
            "label": "aanvraagSchulden",
            "key": "pv.aanvraagSchulden",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "vastgesteldeSchuld",
            "key": "pv.vastgesteldeSchuld",
            "type": "hidden",
            "input": true,
            "tableView": false
        },
        {
            "label": "Vaststellen schuld",
            "content": "<h2 class=\"mb-3\">Vaststellen schuld</h2>",
            "refreshOnChange": false,
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "tableView": false
        },
        {
            "label": "Er zijn geen  opgegeven schulden gevonden. Wil je deze alsnog toevoegen?",
            "optionsLabelPosition": "right",
            "inline": false,
            "tableView": false,
            "defaultValue": "NEE",
            "values": [
                {
                    "label": "Ja",
                    "value": "JA",
                    "shortcut": ""
                },
                {
                    "label": "Nee",
                    "value": "NEE",
                    "shortcut": ""
                }
            ],
            "validate": {
                "required": true
            },
            "validateWhenHidden": false,
            "key": "pv.schuldenVaststellen",
            "customConditional": "show = data.pv.aanvraagSchulden.length === 0;",
            "type": "radio",
            "input": true
        },
        {
            "label": "Schulden",
            "reorder": false,
            "addAnotherPosition": "bottom",
            "layoutFixed": false,
            "enableRowGroups": false,
            "initEmpty": false,
            "hideLabel": true,
            "tableView": false,
            "validateWhenHidden": false,
            "key": "pv.schulden",
            "addAnother": "Schuld toevoegen",
            "customConditional": "show =\n    data.pv.schuldenVaststellen === 'JA' ||\n    (\n        !data.pv.schuldenVaststellen &&\n        (\n            data.pv.vastgesteldeSchuld.length > 0 ||\n            data.pv.aanvraagSchulden.length > 0\n        )\n    );",
            "type": "datagrid",
            "input": true,
            "components": [
                {
                    "label": "Columns",
                    "columns": [
                        {
                            "components": [
                                {
                                    "label": "Soort schuld",
                                    "widget": "choicesjs",
                                    "disabled": true,
                                    "tableView": true,
                                    "dataSrc": "custom",
                                    "defaultValue": {
                                        "code": "12",
                                        "name": "Schulden uitgezonderd studieschuld"
                                    },
                                    "data": {
                                        "custom": "values = [{ \"code\": \"12\", \"name\": \"Schulden uitgezonderd studieschuld\" },\n  ]"
                                    },
                                    "template": "<span>{{ item.name }} ({{ item.code }})</span>",
                                    "validate": {
                                        "required": true
                                    },
                                    "validateWhenHidden": false,
                                    "key": "soortVermogenscomponent",
                                    "type": "select",
                                    "input": true
                                }
                            ],
                            "size": "md",
                            "width": 12,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "currentWidth": 12
                        },
                        {
                            "components": [
                                {
                                    "label": "Omschrijving",
                                    "applyMaskOn": "change",
                                    "tableView": true,
                                    "validateWhenHidden": false,
                                    "key": "omschrijving",
                                    "type": "textfield",
                                    "input": true
                                }
                            ],
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "currentWidth": 4,
                            "width": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "Waarde",
                                    "applyMaskOn": "change",
                                    "mask": false,
                                    "tableView": false,
                                    "currency": "EUR",
                                    "inputFormat": "plain",
                                    "truncateMultipleSpaces": false,
                                    "validate": {
                                        "required": true
                                    },
                                    "validateWhenHidden": false,
                                    "key": "waarde",
                                    "type": "currency",
                                    "input": true,
                                    "delimiter": true
                                }
                            ],
                            "width": 4,
                            "offset": 0,
                            "push": 0,
                            "pull": 0,
                            "size": "md",
                            "currentWidth": 4
                        },
                        {
                            "components": [
                                {
                                    "label": "Peildatum",
                                    "format": "dd-MM-yyyy",
                                    "tableView": false,
                                    "datePicker": {
                                        "disableWeekends": false,
                                        "disableWeekdays": false
                                    },
                                    "enableTime": false,
                                    "defaultDate": "moment()",
                                    "validate": {
                                        "required": true
                                    },
                                    "enableMinDateInput": false,
                                    "enableMaxDateInput": false,
                                    "validateWhenHidden": false,
                                    "key": "datumVaststelling",
                                    "type": "datetime",
                                    "input": true,
                                    "widget": {
                                        "type": "calendar",
                                        "displayInTimezone": "viewer",
                                        "locale": "en",
                                        "useLocaleSettings": false,
                                        "allowInput": true,
                                        "mode": "single",
                                        "enableTime": false,
                                        "noCalendar": false,
                                        "format": "dd-MM-yyyy",
                                        "hourIncrement": 1,
                                        "minuteIncrement": 1,
                                        "time_24hr": false,
                                        "minDate": null,
                                        "disableWeekends": false,
                                        "disableWeekdays": false,
                                        "maxDate": null
                                    }
                                }
                            ],
                            "size": "md",
                            "width": 4,
                            "currentWidth": 4
                        }
                    ],
                    "key": "columns",
                    "type": "columns",
                    "hideLabel": true,
                    "input": false,
                    "tableView": false
                }
            ]
        },
        {
            "label": "Toelichting",
            "applyMaskOn": "change",
            "autoExpand": false,
            "tableView": true,
            "validate": {
                "required": true
            },
            "validateWhenHidden": false,
            "key": "pv.schuldenToelichting",
            "type": "textarea",
            "input": true
        },
        {
            "label": "ButtonColumns",
            "columns": [
                {
                    "components": [
                        {
                            "type": "button",
                            "label": "Vorige",
                            "key": "back",
                            "action": "custom",
                            "custom": "form.submit();\n",
                            "theme": "warning",
                            "input": true,
                            "tableView": false
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                },
                {
                    "components": [
                        {
                            "label": "Volgende",
                            "action": "custom",
                            "showValidations": false,
                            "disableOnInvalid": true,
                            "tableView": false,
                            "key": "submit",
                            "type": "button",
                            "custom": "if (data.pv?.schuldenVaststellen === 'NEE') { data.pv.schulden = []; form.submit(); }\nelse { form.submit(); }",
                            "input": true
                        }
                    ],
                    "width": 6,
                    "offset": 0,
                    "push": 0,
                    "pull": 0,
                    "size": "md",
                    "currentWidth": 6
                }
            ],
            "key": "buttonColumns",
            "type": "columns",
            "input": false,
            "tableView": false
        }
    ]
}