      <text>date( date and time( get or else( gegevensVaststelling.additioneleVeldenAanvrager.bs221ingangsdatum.ingangsdatum, get or else ( gegevensVaststelling.startDatum,  gegevensVanuitAanvraag.startDatum) ) ) )

