  <decision id="bs-444-mogelijk-recht-op-zw" name="Mogelijk recht op ZW?">
    <informationRequirement id="InformationRequirement_1wcsqbe">
      <requiredDecision href="#bs-444-betrokkenen-en-bronnen" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_08364s8">
      <requiredDecision href="#bs-444-berekening-ingangsdatum" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1jat05n" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="InputClause_07m0zhv" label="Lopende ZW (opgaven)?">
        <inputExpression id="LiteralExpression_1c5hl1l" typeRef="boolean">
          <text>count(
                        flatten(inkomsten.uitkering.opgaven)[date(item.datumEindOpgave) &gt; today() - duration("P3M")  ].codeSoortIkv.code[item="31"])&gt;0

                        // 31 - ZW
                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_18e3ln1" label="Lopende ZW (ikv)">
        <inputExpression id="LiteralExpression_0zxgbiv" typeRef="boolean">
          <text>count( flatten( inkomsten.uitkering[ date(item.datumEindIkv) &gt; today() - duration("P3M") or item.datumEindIkv = ""].opgaven).codeSoortIkv.code[item="31"])&gt;0
                        // 31 - ZW
                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_0oj375p" label="Arbeidsverleden?">
        <inputExpression id="LiteralExpression_10o0zhf" typeRef="boolean">
          <text>get or else(
                        date(sort(
                        flatten (
                        for i in flatten(
                        concatenate(
                        inkomsten.loondienst.opgaven, inkomsten.uitkering.opgaven
                        )
                        ) return  if i.codeSoortIkv.code != "31" then i.datumEindOpgave else []
                        ),  function(x,y) x &gt; y)[1]) &gt; date(ingangsdatum) - duration("P2Y")
                        , false )
                        // als laatste 24 maanden geen UWV-uitkering EN geen loondienst, dan kan er ook geen recht op ZW zijn
                        // behalve als het ZW - code 31 is</text>
        </inputExpression>
      </input>
      <input id="InputClause_1dmy9j0" label="Beschikbaar voor werk?">
        <inputExpression id="LiteralExpression_1p0yyrw" typeRef="boolean">
          <text>beschikbaarheid.uurPerWeek &gt; 32
                        // wat is minimaal aantal uur? ik heb nu 32 aangenomen</text>
        </inputExpression>
      </input>
      <output id="OutputClause_1v4zym8" name="zwMogelijkRecht" typeRef="string" />
      <output id="OutputClause_116yv2o" name="zwVerantwoordingVaststelling" typeRef="string" biodi:width="434" />
      <output id="OutputClause_0emz7jb" name="zwSignalering" typeRef="boolean" />
