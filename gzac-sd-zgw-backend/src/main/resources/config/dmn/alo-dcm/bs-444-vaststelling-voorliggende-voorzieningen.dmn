  <decision id="bs-444-mogelijk-recht-op-tw" name="Mogelijk recht op TW?">
    <informationRequirement id="InformationRequirement_1x84p69">
      <requiredDecision href="#bs-444-berekening-ingangsdatum" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_19n2q6v">
      <requiredDecision href="#bs-444-betrokkenen-en-bronnen" />
    </informationRequirement>
    <decisionTable id="DecisionTable_0to0vdn" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="InputClause_1dxs9o3" label="Lopende TW (opgaven)">
        <inputExpression id="LiteralExpression_0t77it0" typeRef="boolean">
          <text>get or else( max( inkomsten.uitkering.opgaven[ codeSoortIkv = 46 ].datumEindOpgave ) + duration("P3M") &gt; ingangsdatum, false )
                        //46 Uitkering uit hoofde van de Toeslagenwet</text>
        </inputExpression>
      </input>
      <input id="InputClause_1rjagsa" label="Lopende TW (ikv)">
        <inputExpression id="LiteralExpression_0rh5p0x" typeRef="boolean">
          <text>get or else ( max( inkomsten.uitkering[codeSoortIkv = 46 ].datumEindIkv ) &gt; ingangsdatum, false ) or
                        get or else ( any( inkomsten.uitkering[codeSoortIkv = 46 ].datumEindIkv[""] ), false )
                        // 46 - toeslagenwet
                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_0biwk99" label="&#60; 21 jaar">
        <inputExpression id="LiteralExpression_01phg4c" typeRef="boolean">
          <text>( date( persoon.geboortedatum ) + duration("P21Y") ) &gt; date( ingangsdatum )</text>
        </inputExpression>
      </input>
      <input id="InputClause_0m1aekh" label="Thuiswonend?">
        <inputExpression id="LiteralExpression_14j0t8l" typeRef="boolean">
          <text> persoon.relaties != null and (
                        some rt in
                        persoon.relaties[woontOpHetzelfdeAdresAlsAanvrager].relatietype satisfies rt="kindOuder" or rt="kindSchoonouder"
                        )</text>
        </inputExpression>
      </input>
      <input id="InputClause_11jveb6" label="Gezamenlijke huishouding?">
        <inputExpression id="LiteralExpression_1up6j3p" typeRef="boolean">
          <text>gegevensVaststelling.leefsituatie.leefsituatie  = "SAMENWONEND" or gegevensVaststelling.leefsituatie.leefsituatie = "SAMENWONEND_KINDEREN"
                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_14gpcdv" label="partner geboren na 1971?">
        <inputExpression id="LiteralExpression_123jzii" typeRef="boolean">
          <text>get or else( date(partner.geboortedatum) &gt; date("1971-12-31") , false )</text>
        </inputExpression>
      </input>
      <input id="InputClause_1n39p7b" label="Kind &#60; 12 jaar?">
        <inputExpression id="LiteralExpression_12yby19" typeRef="boolean">
          <text>get or else(
                        date(
                        sort(
                        list: persoon.relaties[relatietype = "ouderKind" ].geboortedatum,
                        precedes: function(x,y) date(x) &gt; date(y)
                        )[1]
                        )  + duration("P12Y") &gt; date( ingangsdatum )
                        , false )
                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_1tfkyic" label="UWV-uitkering of loondoorbetaling bij ziekte?">
        <inputExpression id="LiteralExpression_1f9bvpo" typeRef="boolean">
          <text>some uitk in flatten( get or else ( inkomsten.uitkering.opgaven, [] ) ) satisfies date(uitk.datumEindOpgave) &gt; today() - duration("P3M") and list contains(["14", "31", "33", "36", "37", "38", "52", "WAZO"], uitk.codeSoortIkv.code)
                        // als laatste drie maanden geen UWV-uitkering, dan kan er ook geen recht op TW zijn


                    </text>
        </inputExpression>
      </input>
      <output id="OutputClause_1613wof" name="twMogelijkRecht" typeRef="string" />
      <output id="OutputClause_0aojlby" name="twVerantwoordingVaststelling" typeRef="string" biodi:width="532" />
      <output id="OutputClause_0b71ndn" name="twSignalering" typeRef="boolean" />
      <rule id="DecisionRule_1nrvrbx">
        <description>op basis van loonaangifte</description>
