  <decision id="bs-444-onderhoudsplicht-partner" name="Onderhoudsplicht partner?">
    <decisionTable id="DecisionTable_16t9zsv" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="InputClause_1mir6an" label="Partner Overleden">
        <inputExpression id="LiteralExpression_15tayqm" typeRef="boolean">
          <text>Persoon(Persoon_expartner).DatumOverlijden
                        = BRP: ClientSUWI(Burgerservicenummer =
                        Persoon_expartner.Burgerservicenummer).Overlijden.DatOverlijden
                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_0wp152e" label="Actuele partner-relatie?" camunda:inputVariable="Persoon">
        <inputExpression id="LiteralExpression_1366g53" typeRef="boolean">
          <text>any(Persoon(Persoon_aanvrager).Persoonsrelatie.Persoonsrelatietype="P")</text>
        </inputExpression>
      </input>
      <input id="InputClause_1mrsg14" label="Datum Echtscheiding" biodi:width="192">
        <inputExpression id="LiteralExpression_1pv73i8" typeRef="date">
          <text>BRP:
                        ClientSUWI(Burgerservicenummer =
                        Persoon.Burgerservicenummer).HuwelijkHistorisch(Partner.Burgerservicenr=Persoon_expartner.Burgerservicenummer).DatOntbHuwelijk </text>
        </inputExpression>
      </input>
      <input id="InputClause_1jbudwj" label="Duur huwelijk" biodi:width="192">
        <inputExpression id="LiteralExpression_14xsivh" typeRef="period">
          <text>BRP: ClientSUWI(Burgerservicenummer =
                        Persoon.Burgerservicenummer).HuwelijkHistorisch(Partner.Burgerservicenr=Persoon_expartner.Burgerservicenummer).DatOntbHuwelijk
                        - ClientSUWI(Burgerservicenummer =
                        Persoon.Burgerservicenummer).HuwelijkHistorisch(Partner.Burgerservicenr=Persoon_expartner.Burgerservicenummer).DatHuwelijkssluiting
                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_0q55ihq" label="Kinderen uit relatie?">
        <inputExpression id="LiteralExpression_13geev4" typeRef="boolean">
          <text>Voor elk
                        gevonden kind:

                        OuderKind(IsSubjectIn = Persoon_aanvrager).IsObjectIn = het gevonden
                        kind

                        EN

                        OuderKind(IsSubjectIn = Persoon_expartner).IsObjectIn = het gevonden kind</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ojtcfg" label="Zorg voor kinderen &#60; 12 jaar" biodi:width="192" camunda:inputVariable="Zaak">
        <inputExpression id="LiteralExpression_1lqibyl" typeRef="boolean">
          <text>any( Zaak.Aanvraag.Huishouden.Personen.OuderKinderen(IndicatieKinderbijslag = true).IsObjectIn.Geboortedatum &gt; today() - duration("P12Y" )</text>
        </inputExpression>
      </input>
      <input id="InputClause_11rg08w" label="Leeftijd onderhoudgerechtigde" biodi:width="192" camunda:inputVariable="Zaak">
        <inputExpression id="LiteralExpression_0a1mhuc" typeRef="integer">
          <text>Zaak.Aanvraag.Huishouden.Persoon_aanvrager.Geboortedatum</text>
        </inputExpression>
      </input>
      <input id="InputClause_0c8v7m4" label="Datum echtscheiding">
        <inputExpression id="LiteralExpression_0pm7ip3" typeRef="date">
          <text>Zaak.Aanvraag.Huishouden.Persoon(Persoon_aanvrager).IsSubjectIn(type:Ex-partner).IsObjectIn(Persoon_expartner).DatumEindeRelatie</text>
        </inputExpression>
      </input>
      <output id="OutputClause_1h14lvu" label="Onderhoudsplicht partner" typeRef="boolean" />
