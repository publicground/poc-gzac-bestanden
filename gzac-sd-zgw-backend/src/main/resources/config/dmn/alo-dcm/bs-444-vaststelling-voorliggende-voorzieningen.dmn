  <decision id="bs-444-mogelijk-recht-op-ww" name="Mogelijk recht op WW?">
    <informationRequirement id="InformationRequirement_1hq4xk5">
      <requiredDecision href="#bs-444-betrokkenen-en-bronnen" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_1wdsvov">
      <requiredDecision href="#bs-444-berekening-ingangsdatum" />
    </informationRequirement>
    <decisionTable id="DecisionTable_13uccst" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="InputClause_1vzsglq" label="Lopende WW (opgaven)">
        <inputExpression id="LiteralExpression_147kgjx" typeRef="string">
          <text>count(
                        flatten(inkomsten.uitkering.opgaven)[date(item.datumEindOpgave) &gt; today() - duration("P3M")  ].codeSoortIkv.code[item="33" or item="35"])&gt;0

                        // 33 - WW
                        // 35 - Verlenging WW
                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_0bto7cy" label="Lopende WW (ikv)">
        <inputExpression id="LiteralExpression_1sujqvb" typeRef="string">
          <text>count( flatten( inkomsten.uitkering[ date(item.datumEindIkv) &gt; today() - duration("P3M") or item.datumEindIkv = ""].opgaven).codeSoortIkv.code[item="33" or item="35"])&gt;0
                        // 33 - WW
                        // 35 - Verlenging WW</text>
        </inputExpression>
      </input>
      <input id="InputClause_1dxixz2" label="Voldoet mogelijk aan wekeneis">
        <inputExpression id="LiteralExpression_10jgty1" typeRef="boolean">
          <text>sum(
                        for i in [1,2,3,4,5,6,7,8,9] return
                        if
                        some opg in flatten(inkomsten.loondienst.opgaven.datumEindOpgave) satisfies date(opg) &lt; date(ingangsdatum) - duration("P1M") * (i-1) and date(opg) &gt; date(ingangsdatum) - duration("P1M") * i
                        then 1 else 0) &gt; 5


                        // Als er in de laatste 9 maanden vier hele maanden geen inkomen was, dan kan er nooit meer dan 26 van de 36 weken gewerkt zijn. Dus alleen als er 5 of meer maande inkomen was, dan is er mogelijk recht op WW
                    </text>
        </inputExpression>
      </input>
      <output id="OutputClause_1vxh4m3" name="wwMogelijkRecht" typeRef="string" />
      <output id="OutputClause_0968voi" name="wwVerantwoordingVaststelling" typeRef="string" />
      <output id="OutputClause_1j1pwya" name="wwSignalering" typeRef="string" />
      <rule id="DecisionRule_0meqir8">
        <inputEntry id="UnaryTests_0f57b8f">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_096x4pr">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1btk8fh">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1278650">
          <text>"wel recht"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1a1le1d">
          <text>"lopende WW"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1uf79yg">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0spullk">
        <inputEntry id="UnaryTests_0fiqrwz">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1mskyha">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1s5pb0s">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_01g0bl2">
          <text>"wel recht"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1t3t509">
          <text>"lopende WW"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0ru82b4">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_14iir48">
        <description>In de laatste 36 weken voordat u werkloos werd, moet u in minstens 26 weken hebben gewerkt. Het maakt niet uit hoeveel uur u per week werkte.</description>
        <inputEntry id="UnaryTests_14he8jc">
