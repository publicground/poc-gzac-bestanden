  <decision id="bs-444-mogelijk-recht-op-ioaw" name="Mogelijk recht op IOAW?">
    <informationRequirement id="InformationRequirement_12xngri">
      <requiredDecision href="#bs-444-betrokkenen-en-bronnen" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_1tlbu95">
      <requiredDecision href="#bs-444-berekening-ingangsdatum" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1gp0yxt" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="InputClause_1ma3jgw" label="Lopende IOAW (opgaven)" biodi:width="192">
        <inputExpression id="LiteralExpression_02epw2a" typeRef="boolean">
          <text>get or else( max( inkomsten.uitkering.opgaven[ codeSoortIkv = 34 ].datumEindOpgave ) + duration("P3M") &gt; ingangsdatum, false)
                        // 34 - IOAW

                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_1xsjmic" label="Lopende IOAW (ikv)">
        <inputExpression id="LiteralExpression_1gh0tl9" typeRef="boolean">
          <text>get or else( max( inkomsten.uitkering[codeSoortIkv = 34 ].datumEindIkv ) &gt; ingangsdatum, false ) or
                        get or else( any( inkomsten.uitkering[codeSoortIkv = 34 ].datumEindIkv[""] ), false)

                        // 34 - ZW</text>
        </inputExpression>
      </input>
      <input id="InputClause_0z1aebh" label="Lopende IOAW (zaak)" biodi:width="192">
        <inputExpression id="LiteralExpression_1gludt1" typeRef="boolean">
          <text>false
                        // nog niet uitgewerkt in Den Haag
                        // GBI: any( Zaak.Aanvraag.Huishouding.Personen.Diensten.Diensttype( Naam=IOAW))
                        // 34 - IOAW</text>
        </inputExpression>
      </input>
      <input id="InputClause_0e2u8w0" label="Geboren na 1 januari 1965?">
        <inputExpression id="LiteralExpression_05j1kt1" typeRef="boolean">
          <text>persoon.geboortedatum &gt; date("19641231")
                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_0cw8iob" label="WW na 50e verjaardag?" biodi:width="192">
        <inputExpression id="LiteralExpression_0s4cfx6" typeRef="boolean">
          <text>get or else( max( inkomsten.uitkering[codeSoortIkv = 33 or codeSoortIkv = 35 ].datumStartIkv ) &gt; persoon.geboortedatum + duration("P50Y"), false )

                        // 33 - WW
                        // 35 - Verlenging WW
                        // moeten we hier verlening ook in ogenschouw nemen? want verlening kan alleen als er ook eerst WW is geweest?
                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_17ik9sk" label="WGA na 50e verjaardag?">
        <inputExpression id="LiteralExpression_0hbvf0f" typeRef="boolean">
          <text>get or else( min( inkomsten.uitkering.opgaven[ codeSoortIkv = 34 ].datumStartOpgave ) + duration("P1M") &gt; persoon.geboortedatum + duration("P50Y"), false )

                        // 40 - WGA

                        // einddatum inkomstenverhouding komt niet voor in json, daarom wordt er gegeken wanneer er voor het eerst  ww is genoten.</text>
        </inputExpression>
      </input>
      <input id="InputClause_0w9cn9r" label="WW &#62; 3 maanden" biodi:width="192">
        <inputExpression id="LiteralExpression_12hen95" typeRef="boolean">
          <text> get or else( max( inkomsten.uitkering[codeSoortIkv = 33 or codeSoortIkv = 35 ].datumEindIkv ) &gt; max( inkomsten.uitkering[codeSoortIkv = 33].datumStartIkv) + duration("P3M"))

                        // 33 - WW
                        // 35 - Verlenging WW
                        // we nemen verschil tussen de max van de begindata en de max van de einddata. Er kunnen immers nooit twee WW uitkeringen tegelijkertijd zijn, dus de max van de begindata is de begindatum van de laatste WW en de max van de einddata is de eindatum van de laatste WW
                        // moeten we hier verlening ook in ogenschouw nemen bij de startdatum? want verlening kan alleen als er ook eerst WW is geweest?</text>
        </inputExpression>
      </input>
      <input id="InputClause_1uep47z" label="Max WW bereikt?">
        <inputExpression id="LiteralExpression_1mi6jt6" typeRef="boolean">
          <text>true
                        // er is geen goede bron bekend. door de waarde leeg te laten, gaat deze regel nooit af.</text>
        </inputExpression>
      </input>
      <input id="InputClause_1ochccj" label="Lopende WGA?">
        <inputExpression id="LiteralExpression_1dxqzfv" typeRef="boolean">
          <text>get or else( max( inkomsten.uitkering.opgaven[ codeSoortIkv = 40 ].datumEindOpgave ) + duration("P3M") &gt; ingangsdatum )
                        // 40 - WGA
                    </text>
        </inputExpression>
      </input>
      <input id="InputClause_0wnwtni" label="Reden einde WGA">
        <inputExpression id="LiteralExpression_0u8t43g" typeRef="string">
          <text>""
                        // er is geen goede bron bekend. door de waarde leeg te laten, gaat deze regel nooit af.</text>
        </inputExpression>
      </input>
      <output id="OutputClause_0oco8vj" name="ioawMogelijkRecht" typeRef="string" />
      <output id="OutputClause_1mh2jaj" name="ioawVerantwoordingVaststelling" typeRef="string" biodi:width="386" />
      <output id="OutputClause_0ttdaw4" name="ioawSignalering" typeRef="boolean" />
      <rule id="DecisionRule_0l6q2hf">
