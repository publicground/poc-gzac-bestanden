      <output id="OutputClause_0ogeodb" label="bruto subtotaal" name="brutoSubtotaal" typeRef="double" biodi:width="637" />
      <output id="OutputClause_0msgngj" label="vrijlating" name="vrijlating" typeRef="double" biodi:width="271" />
      <output id="OutputClause_1h3zr7f" label="netto subtotaal" name="nettoSubtotaal" typeRef="double" biodi:width="847" />
      <output id="OutputClause_0xsa5ht" label="commentaar" name="commentaar" typeRef="string" biodi:width="241" />
      <output id="OutputClause_1arsozm" label="rekenwaarde" name="rekenwaarde" typeRef="double" biodi:width="388" />
      <rule id="DecisionRule_0db6qng">
        <inputEntry id="UnaryTests_0qqnihu">
          <text>count(bankrekeningen) &gt; 0</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1tyxu1o">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1y8w5bi">
          <text>bankrekeningen</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0dtv3m6">
          <text>sum(bankrekeningen.waarde)</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1c8x7zg">
          <text>0</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_12g7zn8">
          <text>sum(bankrekeningen.waarde)</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0ag1qra">
          <text>"Bankrekeningen"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0jsnop6">
          <text>sum(bankrekeningen.waarde)</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_15adof9">
        <inputEntry id="UnaryTests_02qz6px">
          <text>count(overigMetVrijlating) &gt; 0</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0fr1vx1">
          <text>overigMetVrijlating[1].waarde &lt;= normEersteAuto</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1cbyywp">
          <text>[overigMetVrijlating[1]]</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0vgu7cq">
          <text>overigMetVrijlating[1].waarde</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0c35l7r">
          <text>overigMetVrijlating[1].waarde</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0maqove">
          <text>0</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_08fyk5o">
          <text>"Bezittingen met vrijlatingen"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0uwghbk">
          <text>0</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1i90392">
        <inputEntry id="UnaryTests_1v0bi56">
          <text>count(overigMetVrijlating) &gt; 0</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1hb7mj3">
          <text>overigMetVrijlating[1].waarde &gt; normEersteAuto</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1h7h5xu">
          <text>[overigMetVrijlating[1]]</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_17ytlcn">
          <text>overigMetVrijlating[1].waarde</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_092crab">
          <text>normEersteAuto</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1hrq2xc">
          <text>overigMetVrijlating[1].waarde - normEersteAuto</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0vy66xt">
          <text>"Bezittingen met vrijlatingen"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0651l2n">
          <text>overigMetVrijlating[1].waarde - normEersteAuto</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0itsubv">
        <inputEntry id="UnaryTests_0mo0nd2">
          <text>count(overigZonderVrijlating) &gt; 0</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0e94dzr">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_057lv85">
          <text>overigZonderVrijlating</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_037wf9m">
          <text>sum(overigZonderVrijlating.waarde)</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0abos1i">
          <text>0</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0hpe0cj">
          <text>sum(overigZonderVrijlating.waarde)</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0gf5rdh">
          <text>"Overige bezittingen"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0k1bj5s">
          <text>sum(overigZonderVrijlating.waarde)</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0rn7nol">
        <inputEntry id="UnaryTests_1c9wps6">
          <text>count(schulden) &gt; 0</text>
        </inputEntry>
        <inputEntry id="UnaryTests_04l2b97">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0f4eljw">
          <text>schulden</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0i5h3sw">
          <text>sum(schulden.waarde)</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1qbdf2o">
          <text>0</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0z5xdbu">
          <text>sum(schulden.waarde)</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1dj93mq">
          <text>"Schulden"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1hvj74w">
          <text>sum(schulden.waarde) * -1</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1vxlkil">
        <inputEntry id="UnaryTests_1lx6hqs">
          <text>count(eigenWoning) &gt; 0</text>
        </inputEntry>
        <inputEntry id="UnaryTests_12u9ouc">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0s0c86s">
          <text>eigenWoning </text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0qg03d3">
          <text>(if sum(eigenWoning[soortVermogenscomponent.code = "1"].waarde) = null
 then 0
 else sum(eigenWoning[soortVermogenscomponent.code = "1"].waarde))
-
(if sum(eigenWoning[soortVermogenscomponent.code = "17"].waarde) = null
 then 0
 else sum(eigenWoning[soortVermogenscomponent.code = "17"].waarde))
+
(if sum(eigenWoning[soortVermogenscomponent.code = "15"].waarde) = null
 then 0
 else sum(eigenWoning[soortVermogenscomponent.code = "15"].waarde))
</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0cdd49q">
          <text>normVermogenInEigenWoning</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1lrg511">
          <text>max((if sum(eigenWoning[soortVermogenscomponent.code = "1"].waarde) = null
 then 0
 else sum(eigenWoning[soortVermogenscomponent.code = "1"].waarde))
-
(if sum(eigenWoning[soortVermogenscomponent.code = "17"].waarde) = null
 then 0
 else sum(eigenWoning[soortVermogenscomponent.code = "17"].waarde))
+
(if sum(eigenWoning[soortVermogenscomponent.code = "15"].waarde) = null
 then 0
 else sum(eigenWoning[soortVermogenscomponent.code = "15"].waarde)) - normVermogenInEigenWoning, 0)</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_17jewn9">
          <text>"Eigen woning"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0s6mcc1">
          <text>0</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="bs-214-vaststellen-vrijlatingen" name="Vrijlatingen">
    <decisionTable id="DecisionTable_0sy25ee" hitPolicy="FIRST" preferredOrientation="Rule-as-Row" biodi:annotationsWidth="400">
      <input id="InputClause_1wgfrv5">
        <inputExpression id="LiteralExpression_1ugghjc" typeRef="date">
          <text>peildatum</text>
        </inputExpression>
      </input>
      <output id="OutputClause_1hky0e8" label="normEersteAuto" name="normEersteAuto" typeRef="double" />
      <output id="OutputClause_1jo2dsr" label="normVermogenInEigenWoning" name="normVermogenInEigenWoning" typeRef="double" biodi:width="223" />
      <rule id="DecisionRule_024cwme">
        <inputEntry id="UnaryTests_1dfeubf">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0vti80m">
          <text>4500</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1a79sn4">
          <text>64000</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="bankrekeningen" name="bankrekeningen">
    <variable id="InformationItem_1lp0mec" name="bankrekeningen" typeRef="Any" />
    <literalExpression id="LiteralExpression_0dhgaa4">
      <text>//pak alle componenten met soortVermogenscomponent.code = 3 en sorteer ze van hoogste naar laagste waarde.

sort(list: vermogensComponenten[ soortVermogenscomponent.code = "3" ], precedes: function(x,y) if x.soortVermogenscomponent.code = y.soortVermogenscomponent.code then x.waarde &gt; y.waarde else x.soortVermogenscomponent.code &lt; y.soortVermogenscomponent.code )

// Bank-/Girorekening (3)</text>
    </literalExpression>
  </decision>
  <decision id="overigMetVrijlating" name="overigMetVrijlating">
    <variable id="InformationItem_0fbzmn6" name="overigMetVrijlating" typeRef="Any" />
    <literalExpression id="LiteralExpression_1ssr7t4">
      <text>// Pak alle componenten met soortVermogenscomponent.code = 6 en sorteer ze van hoogste naar laagste waarde.

sort(list: vermogensComponenten[ soortVermogenscomponent.code = "6" ], precedes: function(x,y) if x.soortVermogenscomponent.code = y.soortVermogenscomponent.code then x.waarde &gt; y.waarde else x.soortVermogenscomponent.code &lt; y.soortVermogenscomponent.code )

// Motorvoertuigen (6)</text>
    </literalExpression>
  </decision>
  <decision id="overigZonderVrijlating" name="overigZonderVrijlating">
    <variable id="InformationItem_0hbwgnf" name="overigZonderVrijlating" typeRef="Any" />
    <informationRequirement id="InformationRequirement_1nej78m">
      <requiredDecision href="#overigMetVrijlating" />
    </informationRequirement>
    <literalExpression id="LiteralExpression_0axnxg9">
      <text>//pak eerst alle componenten waarvan soortVermogenscomponent.code niet in [1, 3, 6, 12, 14, 15, 17] zit,
//sorteer ze per soortVermogenscomponent.code oplopend en binnen hetzelfde type op waarde aflopend, en plak daar vervolgens alles vanaf het 2e element van overigMetVrijlating achteraan

concatenate
(
   sort(list: vermogensComponenten[ not( list contains( ["1", "3", "6", "12", "14", "15", "17"], soortVermogenscomponent.code ) ) ], precedes: function(x,y) if x.soortVermogenscomponent.code = y.soortVermogenscomponent.code then x.waarde &gt; y.waarde else x.soortVermogenscomponent.code &lt; y.soortVermogenscomponent.code ),
   sublist( overigMetVrijlating, 2 )
)

// Eigen woning (huis/woonschip/woonwagen in eigendom) (1)
// Bank-/Girorekening (3)
// Motorvoertuigen (6)
// Schulden (12)
// Schulden uitgezonderd studieschuld (12)
// Studieschuld (14)
// Levensverzekering/belegging gekoppeld aan hypotheek (15)
// Hypotheek eigen woning (17)

// Contanten (2)
// Overig onroerend goed (4)
// Waardepapieren (5)
// Caravans (7)
// Antiek/sieraden (8)
// Overige bezittingen (9)
// Aandeel onverdeelde boedel (10)
// Leningen aan derden (11)
// Levensverzekering (13)
// Levensverzekering/belegging niet gekoppeld aan hypotheek (13)
// Beleggingsproduct (Aandeel, Lease, Effect, Obligatie, e.d.) (16)
// Aanspraak op erfenis binnen zes maanden (18)
// Digitale valuta (cryptomunten) (19)</text>
    </literalExpression>
  </decision>
  <decision id="eigenWoning" name="eigenWoning">
    <variable id="InformationItem_1xn3d8y" name="eigenWoning" typeRef="Any" />
    <literalExpression id="LiteralExpression_0hujgs5">
      <text>// pak alle componenten waarvan soortVermogenscomponent.code 1, 15 of 17 is.

vermogensComponenten[ list contains( ["1", "15", "17"], soortVermogenscomponent.code ) ]

// Eigen woning (huis/woonschip/woonwagen in eigendom) (1)
// Levensverzekering/belegging gekoppeld aan hypotheek (15)
// Hypotheek eigen woning (17)</text>
    </literalExpression>
  </decision>
  <decision id="schulden" name="schulden">
    <variable id="InformationItem_04pg0ns" name="schulden" typeRef="Any" />
    <literalExpression id="LiteralExpression_1m0fule">
      <text>// pak alle componenten met soortVermogenscomponent.code = 12 en sorteer ze van hoogste naar laagste waarde.

sort(list: vermogensComponenten[ soortVermogenscomponent.code = "12" ], precedes: function(x,y) if x.soortVermogenscomponent.code = y.soortVermogenscomponent.code then x.waarde &gt; y.waarde else x.soortVermogenscomponent.code &lt; y.soortVermogenscomponent.code )



// Schulden (12)
// Schulden uitgezonderd studieschuld (12)</text>
    </literalExpression>
  </decision>
