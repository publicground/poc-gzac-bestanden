  <decision id="bs-217-verblijfadres-conform-brp" name="Vergelijken opgegeven verblijfadres met adres in BRP">
    <informationRequirement id="InformationRequirement_0kqikxz">
      <requiredInput href="#InputData_0ibjphg" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_1au4v5p">
      <requiredInput href="#InputData_1455oqb" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0rj3rhz">
      <requiredInput href="#InputData_1whymi1" />
    </informationRequirement>
    <decisionTable id="DecisionTable_06prboa" hitPolicy="FIRST" biodi:annotationsWidth="474">
      <input id="InputClause_0mtjs9v" label="Handmatig vaststellen" biodi:width="150">
        <inputExpression id="LiteralExpression_0y5e6ws" typeRef="boolean">
          <text>handmatigVaststellen</text>
        </inputExpression>
      </input>
      <input id="InputClause_0nk8unt" label="Postcode gelijk" biodi:width="150">
        <inputExpression id="LiteralExpression_19a16y9" typeRef="boolean">
          <text>upper case(replace(brpWoonadres.postcode, " ", "")) = upper case(replace(verblijfadres.postcode, " ", ""))</text>
        </inputExpression>
      </input>
      <input id="InputClause_1sisqbw" label="Huisnummer, huisletter en huisnummertoevoeging gelijk" biodi:width="150">
        <inputExpression id="LiteralExpression_1k0lcd5" typeRef="boolean">
          <text>upper case(replace(
  string(if get value(brpWoonadres, "huisnummer") = null then "" else get value(brpWoonadres, "huisnummer"))
  + (if get value(brpWoonadres, "huisletter") != null and string(get value(brpWoonadres, "huisletter")) != "" then string(get value(brpWoonadres, "huisletter")) else "")
  + (if get value(brpWoonadres, "huisnummertoevoeging") != null and string(get value(brpWoonadres, "huisnummertoevoeging")) != "" then string(get value(brpWoonadres, "huisnummertoevoeging")) else "")
, " ", ""))
=
upper case(replace(
  string(if get value(verblijfadres, "huisnummer") = null then "" else get value(verblijfadres, "huisnummer"))
  + (if get value(verblijfadres, "huisletter") != null and string(get value(verblijfadres, "huisletter")) != "" then string(get value(verblijfadres, "huisletter")) else "")
  + (if get value(verblijfadres, "huisnummertoevoeging") != null and string(get value(verblijfadres, "huisnummertoevoeging")) != "" then string(get value(verblijfadres, "huisnummertoevoeging")) else "")
, " ", ""))</text>
        </inputExpression>
      </input>
      <output id="OutputClause_0hmatu3" label="Handmatig vaststellen" name="handmatigVaststellen" typeRef="boolean" biodi:width="150" />
      <output id="OutputClause_1lvibt5" label="Opgegeven verblijfadres conform BRP" name="opgegevenVerblijfadresConformBrp" typeRef="boolean" biodi:width="150" />
      <rule id="DecisionRule_0oslsky">
        <description>Consulent heeft handmatig het vaststellen van het verblijfadres gestart</description>
        <inputEntry id="UnaryTests_1fwoesa">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1t6l7gc">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0y1l22x">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1lfutkg">
          <text>true</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0rvu21b">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1gajxnu">
        <description>Opgegeven verblijfadres komt overeen met het BRP woonadres</description>
        <inputEntry id="UnaryTests_0i7jg11">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_16n3tcn">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_176mf8v">
          <text>true</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0mex46y">
          <text>false</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0snzjxj">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1k27egn">
        <description>Opgeveven verblijfadres komt niet overeen met het BRP woonadres</description>
        <inputEntry id="UnaryTests_1ev6jnt">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1q6y7tr">
          <text></text>
        </inputEntry>
