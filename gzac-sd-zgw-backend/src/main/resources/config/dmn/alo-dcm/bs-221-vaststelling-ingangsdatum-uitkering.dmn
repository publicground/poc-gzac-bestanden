    <decisionTable id="DecisionTable_06g3asw" hitPolicy="FIRST">
      <input id="InputClause_1d4oje4" label="aanvraagDatum" biodi:width="221" camunda:inputVariable="aanvraagDatum">
        <inputExpression id="LiteralExpression_1f46xun" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <output id="OutputClause_1vbyo82" label="Ingangsdatum op basis van het proces" name="ingangsDatumOpBasisVanProces" typeRef="string" biodi:width="310" />
      <rule id="DecisionRule_0xutojj">
        <description>7 dagen = redelijk termijn om de aanvraag te doen</description>
        <inputEntry id="UnaryTests_1ahdguk">
          <text>date(aanvraagDatum) &lt;= ( date(meldingsDatum) + @"P7D" )</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_132f9z2">
          <text>meldingsDatum</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1t431g0">
        <description>Melddatum niet aanwezig of ligt meer dan 7 dagen voor de aanvraagdatum</description>
