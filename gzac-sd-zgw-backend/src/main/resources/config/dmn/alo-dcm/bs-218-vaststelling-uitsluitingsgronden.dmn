  <decision id="bs-218-RijksbekostigdOnderwijs" name="Rijksbekostigd onderwijs">
    <informationRequirement id="InformationRequirement_1xuemvm">
      <requiredDecision href="#bs-218-betrokkenen-en-bronnen" />
    </informationRequirement>
    <decisionTable id="DecisionTable_176q66p" hitPolicy="FIRST">
      <input id="InputClause_0l3inma" label="Volgt onderwijs" biodi:width="192">
        <inputExpression id="LiteralExpression_0kozsj7" typeRef="boolean">
          <text>some oo in duo.opleiding.onderwijsOvereenkomst satisfies
get or else(
  date(substring(oo.datUitschrijvingOpleiding,1,4) + "-" + substring(oo.datUitschrijvingOpleiding,5,2) + "-" + substring(oo.datUitschrijvingOpleiding,7,2)) &gt; date( ingangsdatum ) and
  date(substring(oo.datInschrijvingOpleiding,1,4) + "-" + substring(oo.datInschrijvingOpleiding,5,2) + "-" + substring(oo.datInschrijvingOpleiding,7,2)) &lt; date( ingangsdatum )
  , false)</text>
        </inputExpression>
      </input>
      <output id="OutputClause_00fmqc7" name="rboUitsluiting" typeRef="string" biodi:width="228" />
      <output id="OutputClause_07r2m1s" name="rboVerantwoording" typeRef="string" biodi:width="279" />
      <output id="OutputClause_0muhmk7" name="rboSignalering" typeRef="string" />
