  <decision id="bs-218-ingangsdatum" name="ingangsdatum">
    <variable id="InformationItem_1m91yy0" name="ingangsdatum" />
    <literalExpression id="LiteralExpression_0au545m">
      <text>date ( date and time( if gegevensVaststelling.bs221ingangsdatum.ingangsdatum != null then gegevensVaststelling.bs221ingangsdatum.ingangsdatum else ( if gegevensVaststelling.startDatum  != null  then gegevensVaststelling.startDatum  else  gegevensVanuitAanvraag.startDatum) ) )

// ingangsdatum indien die is vastgesteld
// startdatum
</text>
    </literalExpression>
  </decision>
