        <inputEntry id="UnaryTests_1tise80">
          <text>true</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0e9269v">
          <text>"Uitsluiting"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1xj4sbn">
          <text>"Student"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0worv6a">
          <text>true</text>
        </outputEntry>
