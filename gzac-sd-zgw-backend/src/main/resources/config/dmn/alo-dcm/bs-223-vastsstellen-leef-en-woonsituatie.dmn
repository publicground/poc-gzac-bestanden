    <decisionTable id="DecisionTable_00rbleo" hitPolicy="FIRST" biodi:annotationsWidth="416">
      <input id="InputClause_0au226w" label="Partner aanwezig?" camunda:inputVariable="partnerAanwezig">
        <inputExpression id="LiteralExpression_0xqnwkq" typeRef="boolean" />
      </input>
      <input id="InputClause_1881wpb" label="Partner verblijft op hetzelfde verblijfadres als aanvrager?" biodi:width="242">
        <inputExpression id="LiteralExpression_1eni3nd" typeRef="boolean">
          <text>verblijfadresAanvrager != null and verblijfadresPartner != null and
verblijfadresAanvrager.postcode = verblijfadresPartner.postcode and
verblijfadresAanvrager.huisnummer = verblijfadresPartner.huisnummer and
verblijfadresAanvrager.straatnaam = verblijfadresPartner.straatnaam and
verblijfadresAanvrager.woonplaatsnaam = verblijfadresPartner.woonplaatsnaam and
verblijfadresAanvrager.huisletter = verblijfadresPartner.huisletter</text>
        </inputExpression>
      </input>
      <input id="InputClause_09la89n" label="verblijfadres aanvrager = instelling" camunda:inputVariable="verblijfadresAanvragerIsInstelling">
        <inputExpression id="LiteralExpression_01qdtq7" typeRef="boolean">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_05h35sj" label="verblijfadres partner = instelling" camunda:inputVariable="verblijfadresPartnerIsInstelling">
        <inputExpression id="LiteralExpression_1m6057h" typeRef="boolean">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_08xwstp" label="Woonsituatie volgens aanvraag = &#34;Zorginstelling&#34; of &#34;Maatschappelijke opvang&#34;" biodi:width="261">
        <inputExpression id="LiteralExpression_044qufa" typeRef="boolean">
          <text>woonsituatieVolgensAanvraag = "ZORGINSTELLING" or woonsituatieVolgensAanvraag = "MAATSCHAPPELIJKE_OPVANG"</text>
        </inputExpression>
      </input>
      <input id="InputClause_0wkgua8" label="Handmatig vaststellen?" camunda:inputVariable="handmatigVaststellen">
