  <decision id="bs-219-bepaal-kostendelersnorm" name="Bepaal basiskostendelersnorm">
    <informationRequirement id="InformationRequirement_1wfc3la">
      <requiredInput href="#InputData_1ccjms6" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_19wx290">
      <requiredInput href="#InputData_1i4dkji" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_04enzqu">
      <requiredInput href="#InputData_09ru3kw" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0m2s6tk">
      <requiredInput href="#InputData_0aglktg" />
    </informationRequirement>
    <decisionTable id="DecisionTable_0agvbnn" hitPolicy="FIRST">
      <input id="InputClause_0r0odio" label="Leeftijd Jongste belanghebbende &#60; 21" biodi:width="192" camunda:inputVariable="leeftijdJongsteBelanghebbende">
        <inputExpression id="LiteralExpression_0y9nrlk" typeRef="boolean">
          <text>abs(date(leeftijdJongsteBelanghebbende).year - now().year) &lt; 21</text>
        </inputExpression>
      </input>
      <input id="InputClause_1rb8bze" label="Aantal belanghebbende" camunda:inputVariable="aantalBelanghebbende">
        <inputExpression id="LiteralExpression_13nch01" typeRef="integer">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_12rnppl" label="Leeftijd oudste belanghebbende &#62; 21" camunda:inputVariable="leeftijdOudsteBelanghebbende">
        <inputExpression id="LiteralExpression_12wrtk8" typeRef="boolean">
          <text>abs(date(leeftijdOudsteBelanghebbende).year - now().year) &gt;= 21</text>
        </inputExpression>
      </input>
      <input id="InputClause_096ndd3" label="Ten laste komende kinderen?" camunda:inputVariable="tenlasteKomendeKinderen">
        <inputExpression id="LiteralExpression_05boycx" typeRef="string">
          <text>tenlasteKomendeKinderen</text>
        </inputExpression>
      </input>
      <output id="OutputClause_1wmf1ak" label="Basiskostendelersnorm (indiviueel)" name="vastgesteldeBasisnorm" typeRef="string" biodi:width="350" />
      <rule id="DecisionRule_14xo3rj">
        <description>Als 1 van beide belanghebbende jonger is dan 21 en de ander niet en er zijn ten laste komende kinderen, dan is artikel 22a.3a van toepassing</description>
        <inputEntry id="UnaryTests_0fcawf8">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0g7zsb7">
          <text>2</text>
        </inputEntry>
        <inputEntry id="UnaryTests_14xckkx">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_17sfx5n">
          <text>"JA"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_15842cx">
          <text>"samenwonende-waarvan-1-jongere-met-kinderen-norm"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_05f7n8v">
        <description>Als 1 van beide belanghebbende jonger is dan 21 en de ander niet en er zijn geen ten laste komende kinderen, dan is artikel 22a.3b van toepassing</description>
        <inputEntry id="UnaryTests_0z5zcnv">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_139wcox">
          <text>2</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1fy36bc">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_03beztg">
          <text>"NEE"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0lcrho0">
          <text>"samenwonende-waarvan-1-jongere-zonder-kinderen-norm"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1ljib2g">
        <description></description>
        <inputEntry id="UnaryTests_0f76xyi">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1lcy4bl">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1xbhiew">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_07he94t">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1yfth6z">
          <text>"samenwonende-norm"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
