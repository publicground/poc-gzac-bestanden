  <decision id="bs-219-bepaal-kostendelersfactor" name="Bepaal Kostendelersfactor">
    <informationRequirement id="InformationRequirement_0nltx7y">
      <requiredInput href="#InputData_1vsf5j1" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_05zsefe">
      <requiredInput href="#InputData_1hgti92" />
    </informationRequirement>
    <informationRequirement id="InformationRequirement_1eqgplv">
      <requiredInput href="#InputData_0li1m4a" />
    </informationRequirement>
    <decisionTable id="DecisionTable_1p4f3s0" hitPolicy="FIRST">
      <input id="InputClause_1chlppx" label="Persoon &#60; 21 jaar" camunda:inputVariable="geboortedatum">
        <inputExpression id="LiteralExpression_1opuc8h" typeRef="boolean">
          <text>abs(date(geboortedatum).year - now().year) &lt; 21</text>
        </inputExpression>
      </input>
      <input id="InputClause_1uibe4h" label="Vastgestelde Leefsituatie" camunda:inputVariable="vastgesteldeLeefsituatie">
        <inputExpression id="LiteralExpression_0qil60z" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <output id="OutputClause_04jssic" label="Kostendelersfactor" name="kostendelersfactor" typeRef="double" biodi:width="446" />
      <rule id="DecisionRule_06au6qe">
        <inputEntry id="UnaryTests_159mh6r">
          <text>true</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1r7fx23">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0cxhnv3">
          <text>1</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1ka1d9v">
        <inputEntry id="UnaryTests_1qtyism">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1ff23me">
          <text>"ALLEENSTAAND", "ALLEENSTAANDE_OUDER"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0x4ig88">
          <text>(0.4 + (1 + aantalKostendelers) * 0.3) / (1 + aantalKostendelers)</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_12ho5lq">
        <inputEntry id="UnaryTests_155bqlg">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0p40caa">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1qradmu">
          <text>(0.4 + (2 + aantalKostendelers) * 0.3) / (2 + aantalKostendelers)</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
