    <bpmn:serviceTask id="OphalenDuoStudiefinancieringInfoTask" name="ophalen duo studiefinanciering informatie" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">var raw = execution.getVariable('duoStudiefinancieringInfoRaw');
var dynProps = raw != null &amp;&amp; raw.dynamicProperties != null ? raw.dynamicProperties : null;

function toJavaValue(value) {
    if (value == null) return null;

    var valueType = typeof value;

    if (valueType === 'string') return String(value);
    if (valueType === 'number') return Number(value);
    if (valueType === 'boolean') return value;

    if (Array.isArray(value)) {
        return toJavaList(value);
    }

    if (valueType === 'object') {
        return toJavaMap(value);
    }

    return String(value);
}

function toJavaMap(obj) {
    var map = new Packages.java.util.LinkedHashMap();

    for (var key in obj) {
        if (Object.prototype.hasOwnProperty.call(obj, key)) {
            map.put(String(key), toJavaValue(obj[key]));
        }
    }

    return map;
}

function toJavaList(arr) {
    var list = new Packages.java.util.ArrayList();

    for (var i = 0; i &lt; arr.length; i++) {
        list.add(toJavaValue(arr[i]));
    }

    return list;
}

function normalizeDuoDate(value) {
    if (value == null) return '';
    return String(value).replace(/-/g, '');
}

function mapDuoStudiefinanciering(i) {
    if (!i) return null;

    return {
        indicatieToekenningWtosVo18: i.indToekenningWtosVo18 != null ? String(i.indToekenningWtosVo18) : '',
        codeStatusPartnertoeslagStufi: i.cdStatusPartnertoeslagStufi != null ? String(i.cdStatusPartnertoeslagStufi) : '',
        codeToekenningBasisbeursStufi: i.cdToekenningBasisbeursStufi != null ? String(i.cdToekenningBasisbeursStufi) : '',
        codeStatusEenOudertoeslagStufi: i.cdStatusEenOudertoeslagStufi != null ? String(i.cdStatusEenOudertoeslagStufi) : '',
        indicatieAanvullendeBeursStufi: i.indAanvullendeBeursStufi != null ? String(i.indAanvullendeBeursStufi) : '',
        dateEindToekenningsperiodeStufi: normalizeDuoDate(i.datEToekenningsperiodeStufi),
        dateBeginToekenningsperiodeStufi: normalizeDuoDate(i.datBToekenningsperiodeStufi)
    };
}

function convertToDuoStudiefinancieringen(data) {
    var studiefinancieringen = [];

    if (data &amp;&amp; data.studiefinanciering &amp;&amp; data.studiefinanciering.length &gt; 0) {
        studiefinancieringen = data.studiefinanciering.map(function(i) {
            return mapDuoStudiefinanciering(i);
        });
    }

    return {
        burgerservicenummer: data &amp;&amp; data.burgerservicenr != null ? String(data.burgerservicenr) : '',
        studiefinancieringen: studiefinancieringen
    };
}

var result = convertToDuoStudiefinancieringen(dynProps);
if (result != null) {
    execution.setVariable('duoStudiefinancieringInfo', toJavaValue(result));
}</camunda:script>
        </camunda:executionListener>
