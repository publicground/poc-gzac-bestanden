    <bpmn:serviceTask id="OphalenRDWVoertuigenTask" name="Ophalen RDW  voertuigen" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">var raw = execution.getVariable('rdwVoertuigenRaw');
var dynProps = raw != null &amp;&amp; raw.dynamicProperties != null ? raw.dynamicProperties : null;

function toJavaValue(value) {
    if (value == null) return null;

    var valueType = typeof value;

    if (valueType === 'string') return String(value);
    if (valueType === 'number') return Number(value);
    if (valueType === 'boolean') return value;

    if (Array.isArray(value)) {
        return toJavaList(value);
    }

    if (valueType === 'object') {
        return toJavaMap(value);
    }

    return String(value);
}

function toJavaMap(obj) {
    var map = new Packages.java.util.LinkedHashMap();

    for (var key in obj) {
        if (Object.prototype.hasOwnProperty.call(obj, key)) {
            map.put(String(key), toJavaValue(obj[key]));
        }
    }

    return map;
}

function toJavaList(arr) {
    var list = new Packages.java.util.ArrayList();

    for (var i = 0; i &lt; arr.length; i++) {
        list.add(toJavaValue(arr[i]));
    }

    return list;
}


var SOORT_VOERTUIG = {
    'A': { code: 'A', name: 'Aanhangwagen' },
    'B': { code: 'B', name: 'Bedrijfsauto' },
    'C': { code: 'C', name: 'Bromfiets' },
    'D': { code: 'D', name: 'Driewielig motorrijtuig' },
    'M': { code: 'M', name: 'Motorfiets' },
    'P': { code: 'P', name: 'Personenauto' },
    'O': { code: 'O', name: 'Onbekend' }
};

function mapSoortVoertuig(code) {
    if (code == null) return null;

    var key = String(code);

    if (SOORT_VOERTUIG.hasOwnProperty(key)) {
        return SOORT_VOERTUIG[key];
    }

    return null;
}

function mapMotorvoertuig(aansprakelijke) {
    var voertuig = aansprakelijke &amp;&amp; aansprakelijke.voertuig ? aansprakelijke.voertuig : null;

    return {
        kenteken: voertuig &amp;&amp; voertuig.kentekenVoertuig != null ? String(voertuig.kentekenVoertuig) : '',
        datumEersteInschrijving: voertuig &amp;&amp; voertuig.datEersteInschrijvingVoertuigNat != null
            ? String(voertuig.datEersteInschrijvingVoertuigNat)
            : '',
        datumRegistratieAansprakelijkheid: aansprakelijke &amp;&amp; aansprakelijke.datRegistratieAansprakelijkheid != null
            ? String(aansprakelijke.datRegistratieAansprakelijkheid)
            : '',
        soortMotorvoertuig: mapSoortVoertuig(voertuig &amp;&amp; voertuig.cdSrtVoertuig != null ? voertuig.cdSrtVoertuig : null),
        merk: voertuig &amp;&amp; voertuig.merkVoertuig != null ? String(voertuig.merkVoertuig) : '',
        model: voertuig &amp;&amp; voertuig.typeVoertuig != null ? String(voertuig.typeVoertuig) : ''
    };
}

function convertToMotorvoertuigenDto(data) {
    var aansprakelijken = [];

    if (data &amp;&amp; data.aansprakelijken &amp;&amp; data.aansprakelijken.length &gt; 0) {
        aansprakelijken = data.aansprakelijken;
    } else if (data &amp;&amp; data.aansprakelijke) {
        aansprakelijken = [data.aansprakelijke];
    }

    return {
        motorvoertuigen: aansprakelijken.map(function(aansprakelijke) {
            return mapMotorvoertuig(aansprakelijke);
        })
    };
}

var result = convertToMotorvoertuigenDto(dynProps);
if (result != null) {
  execution.setVariable('rdwVoertuigen', toJavaValue(result));
}</camunda:script>
        </camunda:executionListener>
