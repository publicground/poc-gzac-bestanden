      <bpmn:incoming>Flow_1yu1hho</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="OphalenSVBUitkeringenTask" name="ophalen SVB uitkeringen" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">//constants
var CODES_UITKERINGSPERIODE = {
  '0': 'Niet van toepassing', '1': 'Dag', '2': 'Week',
  '3': '2 weken', '4': '4 weken (13 maanden)', '5': '5 weken',
  '6': 'Maand', '7': 'Kwartaal', '8': 'Jaar', '9': 'Eenmalig'
};

// common functions
function toJavaValue(value) {
    if (value == null) return null;

    var valueType = typeof value;

    if (valueType === 'string') return String(value);
    if (valueType === 'number') return Number(value);
    if (valueType === 'boolean') return value;

    if (Array.isArray(value)) {
        return toJavaList(value);
    }

    if (valueType === 'object') {
        return toJavaMap(value);
    }

    return String(value);
}

function toJavaMap(obj) {
    var map = new Packages.java.util.LinkedHashMap();

    for (var key in obj) {
        if (Object.prototype.hasOwnProperty.call(obj, key)) {
            map.put(String(key), toJavaValue(obj[key]));
        }
    }

    return map;
}

function toJavaList(arr) {
    var list = new Packages.java.util.ArrayList();

    for (var i = 0; i &lt; arr.length; i++) {
        list.add(toJavaValue(arr[i]));
    }

    return list;
}

function mapAdres(adres) {
    if (!adres) return null;
    return {
        straatnaam: adres.straatnaam != null ? String(adres.straatnaam) : '',
        huisnummer: adres.huisnr != null ? Number(adres.huisnr) : 0,
        huisletter: adres.huisletter != null ? String(adres.huisletter) : '',
        huisnummertoevoeging: adres.huisnrtoevoeging != null ? String(adres.huisnrtoevoeging) : '',
        postcode: adres.postcd != null ? String(adres.postcd) : '',
        woonplaatsnaam: adres.woonplaatsnaam != null ? String(adres.woonplaatsnaam) : '',
        aanduidingBijHuisnummer: adres.aanduidingBijHuisnr != null ? String(adres.aanduidingBijHuisnr) : '',
        locatieomschrijving: adres.locatieoms != null ? String(adres.locatieoms) : ''
    };
}

function firstOf(list) {
    if (list == null || sizeOf(list) === 0) return null;
    return getAt(list, 0);
}
function sumWaardeBedr(list) {
    var total = 0;
    for (var i = 0; i &lt; list.size(); i++) {
        var item = list.get(i);
        var waarde = item != null &amp;&amp; item.waardeBedr != null ? Number(item.waardeBedr) : 0;
        total += waarde;
    }
    return total;
}

//convert function
function convertToSvbUitkeringenDto(dynProps) {
  print('convertToSvbUitkeringenDto');
  print(dynProps)


  if (dynProps == null || dynProps.uitkeringsverhouding == null) return null;
  var uitkeringen = [];
  for (var i = 0; i &lt; dynProps.uitkeringsverhouding.size(); i++) {
    var verhouding = dynProps.uitkeringsverhouding.get(i);
    var szWetCode = verhouding.szWet != null ? String(verhouding.szWet.cdSzWet) : '';
    var periodes = [];
    if (verhouding.uitkeringsperiode != null) {
      for (var j = 0; j &lt; verhouding.uitkeringsperiode.size(); j++) {
        var periode = verhouding.uitkeringsperiode.get(j);

print('periode');        
print(periode);

        var bruto = periode.brutoUitkeringsbedr[0];
        var netto = periode.nettoUitkeringsbedr;

        var cdPeriode = bruto != null &amp;&amp; bruto.cdUitkeringsperiode != null
          ? String(bruto.cdUitkeringsperiode) : null;
        periodes.push({
          brutoBedrag: sumWaardeBedr(periode.brutoUitkeringsbedr),
          nettoBedrag: sumWaardeBedr(periode.nettoUitkeringsbedr),
          datumAanvangUitkeringsperiode: String(periode.datBUitkeringsperiode || ''),
          datumEindUitkeringsperiode: String(periode.datEUitkeringsperiode || ''),
          codeUitkeringsperiode: cdPeriode != null
            ? { code: cdPeriode, name: CODES_UITKERINGSPERIODE[cdPeriode] || '' }
            : null,
          codeMunteenheid: bruto != null ? String(bruto.cdMunteenheid) : '',
          codeSzWet: szWetCode
        });
      }
    }
    uitkeringen.push({
      codeSzWet: szWetCode,
      datumBeginUitkeringsverhouding: String(verhouding.datBUitkeringsverhouding || ''),
      datumEindUitkeringsverhouding: String(verhouding.datEUitkeringsverhouding || ''),
      periodes: periodes
    });
  }
  return { svbUitkeringen: uitkeringen };
}


// process script
var raw = execution.getVariable('svbUitkeringenRaw');
var dynProps = (raw != null ? raw.dynamicProperties : null);
var result = convertToSvbUitkeringenDto(dynProps);
if (result != null) {
  execution.setVariable('svbUitkeringen', toJavaValue(result));
}</camunda:script>
        </camunda:executionListener>
