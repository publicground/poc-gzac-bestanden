  <bpmn:collaboration id="Collaboration_1gmd3lc">
    <bpmn:participant id="GenericOphalenSVBUitkeringenParticipant" name="Generic: Suwinet ophalen SVB Uitkeringen" processRef="generic-suwinet-ophalen-svb-uitkeringen" />
