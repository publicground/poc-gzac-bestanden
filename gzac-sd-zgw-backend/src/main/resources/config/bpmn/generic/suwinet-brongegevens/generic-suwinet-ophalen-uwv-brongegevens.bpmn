function mapCodeFromTable(table, code) {
    if (code == null) {
        return table.hasOwnProperty('-1') ? table['-1'] : null;
    }

    var key = String(code);

    if (table.hasOwnProperty(key)) {
        return table[key];
    }

    if (table.hasOwnProperty('')) {
        return {
            code: key,
            name: table[''].name,
            type: table[''].type
        };
    }

    return {
        code: key,
        name: 'not found'
    };
}

function getAdministratieveEenheid(inkomstenverhouding) {
    return inkomstenverhouding &amp;&amp; inkomstenverhouding.administratieveEenheid
        ? inkomstenverhouding.administratieveEenheid
        : null;
}

function getFeitelijkAdres(inkomstenverhouding) {
    var administratieveEenheid = getAdministratieveEenheid(inkomstenverhouding);

    if (
        !administratieveEenheid ||
        !administratieveEenheid.feitelijkAdresAeh ||
        !administratieveEenheid.feitelijkAdresAeh.length
    ) {
        return null;
    }

    var eersteAdres = administratieveEenheid.feitelijkAdresAeh[0];
    return eersteAdres &amp;&amp; eersteAdres.straatadres ? eersteAdres.straatadres : null;
}

function getNaamRechtspersoon(inkomstenverhouding) {
    var administratieveEenheid = getAdministratieveEenheid(inkomstenverhouding);

    if (
        !administratieveEenheid ||
        !administratieveEenheid.rechtspersoonAdministratieveEenh
    ) {
        return null;
    }

    var rechtspersoon = administratieveEenheid.rechtspersoonAdministratieveEenh;
    return rechtspersoon.naamRechtspersoon != null ? String(rechtspersoon.naamRechtspersoon) : null;
}

function getLoonheffingennummer(inkomstenverhouding) {
    var administratieveEenheid = getAdministratieveEenheid(inkomstenverhouding);
    return administratieveEenheid &amp;&amp; administratieveEenheid.loonheffingennr != null
        ? String(administratieveEenheid.loonheffingennr)
        : null;
}

function toDate(value) {
    if (value == null || value === '') return null;
    return new Date(String(value) + 'T00:00:00');
}

function getInkomstenPeriodes(inkomstenverhouding) {
    if (
        !inkomstenverhouding ||
        !inkomstenverhouding.inkomstenperiode ||
        !inkomstenverhouding.inkomstenperiode.length
    ) {
        return [];
    }

    return inkomstenverhouding.inkomstenperiode.map(function(periode) {
        return {
            datumAanvangPeriode: toDate(periode.datBIkp),
            datumEindPeriode: toDate(periode.datEIkp),
            codeSoortIkv: periode.cdSrtIkv != null ? String(periode.cdSrtIkv) : null,
            codeSoortArbeidscontract: periode.cdTypeArbeidscontract != null ? String(periode.cdTypeArbeidscontract) : '-1',
            codeAardIkv: periode.cdAardIkv != null ? String(periode.cdAardIkv) : '-1',
            indLoonheffingskortingToegepast: periode.indLoonheffingskortingToegepast != null ? String(periode.indLoonheffingskortingToegepast) : '-1',
            indRegelmatigArbeidspatroon: periode.indRegelmatigArbeidspatroon != null ? String(periode.indRegelmatigArbeidspatroon) : '-1',
            indLoonIsMedeAowAlleenstaande: periode.indLoonIsMedeAowAlleenstaande != null ? String(periode.indLoonIsMedeAowAlleenstaande) : '-1',
            indLoonInclusiefWajongUitkering: periode.indLoonInclusiefWajongUitkering != null ? String(periode.indLoonInclusiefWajongUitkering) : '-1'
        };
    });
}

function getMatchingPeriod(inkomstenPeriodes, datBIko, datEIko) {
    var start = toDate(datBIko);
    var end = toDate(datEIko);

    for (var i = 0; i &lt; inkomstenPeriodes.length; i++) {
        var periode = inkomstenPeriodes[i];

        if (!periode.datumAanvangPeriode || !periode.datumEindPeriode || !start || !end) {
            continue;
        }

        if (periode.datumAanvangPeriode &lt;= start &amp;&amp; periode.datumEindPeriode &gt;= end) {
            return periode;
        }
    }

    return null;
}

function selectMaxPeriods(periods, maxPeriods) {
    if (!maxPeriods || maxPeriods &lt; 1 || !periods || periods.length &lt;= maxPeriods) {
        return periods || [];
    }

    return periods.slice(periods.length - maxPeriods);
}

function mapUwvOpgave(opgave, inkomstenPeriodes, naamRechtspersoon) {
    if (!opgave) return null;

    var result = {
        codeAardIkv: null,
        codeSoortIkv: null,
        codeSoortArbeidscontract: null,
        indLoonheffingskortingToegepast: null,
        indRegelmatigArbeidspatroon: null,
        indLoonIsMedeAowAlleenstaande: null,
        indLoonInclusiefWajongUitkering: null,

        datumAanvangOpgave: opgave.datBIko != null ? String(opgave.datBIko) : '',
        datumEindOpgave: opgave.datEIko != null ? String(opgave.datEIko) : '',

        aantalSvDagen: opgave.aantSvDagenIko != null ? Number(opgave.aantSvDagenIko) : 0,
        aantalVerloondeUren: opgave.aantVerloondeUrenIko != null ? Number(opgave.aantVerloondeUrenIko) : 0,

        extraPrdSalaris: mapMoneyValue(opgave.bedrExtraPrdSalaris),
        vakantietoeslag: mapMoneyValue(opgave.bedrVakantietoeslag),
        opgbRechtVakantietoeslag: mapMoneyValue(opgave.bedrOpgbRechtVakantietoeslag),
        opgbRechtExtraPrdSalaris: mapMoneyValue(opgave.bedrOpgbRechtExtraPrdSalaris),

        brutoSocialeVerzekeringsLoon: mapMoneyValue(opgave.bedrBrutoloonSv),
        loonLbPremieVolksverzekering: mapMoneyValue(opgave.bedrLoonLbPremieVolksverz),
        vergoedingReiskostenOnbelast: mapMoneyValue(opgave.bedrVergoedingReiskostenOnbelast),
        ingehoudenLbPremieVolksverzekering: mapMoneyValue(opgave.bedrIngehoudenLbPremieVolksverz),

        naamRechtspersoon: naamRechtspersoon != null ? naamRechtspersoon : ''
    };

    var period = getMatchingPeriod(
        inkomstenPeriodes,
        result.datumAanvangOpgave,
        result.datumEindOpgave
    );

    if (period) {
        result.codeAardIkv = mapCodeFromTable(CODES_AARD_ARBEIDSVERHOUDING, period.codeAardIkv);
        result.codeSoortIkv = mapCodeFromTable(CODES_SOORT_IKV, period.codeSoortIkv);
        result.codeSoortArbeidscontract = mapCodeFromTable(CODES_TYPE_ARBEIDSCONTRACT, period.codeSoortArbeidscontract);
        result.indLoonheffingskortingToegepast = mapCodeFromTable(CODES_JA_NEE, period.indLoonheffingskortingToegepast);
        result.indRegelmatigArbeidspatroon = mapCodeFromTable(CODES_JA_NEE, period.indRegelmatigArbeidspatroon);
        result.indLoonIsMedeAowAlleenstaande = mapCodeFromTable(CODES_JA_NEE, period.indLoonIsMedeAowAlleenstaande);
        result.indLoonInclusiefWajongUitkering = mapCodeFromTable(CODES_JA_NEE, period.indLoonInclusiefWajongUitkering);
    }

    return result;
}

function getSoortIkvType(inkomstenverhouding) {
    var inkomstenPeriodes = getInkomstenPeriodes(inkomstenverhouding);

    for (var i = 0; i &lt; inkomstenPeriodes.length; i++) {
        var period = inkomstenPeriodes[i];
        var mapped = mapCodeFromTable(CODES_SOORT_IKV, period.codeSoortIkv);

        if (mapped &amp;&amp; mapped.type) {
            return mapped.type;
        }
    }

    return 'ONBEKEND';
}

function mapUwvInkomsten(inkomstenverhouding, maxPeriods) {
    if (!inkomstenverhouding) return null;

    var inkomstenPeriodes = getInkomstenPeriodes(inkomstenverhouding);
    var naamRechtspersoon = getNaamRechtspersoon(inkomstenverhouding);
    var loonheffingennummer = getLoonheffingennummer(inkomstenverhouding);

    var opgaven = [];
    if (inkomstenverhouding.inkomstenopgave &amp;&amp; inkomstenverhouding.inkomstenopgave.length &gt; 0) {
        opgaven = inkomstenverhouding.inkomstenopgave.map(function(opgave) {
            return mapUwvOpgave(opgave, inkomstenPeriodes, naamRechtspersoon);
        });
    }

    var sector = null;
    if (
        inkomstenverhouding.sectorRisicogroepIkv &amp;&amp;
        inkomstenverhouding.sectorRisicogroepIkv.length &gt; 0 &amp;&amp;
        inkomstenverhouding.sectorRisicogroepIkv[0].sectorBeroepsEnBedrijfsleven &amp;&amp;
        inkomstenverhouding.sectorRisicogroepIkv[0].sectorBeroepsEnBedrijfsleven.cdSector != null
    ) {
        sector = String(inkomstenverhouding.sectorRisicogroepIkv[0].sectorBeroepsEnBedrijfsleven.cdSector);
    }

    return {
        werkgever: naamRechtspersoon != null ? naamRechtspersoon : '',
        loonheffingennummer: loonheffingennummer != null ? loonheffingennummer : '',
        cdSector: sector,
        datumBeginIkv: inkomstenverhouding.datBIkv != null ? String(inkomstenverhouding.datBIkv) : '',
        datumEindIkv: inkomstenverhouding.datEIkv != null ? String(inkomstenverhouding.datEIkv) : '',
        straatadres: mapAdres(getFeitelijkAdres(inkomstenverhouding)),
        opgaven: selectMaxPeriods(opgaven, maxPeriods)
    };
}

function convertToInkomstenUitBronnenDto(data, maxPeriods) {
  print('data');
  print(data);
    var result = {
        loondienst: [],
        uitkering: [],
        pensioen: [],
        svbUitkeringen: [],
        bijstandsregelingen: null,
        onbekend: []
    };

    var list = data &amp;&amp; data.inkomstenverhouding ? data.inkomstenverhouding : [];

    for (var i = 0; i &lt; list.length; i++) {
        var inkomstenverhouding = list[i];
        var mapped = mapUwvInkomsten(inkomstenverhouding, maxPeriods);
        var type = getSoortIkvType(inkomstenverhouding);

        if (type === 'LOONDIENST') {
            result.loondienst.push(mapped);
        } else if (type === 'UITKERING') {
            result.uitkering.push(mapped);
        } else if (type === 'PENSIOEN') {
            result.pensioen.push(mapped);
        } else {
            result.onbekend.push(mapped);
        }
    }

    return result;
}

var result = convertToInkomstenUitBronnenDto(dynProps, 3);
if (result != null) {
    execution.setVariable('uwvInfo', toJavaValue(result));
}</camunda:script>
