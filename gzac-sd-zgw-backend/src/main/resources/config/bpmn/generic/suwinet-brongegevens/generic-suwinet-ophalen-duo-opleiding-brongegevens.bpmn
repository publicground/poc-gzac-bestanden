  <bpmn:process id="generic-suwinet-ophalen-duo-opleiding-brongegevens" name="Generic: Suwinet ophalen DUO opleiding brongegevens " isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_1if7i5z</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="OphalenDUOOpleidingBrongegevensTask" name="Ophalen DUO opleiding brongegevens" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">var raw = execution.getVariable('duoPersoonsInformatieRaw');
var dynProps = raw != null &amp;&amp; raw.dynamicProperties != null ? raw.dynamicProperties : null;

function toJavaValue(value) {
    if (value == null) return null;

    var valueType = typeof value;

    if (valueType === 'string') return String(value);
    if (valueType === 'number') return Number(value);
    if (valueType === 'boolean') return value;

    if (Array.isArray(value)) {
        return toJavaList(value);
    }

    if (valueType === 'object') {
        return toJavaMap(value);
    }

    return String(value);
}

function toJavaMap(obj) {
    var map = new Packages.java.util.LinkedHashMap();

    for (var key in obj) {
        if (Object.prototype.hasOwnProperty.call(obj, key)) {
            map.put(String(key), toJavaValue(obj[key]));
        }
    }

    return map;
}

function toJavaList(arr) {
    var list = new Packages.java.util.ArrayList();

    for (var i = 0; i &lt; arr.length; i++) {
        list.add(toJavaValue(arr[i]));
    }

    return list;
}

function normalizeDuoDate(value) {
    if (value == null) return '';
    return String(value).replace(/-/g, '');
}

function mapOpleidingBasis(i) {
    if (!i) return null;

    return {
        naamOpleidingKortDuo: i.naamOpleidingKortDuo != null ? String(i.naamOpleidingKortDuo) : '',
        codeNiveauOpleidingDuo: i.cdNiveauOpleidingDuo != null ? String(i.cdNiveauOpleidingDuo) : ''
    };
}

function mapInhoudDeelnameOpleiding(i) {
    if (!i) return null;

    var basis = mapOpleidingBasis(i);

    return {
        omsStudiegebied: i.omsStudiegebied != null ? String(i.omsStudiegebied) : '',
        omsStudieinhoud: i.omsStudieinhoud != null ? String(i.omsStudieinhoud) : '',
        omsStudieuitstroom: i.omsStudieuitstroom != null ? String(i.omsStudieuitstroom) : '',
        naamOpleidingKortDuo: basis.naamOpleidingKortDuo,
        codeNiveauOpleidingDuo: basis.codeNiveauOpleidingDuo
    };
}

function mapDeelnameOpleidingGeregistrDuo(i) {
    if (!i) return null;

    return {
        codeLeerwegMbo: i.cdLeerwegMbo != null ? String(i.cdLeerwegMbo) : '',
        codeOnderwijsvorm: i.cdOnderwijsvorm != null ? String(i.cdOnderwijsvorm) : '',
        aanduidingLeerjaar: i.aanduidingLeerjaar != null ? String(i.aanduidingLeerjaar) : '',
        codeInschrijvingsvorm: i.cdInschrijvingsvorm != null ? String(i.cdInschrijvingsvorm) : '',
        datumEindDeelnameOpleiding: normalizeDuoDate(i.datEDeelnameOpleiding),
        datumBeginDeelnameOpleiding: normalizeDuoDate(i.datBDeelnameOpleiding),
        inhoudDeelnameOpleiding: mapInhoudDeelnameOpleiding(i.inhoudDeelnameOpleidingDuo)
    };
}

function mapOnderwijsOvereenkomst(i) {
    if (!i) return null;

    var eersteBrin = i.brin &amp;&amp; i.brin.length &gt; 0 ? i.brin[0] : null;

    var deelnameOpleidingGeregistrDuo = [];
    if (i.deelnameOpleidingGeregistrDuo &amp;&amp; i.deelnameOpleidingGeregistrDuo.length &gt; 0) {
        deelnameOpleidingGeregistrDuo = i.deelnameOpleidingGeregistrDuo.map(function(item) {
            return mapDeelnameOpleidingGeregistrDuo(item);
        });
    }

    return {
        brin: eersteBrin &amp;&amp; eersteBrin.brinNr != null ? String(eersteBrin.brinNr) : '',
        datumInschrijvingOpleiding: normalizeDuoDate(i.datInschrijvingOpleiding),
        datumUitschrijvingOpleiding: normalizeDuoDate(i.datUitschrijvingOpleiding),
        deelnameOpleidingGeregistrDuo: deelnameOpleidingGeregistrDuo
    };
}

function mapInhoudResultaatOpleidingDuo(i) {
    return mapOpleidingBasis(i);
}

function mapResultaatExamen(i) {
    if (!i) return null;

    return {
        codeResultaatExamen: i.cdResultaatExamen != null ? String(i.cdResultaatExamen) : '',
        datumResultaatExamen: i.datResultaatExamen != null ? String(i.datResultaatExamen) : ''
    };
}

function mapResultaatOpleiding(i) {
    if (!i) return null;

    return {
        codeFaseOpleidingDuo: i.cdFaseOpleidingDuo != null ? String(i.cdFaseOpleidingDuo) : '',
        resultaatExamen: mapResultaatExamen(i.resultaatExamen),
        inhoudResultaatOpleidingDuo: mapInhoudResultaatOpleidingDuo(i.inhoudResultaatOpleidingDuo)
    };
}

function convertToDuoOpleiding(data) {
    var onderwijsOvereenkomst = [];
    if (data &amp;&amp; data.onderwijsovereenkomst &amp;&amp; data.onderwijsovereenkomst.length &gt; 0) {
        onderwijsOvereenkomst = data.onderwijsovereenkomst.map(function(i) {
            return mapOnderwijsOvereenkomst(i);
        });
    }

    var resultaatOpleiding = [];
    if (data &amp;&amp; data.resultaatOpleidingGeregistrDuo &amp;&amp; data.resultaatOpleidingGeregistrDuo.length &gt; 0) {
        resultaatOpleiding = data.resultaatOpleidingGeregistrDuo.map(function(i) {
            return mapResultaatOpleiding(i);
        });
    }

    return {
        burgerservicenummer: data &amp;&amp; data.burgerservicenr != null ? String(data.burgerservicenr) : '',
        indicatieStartkwalificatieDuo: data &amp;&amp; data.indStartkwalificatieDuo != null ? String(data.indStartkwalificatieDuo) : '',
        onderwijsOvereenkomst: onderwijsOvereenkomst,
        resultaatOpleiding: resultaatOpleiding
    };
}

var result = convertToDuoOpleiding(dynProps);
if (result != null) {
    execution.setVariable('duoPersoonsInformatie', toJavaValue(result));
}</camunda:script>
        </camunda:executionListener>
