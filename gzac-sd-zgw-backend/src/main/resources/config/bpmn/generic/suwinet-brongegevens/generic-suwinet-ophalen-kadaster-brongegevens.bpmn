    <bpmn:sequenceFlow id="Flow_150hw04" sourceRef="OphalenKadasterAanduidingenTask" targetRef="Activity_Initieer_KadasterObjecten" />
    <bpmn:sequenceFlow id="Flow_1s9yboe" sourceRef="Activity_Initieer_KadasterObjecten" targetRef="Ophalen_KadasterObjectenTask" />
    <bpmn:endEvent id="Event_0fhl1pf">
