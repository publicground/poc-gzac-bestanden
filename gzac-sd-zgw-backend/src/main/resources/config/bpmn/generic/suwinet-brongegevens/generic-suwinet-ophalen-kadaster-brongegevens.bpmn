    <bpmn:scriptTask id="Activity_Initieer_KadasterObjecten" name="Initieer KadasterObjecten" camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="kadasterAanduidingen">
      <bpmn:incoming>Flow_150hw04</bpmn:incoming>
      <bpmn:outgoing>Flow_1s9yboe</bpmn:outgoing>
      <bpmn:script>const ArrayList = Java.type("java.util.ArrayList");
var kadasterObjecten = new ArrayList();
execution.setVariable('kadasterObjecten', kadasterObjecten);

var kadasterAanduidingen = new ArrayList();

var raw = execution.getVariable('kadasterAanduidingenObjectRaw')
print(raw);
if(raw !== null) {
  kadasterAanduidingen = raw.dynamicProperties
}

kadasterAanduidingen;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Ophalen_KadasterObjectenTask" name="Ophalen KadasterObjecten" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">var kadasterObject = execution.getVariable('kadasterObject');

print(kadasterObject);

var kadasterObjectList = execution.getVariable('kadasterObjecten');

kadasterObjectList.push(kadasterObject);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1s9yboe</bpmn:incoming>
      <bpmn:outgoing>Flow_0akdvoh</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:asyncBefore="true" camunda:collection="kadasterAanduidingen" camunda:elementVariable="kadasterAanduiding" />
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1920ghh" sourceRef="Activity_Transfomeer_KadasterObjectList" targetRef="Event_0fhl1pf" />
    <bpmn:scriptTask id="Activity_Transfomeer_KadasterObjectList" name="Transfomeer KadasterObjectList" camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="kadastraleObjecten">
      <bpmn:incoming>Flow_0akdvoh</bpmn:incoming>
      <bpmn:outgoing>Flow_1920ghh</bpmn:outgoing>
      <bpmn:script>// common script
function toJavaValue(value) {
    if (value == null) return null;

    var valueType = typeof value;

    if (valueType === 'string') return String(value);
    if (valueType === 'number') return Number(value);
    if (valueType === 'boolean') return value;

    if (Array.isArray(value)) {
        return toJavaList(value);
    }

    if (valueType === 'object') {
        return toJavaMap(value);
    }

    return String(value);
}

function toJavaMap(obj) {
    var map = new Packages.java.util.LinkedHashMap();

    for (var key in obj) {
        if (Object.prototype.hasOwnProperty.call(obj, key)) {
            map.put(String(key), toJavaValue(obj[key]));
        }
    }

    return map;
}

function toJavaList(arr) {
    var list = new Packages.java.util.ArrayList();

    for (var i = 0; i &lt; arr.length; i++) {
        list.add(toJavaValue(arr[i]));
    }

    return list;
}

function mapAdres(adres) {
    if (!adres) return null;
    return {
        straatnaam: adres.straatnaam != null ? String(adres.straatnaam) : '',
        huisnummer: adres.huisnr != null ? Number(adres.huisnr) : 0,
        huisletter: adres.huisletter != null ? String(adres.huisletter) : '',
        huisnummertoevoeging: adres.huisnrtoevoeging != null ? String(adres.huisnrtoevoeging) : '',
        postcode: adres.postcd != null ? String(adres.postcd) : '',
        woonplaatsnaam: adres.woonplaatsnaam != null ? String(adres.woonplaatsnaam) : '',
        aanduidingBijHuisnummer: adres.aanduidingBijHuisnr != null ? String(adres.aanduidingBijHuisnr) : '',
        locatieomschrijving: adres.locatieoms != null ? String(adres.locatieoms) : ''
    };
}

// kadaster mapping script
function convertToKadastraalObjectDto(obj) {
  var ka = obj.kadastraleAanduiding;
  var kadastraleAanduiding = ka != null ? {
    codeKadastraleGemeente: ka.cdKadastraleGemeente != null ? String(ka.cdKadastraleGemeente) : '',
    kadastraleGemeentenaam: ka.kadastraleGemeentenaam != null ? String(ka.kadastraleGemeentenaam) : '',
    kadastraleSectie: ka.kadastraleSectie != null ? String(ka.kadastraleSectie) : '',
    kadastraalPerceelnr: ka.kadastraalPerceelnr != null ? ka.kadastraalPerceelnr : null,
    volgnrKadastraalAppartementsrecht: ka.volgnrKadastraalAppartementsrecht != null ? ka.volgnrKadastraalAppartementsrecht : null
  } : null;

  var zrList = obj.zakelijkRecht;
  var zr = (zrList != null &amp;&amp; zrList.size() &gt; 0) ? zrList.get(0) : null;
  var zakelijkRecht = {
    omschrijvingZakelijkRecht: zr != null &amp;&amp; zr.omsZakelijkRecht != null ? String(zr.omsZakelijkRecht) : '',
    datumEZakelijkRecht: zr != null &amp;&amp; zr.datEZakelijkRecht != null ? String(zr.datEZakelijkRecht) : ''
  };

  var locatieList = obj.locatieOZ;
  var locatie = (locatieList != null &amp;&amp; locatieList.size() &gt; 0) ? locatieList.get(0) : null;
  var locatieOz = mapAdres(locatie != null ? locatie.straatadresBag : null);

  var pbList = obj.publiekrechtelijkeBeperking;
  var publiekrechtelijkeBeperking = [];
  if (pbList != null) {
    for (var j = 0; j &lt; pbList.size(); j++) {
      var pb = pbList.get(j);
      var aanto = pb != null ? pb.aantekeningKadastraalObject : null;
      publiekrechtelijkeBeperking.push({
        aantekeningKadastraal: {
          datumEAantekeningKadastraal: aanto != null &amp;&amp; aanto.datEAantekeningKadastraalObject != null ? String(aanto.datEAantekeningKadastraalObject) : '',
          omschrijvingAantekeningKadastraal: aanto != null &amp;&amp; aanto.omsAantekeningKadastraalObject != null ? String(aanto.omsAantekeningKadastraalObject) : ''
        }
      });
    }
  }

  return {
    codeTypeOnroerendeZaak: obj.cdTypeOnroerendeZaak != null ? String(obj.cdTypeOnroerendeZaak) : '',
    datumOntstaan: obj.datOntstaan != null ? String(obj.datOntstaan) : '',
    kadastraleAanduiding: kadastraleAanduiding,
    omschrijving: obj.omsKadastraalObject != null ? String(obj.omsKadastraalObject) : '',
    zakelijkRecht: zakelijkRecht,
    locatieOz: locatieOz,
    publiekrechtelijkeBeperking: publiekrechtelijkeBeperking,
    indicatieMeerGerechtigden: obj.indMeerGerechtigden != null ? String(obj.indMeerGerechtigden) : ''
  };
}

function convertToKadastraleObjectenDto(kadasterObjecten) {
  var kadastraleObjecten = [];
  for (var i = 0; i &lt; kadasterObjecten.size(); i++) {
    var item = kadasterObjecten.get(i);
    var obj = item != null ? item.dynamicProperties : null;
    if (obj == null) continue;
    kadastraleObjecten.push(convertToKadastraalObjectDto(obj));
  }
  return { kadastraleObjecten: kadastraleObjecten };
}


// process script
var raw = execution.getVariable('kadasterObjecten');
var result = convertToKadastraleObjectenDto(raw);
toJavaValue(result);</bpmn:script>
    </bpmn:scriptTask>
