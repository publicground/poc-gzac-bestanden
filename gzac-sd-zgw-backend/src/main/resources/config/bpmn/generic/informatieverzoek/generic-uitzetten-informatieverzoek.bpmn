    <bpmn:scriptTask id="TransformDataTask" name="Transform data " camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="bestandenResult">
      <bpmn:incoming>Flow_0vftdxo</bpmn:incoming>
      <bpmn:outgoing>Flow_1cbw62w</bpmn:outgoing>
      <bpmn:script>var opTeVragenInformatie = execution.getVariable("opTeVragenInformatie");

function transformData(opTeVragenInformatie) {
    var bestanden = new java.util.LinkedHashMap();

    if (!(opTeVragenInformatie instanceof java.util.List) || opTeVragenInformatie.isEmpty()) {
        return bestanden;
    }

    for (var i = 0; i &lt; opTeVragenInformatie.size(); i++) {
        var item = opTeVragenInformatie.get(i);
        if (item instanceof java.util.Map &amp;&amp; item.containsKey("informatieverzoekItem") &amp;&amp; item.get("informatieverzoekItem") instanceof java.util.Map) {
            var infoItem = item.get("informatieverzoekItem");
            if (infoItem.containsKey("omschrijvingBehandelaar") &amp;&amp; item.containsKey("documentUpload")) {
                var handlerDescription = infoItem.get("omschrijvingBehandelaar");
                var uploads = item.get("documentUpload");

                if (uploads instanceof java.util.List &amp;&amp; !uploads.isEmpty() &amp;&amp; handlerDescription != null) {
                    handlerDescription = String(handlerDescription);

                    if (bestanden.containsKey(handlerDescription)) {
                        var existingUploads = bestanden.get(handlerDescription);
                        existingUploads.addAll(uploads);
                    } else {
                        var uploadList = new java.util.ArrayList();
                        uploadList.addAll(uploads);
                        bestanden.put(handlerDescription, uploadList);
                    }
                }
            } else if (item.containsKey("documentUpload")) {
                var uploadListSimpelinformatieverzoek = new java.util.ArrayList();
                var uploadsSimpelInformatieverzoek = item.get("documentUpload");
                uploadListSimpelinformatieverzoek.addAll(uploadsSimpelInformatieverzoek);
                bestanden.put(i, uploadListSimpelinformatieverzoek);
            }

        }
    }

    return bestanden;
}

transformData(opTeVragenInformatie);</bpmn:script>
    </bpmn:scriptTask>
