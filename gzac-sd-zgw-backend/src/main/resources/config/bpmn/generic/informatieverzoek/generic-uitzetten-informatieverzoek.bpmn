        <camunda:executionListener expression="${execution.setVariable(&#34;currentIndex&#34;, (documentDelegateService.findValueByJsonPointer(&#34;/informatieverzoeken&#34;,execution)).size())} " event="start" />
      </bpmn:extensionElements>
