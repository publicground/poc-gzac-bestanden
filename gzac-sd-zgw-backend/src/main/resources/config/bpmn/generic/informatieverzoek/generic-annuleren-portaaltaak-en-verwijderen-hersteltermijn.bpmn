    <bpmn:serviceTask id="VerwijderenHersteltermijnTask" name="Verwijderen hersteltermijn" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="hersteltermijn">${verzoek.hersteltermijnInDagen}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_04wx4yk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="HersteltermijnVanToepassingGateway" name="hersteltermijn van toepassing?" default="NeeSequenceFlow">
      <bpmn:incoming>Flow_0vl468k</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0mjkfcn">
      <bpmn:incoming>Flow_04wx4yk</bpmn:incoming>
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_01e3lv3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1sib4o4">
      <bpmn:incoming>Flow_01e3lv3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="AnnulerenPortaaltaakEvent" name="Annuleren portaaltaak" camunda:asyncBefore="true" camunda:asyncAfter="true">
      <bpmn:incoming>Flow_0oofhvp</bpmn:incoming>
      <bpmn:outgoing>Flow_0rhdocr</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0de53dn" camunda:expression="${correlationService.sendCatchEventMessage(&#34;OPVRAGEN_INFORMATIE_PORTAALTAAK_GEANNULEERD&#34;,execution.businessKey)}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="WachtenTotDePortalTaakIsGeannuleerdEvent" name="Wachten tot de portal taak is geannuleerd">
      <bpmn:incoming>Flow_0rhdocr</bpmn:incoming>
      <bpmn:outgoing>Flow_0vl468k</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_13558a4">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1bojmff" sourceRef="StartEvent_1" targetRef="OphalenHersteltermijnTask" />
    <bpmn:serviceTask id="OphalenHersteltermijnTask" name="Ophalen hersteltermijn" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="informatieverzoeken">${valueResolverDelegateService.resolveValue(execution, "doc:/informatieverzoeken")}</camunda:inputParameter>
          <camunda:outputParameter name="verzoek">${informatieverzoeken[informatieverzoeken.size() - 1].verzoek}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1bojmff</bpmn:incoming>
      <bpmn:outgoing>Flow_0oofhvp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0oofhvp" sourceRef="OphalenHersteltermijnTask" targetRef="AnnulerenPortaaltaakEvent" />
  </bpmn:process>
