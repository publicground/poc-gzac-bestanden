  <bpmn:process id="generic-annuleren-portaal-en-verwijderen-hersteltermijn" name="Generic: annuleren portaal en verwijderen hersteltermijn" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1bojmff</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="HersteltermijnVanToepassingGateway" targetRef="VerwijderenHersteltermijnTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verzoek.hersteltermijn == 'JA'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04wx4yk" sourceRef="VerwijderenHersteltermijnTask" targetRef="Gateway_0mjkfcn" />
