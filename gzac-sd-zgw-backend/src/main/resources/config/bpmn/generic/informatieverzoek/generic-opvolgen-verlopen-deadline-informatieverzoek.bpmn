    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="AnnulerenInformatieverzoekCallActivity" name="Annuleren informatie-verzoek" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-annuleren-informatieverzoek">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="verzoek" target="verzoek" />
      </bpmn:extensionElements>
      <bpmn:incoming>InformatieverzoekAnnulerenSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1299e5u</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="VerlengingDeadlineCallActivity" name="Verlenging deadline" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-verlengen-deadline-informatieverzoek">
