    <bpmn:callActivity id="UpdateZaakstatusCallActivity1" name="Update zaakstatus en interne status" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-update-zaakstatus-en-interne-status-plugin-v2">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in sourceExpression="${&#34;Geen aanvullende informatie ontvangen&#34;}" target="zaakstatus" />
        <camunda:in sourceExpression="${&#34;geen-aanvullende-informatie-ontvangen&#34;}" target="interneStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_161l2xp</bpmn:incoming>
      <bpmn:outgoing>Flow_0b46bsi</bpmn:outgoing>
