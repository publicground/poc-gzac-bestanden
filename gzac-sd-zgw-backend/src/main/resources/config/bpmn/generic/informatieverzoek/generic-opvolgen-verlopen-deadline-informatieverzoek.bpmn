    <bpmn:sequenceFlow id="Flow_161l2xp" sourceRef="DeadlineVerlopenStartEvent" targetRef="UpdateZaakstatusCallActivity1" />
    <bpmn:sequenceFlow id="Flow_0b46bsi" sourceRef="UpdateZaakstatusCallActivity1" targetRef="BepalenVervolgactieNaVerlopenDeadlineTask" />
    <bpmn:sequenceFlow id="Flow_1spougl" sourceRef="BepalenVervolgactieNaVerlopenDeadlineTask" targetRef="Gateway_1jyrg9i" />
    <bpmn:sequenceFlow id="InformatieverzoekAnnulerenSequenceFlow" name="Informatieverzoek annuleren" sourceRef="Gateway_1jyrg9i" targetRef="AnnulerenInformatieverzoekCallActivity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${vervolgactieVerlopenDeadline == "ANNULEREN"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="DeadlineVerlengenSequenceFlow" name="Deadline verlengen" sourceRef="Gateway_1jyrg9i" targetRef="VerlengingDeadlineCallActivity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${vervolgactieVerlopenDeadline == "VERLENGEN"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1299e5u" sourceRef="AnnulerenInformatieverzoekCallActivity" targetRef="InformatieverzoekGeannuleerdEndEvent" />
    <bpmn:sequenceFlow id="Flow_16g6ibx" sourceRef="VerlengingDeadlineCallActivity" targetRef="DeadlineVerlengdEndEvent" />
  </bpmn:process>
