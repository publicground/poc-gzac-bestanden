    <bpmn:textAnnotation id="TextAnnotation_1d6j37k">
      <bpmn:text>nieuwe zaakstatus:  Geen aanvullende informatie ontvangen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_00z5cc0" associationDirection="None" sourceRef="UpdateZaakstatusCallActivity1" targetRef="TextAnnotation_1d6j37k" />
