  <bpmn:process id="generic-opvolgen-verlopen-deadline-informatieverzoek" name="Generic: Opvolgen verlopen deadline" isExecutable="true">
    <bpmn:laneSet id="LaneSet_0erfpgh" />
    <bpmn:startEvent id="DeadlineVerlopenStartEvent" name="Deadline verlopen" camunda:asyncAfter="true">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#34;informatieverzoeken&#34;, valueResolverDelegateService.resolveValue(execution, &#34;doc:/informatieverzoeken&#34;))}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_161l2xp</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="BepalenVervolgactieNaVerlopenDeadlineTask" name="Bepalen vervolgactie na verlopen deadline" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="52">
      <bpmn:incoming>Flow_0b46bsi</bpmn:incoming>
      <bpmn:outgoing>Flow_1spougl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1jyrg9i">
