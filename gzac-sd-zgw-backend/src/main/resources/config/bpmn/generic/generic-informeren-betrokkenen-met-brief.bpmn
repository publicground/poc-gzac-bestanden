<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0gn7a75" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <bpmn:collaboration id="Collaboration_0zlk7de">
    <bpmn:participant id="GenericInformerenBetrokkenenParticipant" name="Generic: Informeren betrokkenen met brief" processRef="generic-informeren-betrokkenen-met-brief" />
  </bpmn:collaboration>
  <bpmn:process id="generic-informeren-betrokkenen-met-brief" name="Generic: Informeren betrokkenen met brief" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0rkzzjl</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="VersturenEmailnotificatieTask" name="Versturen emailnotificatie" camunda:asyncAfter="true" implementation="##WebService" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="datumOntvangstAanvraag">${datumOntvangstAanvraag}</camunda:inputParameter>
          <camunda:inputParameter name="voorlettersAanvrager">${voorlettersAanvrager}</camunda:inputParameter>
          <camunda:inputParameter name="voornaamAanvrager">${voornaamAanvrager}</camunda:inputParameter>
          <camunda:inputParameter name="voorvoegselAanvrager">${voorvoegselAanvrager}</camunda:inputParameter>
          <camunda:inputParameter name="achternaamAanvrager">${achternaamAanvrager}</camunda:inputParameter>
          <camunda:inputParameter name="deadlineInformatieverzoek">${prettyDeadline}</camunda:inputParameter>
          <camunda:inputParameter name="emailAanvrager">${emailAanvrager}</camunda:inputParameter>
          <camunda:inputParameter name="mailTaskSubject">${mailTaskSubject}</camunda:inputParameter>
          <camunda:inputParameter name="mailTaskTemplate">${mailTaskTemplate}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1nqy3wx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1u9b04e">
      <bpmn:incoming>Flow_1nqy3wx</bpmn:incoming>
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_14z8pvv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="EmailadresAanwezigGateway" name="Emailadres aanwezig?" default="NeeSequenceFlow">
      <bpmn:incoming>Flow_0rkzzjl</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CommunicatievoorkeurPostGateway" name="Communicatievoorkeur post?" default="NeeSequenceFlow1">
      <bpmn:incoming>Flow_14z8pvv</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow1</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0l97cvq">
      <bpmn:incoming>NeeSequenceFlow1</bpmn:incoming>
      <bpmn:incoming>Flow_0g0gy16</bpmn:incoming>
      <bpmn:outgoing>Flow_04ylbli</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="AfdrukkenBriefTask" name="Afdrukken brief" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="56">
      <bpmn:incoming>JaSequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>Flow_0g0gy16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0xxyiu1">
      <bpmn:incoming>Flow_04ylbli</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0rkzzjl" sourceRef="StartEvent_1" targetRef="EmailadresAanwezigGateway" />
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="EmailadresAanwezigGateway" targetRef="VersturenEmailnotificatieTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${emailAanwezig != null &amp;&amp; emailAanwezig != ""}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1nqy3wx" sourceRef="VersturenEmailnotificatieTask" targetRef="Gateway_1u9b04e" />
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="Nee" sourceRef="EmailadresAanwezigGateway" targetRef="Gateway_1u9b04e" />
    <bpmn:sequenceFlow id="Flow_14z8pvv" sourceRef="Gateway_1u9b04e" targetRef="CommunicatievoorkeurPostGateway" />
    <bpmn:sequenceFlow id="JaSequenceFlow1" name="Ja" sourceRef="CommunicatievoorkeurPostGateway" targetRef="AfdrukkenBriefTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${communicatievoorkeur == "post"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="NeeSequenceFlow1" name="Nee" sourceRef="CommunicatievoorkeurPostGateway" targetRef="Gateway_0l97cvq" />
    <bpmn:sequenceFlow id="Flow_0g0gy16" sourceRef="AfdrukkenBriefTask" targetRef="Gateway_0l97cvq" />
    <bpmn:sequenceFlow id="Flow_04ylbli" sourceRef="Gateway_0l97cvq" targetRef="Event_0xxyiu1" />
  </bpmn:process>
