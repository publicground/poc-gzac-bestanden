    <bpmn:sequenceFlow id="Flow_17g5evr" sourceRef="VergelijkenOpgegevenVerblijfadresMetAdresInBRPTask" targetRef="OpgegevenVerblijfadresConformBRPGateway" />
    <bpmn:sequenceFlow id="NeeSequenceFlow1" name="Nee" sourceRef="OpgegevenVerblijfadresConformBRPGateway" targetRef="VaststellingVerblijfadresTask" />
    <bpmn:sequenceFlow id="Flow_1kzf47i" sourceRef="VaststellingVerblijfadresTask" targetRef="Gateway_0dos2vo" />
    <bpmn:sequenceFlow id="Flow_0iti4m8" sourceRef="BepalenGegevensKwalitatiefVoldoendeAanwezigTask" targetRef="GegevensKwalitatiefVoldoendeAanwezigGateway" />
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="OpgegevenVerblijfadresConformBRPGateway" targetRef="Gateway_0dos2vo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${opgegevenVerblijfadresConformBrp == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11nj72e" sourceRef="Gateway_0dos2vo" targetRef="BepalenVastgesteldVerblijfadresTask" />
    <bpmn:sequenceFlow id="Flow_005sqfg" sourceRef="BepalenVastgesteldVerblijfadresTask" targetRef="SamenstellenOutputVariabelenTask" />
