      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${gegevenskwalitatiefVoldoendeAanwezig == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17roic9" sourceRef="SamenstellenOutputVariabelenTask" targetRef="Gateway_0aoybat" />
    <bpmn:serviceTask id="SamenstellenOutputVariabelenTask" name="Samenstellen output variabelen" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="verblijfadresVastgesteld">${true}</camunda:outputParameter>
          <camunda:outputParameter name="datumVastgesteld">${now().toInstant().toString()}</camunda:outputParameter>
          <camunda:outputParameter name="toelichtingConsulent">${execution.getVariable("toelichtingConsulent")}</camunda:outputParameter>
          <camunda:outputParameter name="vastgesteldVerblijfadres">${vastgesteldVerblijfadres}</camunda:outputParameter>
          <camunda:outputParameter name="teGebruikenAdres">${execution.getVariable("teGebruikenAdres")}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_005sqfg</bpmn:incoming>
      <bpmn:outgoing>Flow_17roic9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0aoybat">
      <bpmn:incoming>JaSequenceFlow1</bpmn:incoming>
      <bpmn:incoming>Flow_17roic9</bpmn:incoming>
      <bpmn:outgoing>Flow_1yu2fu9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="VaststellingVerblijfadresTask" name="${taakTitel}" camunda:formRef="stelAdresVast" camunda:formRefBinding="latest" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="40">
      <bpmn:extensionElements />
      <bpmn:incoming>NeeSequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>Flow_1kzf47i</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0d91tij">
      <bpmn:incoming>Flow_1yu2fu9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:association id="Association_0ikcykd" associationDirection="None" sourceRef="Event_0d91tij" targetRef="TextAnnotation_1r2hgg0" />
  </bpmn:process>
