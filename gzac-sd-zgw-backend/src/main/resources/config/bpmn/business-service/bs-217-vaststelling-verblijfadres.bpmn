<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0r27c1v" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:collaboration id="Collaboration_1hrfleu">
    <bpmn:participant id="BS217VaststellingVerblijfadresParticipant" name="BS 217 vaststelling verblijfadres" processRef="bs-217-vaststelling-verblijfadres" />
    <bpmn:textAnnotation id="TextAnnotation_0uggn2j">
      <bpmn:text>Input variabelen:
- verblijfadresVastgesteld
- datumVastgesteld
- handmatigVaststellen
- toelichtingVerblijftElders

- verblijfadres
- brpWoonadres

- taakTitel
- vastgesteldVerblijfadres
- brpPostadres
- toelichtingConsulent</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1r2hgg0">
      <bpmn:text>Output variabelen
- verblijfadresVastgesteld
- datumVastgesteld
- vastgesteldVerblijfadres
- toelichtingConsulent</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0xdc937" associationDirection="None" sourceRef="StartEvent_1" targetRef="TextAnnotation_0uggn2j" />
    <bpmn:textAnnotation id="TextAnnotation_1iuqb0r">
      <bpmn:text>Consulent selecteert handmatig het verblijfadres uit de gepresenteerde opties</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ppl8uq" associationDirection="None" sourceRef="VaststellingVerblijfadresTask" targetRef="TextAnnotation_1iuqb0r" />
  </bpmn:collaboration>
  <bpmn:process id="bs-217-vaststelling-verblijfadres" name="BS 217 vaststelling verblijfadres" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0jw5bt5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="VergelijkenOpgegevenVerblijfadresMetAdresInBRPTask" name="Vergelijken opgegeven verblijfadres met adres in BRP" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:resultVariable="comperedResult" camunda:decisionRef="bs-217-verblijfadres-conform-brp" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="opgegevenVerblijfadresConformBrp">${comperedResult.opgegevenVerblijfadresConformBrp}</camunda:outputParameter>
          <camunda:outputParameter name="isHandmatigBeoordeeld">${comperedResult.handmatigVaststellen}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_17g5evr</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="BepalenGegevensKwalitatiefVoldoendeAanwezigTask" name="Bepalen gegevens kwalitatief voldoende aanwezig" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:resultVariable="resultVariable" camunda:decisionRef="bs-217-kwalitatief-voldoende-aanwezig" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="gegevenskwalitatiefVoldoendeAanwezig">${resultVariable.gegevenskwalitatiefVoldoendeAanwezig}</camunda:outputParameter>
          <camunda:outputParameter name="handmatigVaststellen">${resultVariable.handmatigVaststellen}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0jw5bt5</bpmn:incoming>
      <bpmn:outgoing>Flow_0iti4m8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_0dos2vo">
      <bpmn:incoming>Flow_1kzf47i</bpmn:incoming>
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_11nj72e</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="BepalenVastgesteldVerblijfadresTask" name="Bepalen vastgesteld verblijfadres" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:resultVariable="vastgesteldVerblijfadres" camunda:decisionRef="bs-217-lever-vastgesteld-adres" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="doorConsulentGekozenVerblijfadres">${execution.getVariable("teGebruikenAdres")}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11nj72e</bpmn:incoming>
      <bpmn:outgoing>Flow_005sqfg</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="OpgegevenVerblijfadresConformBRPGateway" name="Opgegeven verblijfadres conform BRP" default="NeeSequenceFlow1">
      <bpmn:incoming>Flow_17g5evr</bpmn:incoming>
      <bpmn:outgoing>NeeSequenceFlow1</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GegevensKwalitatiefVoldoendeAanwezigGateway" name="Gegevens kwalitatief voldoende aanwezig?" default="NeeSequenceFlow">
      <bpmn:incoming>Flow_0iti4m8</bpmn:incoming>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0jw5bt5" sourceRef="StartEvent_1" targetRef="BepalenGegevensKwalitatiefVoldoendeAanwezigTask" />
    <bpmn:sequenceFlow id="Flow_1yu2fu9" sourceRef="Gateway_0aoybat" targetRef="Event_0d91tij" />
