<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1y9ob7p" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:collaboration id="Collaboration_0vdtc6x">
    <bpmn:participant id="BSVastleggenBesluitParticipant" name="BS Vastleggen besluit" processRef="bs-vastleggen-besluit" />
  </bpmn:collaboration>
  <bpmn:process id="bs-vastleggen-besluit" name="BS Vastleggen besluit" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="VaststellenBesluitGestartStartEvent" name="Vaststellen besluit gestart">
      <bpmn:outgoing>Flow_1ksgoy8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="VaststellenBesluitTask" name="Vaststellen besluit" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="2">
      <bpmn:incoming>Flow_1ksgoy8</bpmn:incoming>
      <bpmn:outgoing>Flow_050gwrz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_050gwrz" sourceRef="VaststellenBesluitTask" targetRef="GetBesluitDocumentUrlTask" />
    <bpmn:sequenceFlow id="Flow_1j4av1j" sourceRef="BepalenBesluittypeTask" targetRef="VastleggenBesluitCallActivity" />
    <bpmn:sequenceFlow id="Flow_1ksgoy8" sourceRef="VaststellenBesluitGestartStartEvent" targetRef="VaststellenBesluitTask" />
    <bpmn:sequenceFlow id="Flow_1q7ffgv" sourceRef="GetBesluitDocumentUrlTask" targetRef="BepalenBesluittypeTask" />
    <bpmn:sequenceFlow id="Flow_180ten5" sourceRef="VastleggenBesluitCallActivity" targetRef="ZetZaakEigenschapCallActivity" />
    <bpmn:sequenceFlow id="Flow_1ehl1pr" sourceRef="ZetZaakEigenschapCallActivity" targetRef="EmailAdresAanwezigGateway" />
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="Ja" sourceRef="EmailAdresAanwezigGateway" targetRef="VersturenEmailnotificatieBesluitTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${emailAanvrager != null &amp;&amp; emailAanvrager != ""}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0z2ozlr" sourceRef="VersturenEmailnotificatieBesluitTask" targetRef="Gateway_1qq89dk" />
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Nee" sourceRef="EmailAdresAanwezigGateway" targetRef="Gateway_1qq89dk" />
    <bpmn:serviceTask id="GetBesluitDocumentUrlTask" name="Get besluit document url " camunda:asyncAfter="true" camunda:expression="${resourceStorageDelegate.getMetadata(tempFileId,&#34;documentUrl&#34;)}" camunda:resultVariable="besluitDocumentUrl">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="tempFileId">${besluit.besluitDocumenten[0].id}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_050gwrz</bpmn:incoming>
      <bpmn:outgoing>Flow_1q7ffgv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BepalenBesluittypeTask" name="Bepalen besluittype" camunda:asyncAfter="true" camunda:resultVariable="besluitType" camunda:decisionRef="alo-bepalen-besluittype" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1q7ffgv</bpmn:incoming>
      <bpmn:outgoing>Flow_1j4av1j</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="VastleggenBesluitCallActivity" name="Vastleggen besluit" camunda:asyncAfter="true" calledElement="generic-vastleggen-besluit">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="besluitType" target="besluitTypeDescription" />
        <camunda:inputOutput>
          <camunda:inputParameter name="besluitIngangsdatum">${dateTime().toLocalDate().toString()}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:in source="besluitIngangsdatum" target="besluitIngangsdatum" />
        <camunda:in source="besluitDocumentUrl" target="besluitDocumentUrl" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1j4av1j</bpmn:incoming>
      <bpmn:outgoing>Flow_180ten5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="ZetZaakEigenschapCallActivity" name="Zet zaak eigenschap" camunda:asyncAfter="true" calledElement="generic-zet-zaakeigenschap">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="eigenschapnaam" target="eigenschapnaam" />
        <camunda:inputOutput>
          <camunda:inputParameter name="einddatum">${dateTime().toLocalDate().toString("yyyyMMdd")}</camunda:inputParameter>
          <camunda:inputParameter name="eigenschapnaam">einddatum</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:in source="einddatum" target="eigenschapValue" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_180ten5</bpmn:incoming>
      <bpmn:outgoing>Flow_1ehl1pr</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="VersturenEmailnotificatieBesluitTask" name="Versturen emailnotificatie besluit" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_0z2ozlr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="EmailAdresAanwezigGateway" name="Email adres aanwezig?" default="JaSequenceFlow">
      <bpmn:incoming>Flow_1ehl1pr</bpmn:incoming>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_1qq89dk">
      <bpmn:incoming>Flow_0z2ozlr</bpmn:incoming>
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_0ev757n</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0ev757n" sourceRef="Gateway_1qq89dk" targetRef="VastleggenBesluitAfgerondEndEvent" />
    <bpmn:endEvent id="VastleggenBesluitAfgerondEndEvent" name="Vastleggen besluit afgerond" camunda:asyncBefore="true">
      <bpmn:incoming>Flow_0ev757n</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
