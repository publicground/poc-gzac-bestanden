<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1xra9ox" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:collaboration id="Collaboration_0try9uw">
    <bpmn:participant id="BSVastsstellenLeefEnWoonsituatieParticipant" name="BS vastsstellen leef en woonsituatie" processRef="bs-223-vastsstellen-leef-en-woonsituatie" />
    <bpmn:textAnnotation id="TextAnnotation_1an6fyr">
      <bpmn:text>Input variabelen
- leefEnWoonsituatieVastgesteld
- datumVaststellingLeefEnWoonsituatie
- woonsituatie (vastgesteld)
- toelichtingWoonsituatie
- leefsituatie (vastgesteld)
- toelichtingLeefsituatie

- handmatigVaststellen

- aanvrager
- verblijfadresAanvrager
- verblijfadresAanvragerIsInstelling

- partnerAanwezig
- partner
- verblijfadresPartner
- verblijfadresPartnerIsInstelling

- woonsituatieVolgensAanvraag</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1sppbnf" associationDirection="None" sourceRef="TextAnnotation_1an6fyr" targetRef="StartEvent_1" />
    <bpmn:textAnnotation id="TextAnnotation_0swb1xd">
      <bpmn:text>Tonen: 
- volledige naam aanvrager
- volledige naam partner (indien partner aanwezig)
- verblijfadres aanvrager
- verblijfadres partner (indien partner aanwezig)
- verblijfadres aanvrager is instelling (Y/N)
- verblijfadres partner is instelling (Y/N) (indien partner aanwezig)
- woonsituatie volgens aanvraag

Invoer:
- Aantal belanghebbenden (prefill uit dmn)
- Woonsituatie (prefill uit dmn)
- Art 23.3 van toepassing (prefill uit dmn)
- Toelichting</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1vkn4vj" associationDirection="None" sourceRef="TextAnnotation_0swb1xd" targetRef="VaststellenWoonsituatieTask1" />
    <bpmn:textAnnotation id="TextAnnotation_00otchh">
      <bpmn:text>Tonen: 
- Vastgesteld aantal belanghebbenden 
- Vastgestelde Woonsituatie 
- Art 23.3 van toepassing (Y/N) 

Invoer:
- Leefsituatie (prefill ui dmn)
- Toelichting</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_10jvvu5" associationDirection="None" sourceRef="TextAnnotation_00otchh" targetRef="VaststellenLeefsituatieTask1" />
    <bpmn:textAnnotation id="TextAnnotation_1c8lnt9">
      <bpmn:text>Output variabelen
- leefEnWoonsituatieVastgesteld
- datumVaststellingLeefEnWoonsituatie
- woonsituatie
- toelichtingWoonsituatie
- leefsituatie
- toelichtingLeefsituatie</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0gqikh5" associationDirection="None" sourceRef="TextAnnotation_1c8lnt9" targetRef="Event_1g0prii" />
  </bpmn:collaboration>
