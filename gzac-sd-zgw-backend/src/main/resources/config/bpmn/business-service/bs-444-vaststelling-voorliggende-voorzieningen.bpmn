    <bpmn:userTask id="TaakTitelTask" name="${taakTitel}" camunda:asyncBefore="true" camunda:asyncAfter="true" implementation="##unspecified" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="34">
      <bpmn:incoming>JaSequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>Flow_0ty8y0a</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_10q3d12">
      <bpmn:incoming>NeeSequenceFlow1</bpmn:incoming>
      <bpmn:incoming>Flow_0ty8y0a</bpmn:incoming>
      <bpmn:outgoing>Flow_1hqu3cc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1krsaam" sourceRef="Activity_02rta47" targetRef="IsErEenSignaleringGateway" />
    <bpmn:scriptTask id="Activity_02rta47" name="Zoek naar signalering" camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="isSignalering">
      <bpmn:incoming>Flow_1oznkv3</bpmn:incoming>
      <bpmn:outgoing>Flow_1krsaam</bpmn:outgoing>
      <bpmn:script>var isSignalering = false;
var voorzieningen = execution.getVariable("voorzieningen");
isSignalering = voorzieningen.some(voorziening =&gt; voorziening.signalering === true);

isSignalering;</bpmn:script>
    </bpmn:scriptTask>
  </bpmn:process>
