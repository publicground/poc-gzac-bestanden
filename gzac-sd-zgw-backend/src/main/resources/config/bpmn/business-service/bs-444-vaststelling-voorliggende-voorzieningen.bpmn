    <bpmn:sequenceFlow id="Flow_0bo9coh" sourceRef="StartEvent_1" targetRef="BepalenGegevensKwalitatiefVoldoendeAanwezigTask" />
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="Nee" sourceRef="GegevensKwalitatiefVoldoendeAanwezigGateway" targetRef="VoorliggendeVoorzieningenTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!gegevenskwalitatiefVoldoendeAanwezig}</bpmn:conditionExpression>
