  </bpmn:collaboration>
  <bpmn:process id="bs-444-vaststelling-voorliggende-voorzieningen" name="BS 444 vaststelling voorliggende voorzieningen" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0bo9coh</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="VoorliggendeVoorzieningenTask" name="voorliggende voorzieningen" camunda:asyncBefore="true" camunda:asyncAfter="true" implementation="##unspecified" camunda:resultVariable="voorzieningenDmn" camunda:decisionRef="bs-444-voorliggende-voorzieningen">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gegevensVanuitAanvraag">${gegevensVanuitAanvraag}</camunda:inputParameter>
          <camunda:inputParameter name="gegevensVaststelling">${gegevensVaststelling}</camunda:inputParameter>
          <camunda:inputParameter name="gegevensVanuitBronnen">${gegevensVanuitBronnen}</camunda:inputParameter>
          <camunda:inputParameter name="bsn">${bsn}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">// Merge dmn output with vastgestelde data while keeping user input fields toelichting and vanToepassing.
var dmnData = execution.getVariable('voorzieningenDmn');
var userData = execution.getVariable('vastgesteldeVoorliggendeVoorzieningen');

var ArrayList = Java.type('java.util.ArrayList');
var LinkedHashMap = Java.type('java.util.LinkedHashMap');

function mergeByKey(primaryList, secondaryList, keyField) {

    if (primaryList == null) {
        return new ArrayList();
    }

    var secondaryIndex = new LinkedHashMap();

    if (secondaryList != null) {
        for (var i = 0; i &lt; secondaryList.size(); i++) {
            var item = secondaryList.get(i);
            if (item != null &amp;&amp; item.get(keyField) != null) {
                secondaryIndex.put(String(item.get(keyField)), item);
            }
        }
    }

    var result = new ArrayList();

    for (var j = 0; j &lt; primaryList.size(); j++) {
        var primaryItem = primaryList.get(j);
        if (primaryItem == null) continue;

        var key = primaryItem.get(keyField) != null
            ? String(primaryItem.get(keyField))
            : '';

        var secondaryMatch = secondaryIndex.get(key);

        var mergedItem = new LinkedHashMap();

        var signalering = primaryItem.get('signalering');
        var toelichting = primaryItem.get('toelichting');
        var voorziening = primaryItem.get('voorziening');
        var mogelijkRecht = primaryItem.get('mogelijkRecht');
        var vanToepassing = primaryItem.get('vanToepassing');
        var geimplementeerd = primaryItem.get('geimplementeerd');
        var verantwoording = primaryItem.get('verantwoordingVaststelling');

        // override with user input
        if (secondaryMatch != null) {
            if (secondaryMatch.containsKey('toelichting')) {
                toelichting = secondaryMatch.get('toelichting');
            }
            if (secondaryMatch.containsKey('vanToepassing')) {
                vanToepassing = secondaryMatch.get('vanToepassing');
            }
        }

        // enforce correct order
        mergedItem.put('signalering', signalering);
        if (toelichting != null) {
            mergedItem.put('toelichting', toelichting);
        }
        mergedItem.put('voorziening', voorziening);
        mergedItem.put('mogelijkRecht', mogelijkRecht);
        if (vanToepassing != null) {
            mergedItem.put('vanToepassing', vanToepassing);
        }
        mergedItem.put('geimplementeerd', geimplementeerd);
        mergedItem.put('verantwoordingVaststelling', verantwoording);

        result.add(mergedItem);
    }

    return result;
}


function sortTable(list) {
    if (list == null) return list;

    list.sort(function(a, b) {
        function bool(val) {
            return val === true ? 1 : 0;
        }

        function hasToelichting(val) {
            return (val != null &amp;&amp; String(val).length &gt; 0) ? 1 : 0;
        }

        return (
            bool(b.get('vanToepassing')) - bool(a.get('vanToepassing')) ||
            bool(b.get('signalering')) - bool(a.get('signalering')) ||
            hasToelichting(b.get('toelichting')) - hasToelichting(a.get('toelichting')) ||
            bool(b.get('geimplementeerd')) - bool(a.get('geimplementeerd'))
        );
    });

    return list;
}


var result = mergeByKey(dmnData, userData, 'voorziening');

result = sortTable(result);

execution.setVariable('voorzieningen', result);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1oznkv3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GegevensKwalitatiefVoldoendeAanwezigGateway" name="Gegevens kwalitatief voldoende aanwezig?" default="JaSequenceFlow">
      <bpmn:incoming>Flow_190i71p</bpmn:incoming>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="BepalenGegevensKwalitatiefVoldoendeAanwezigTask" name="bepalen gegevens kwalitatief voldoende aanwezig" camunda:asyncAfter="true" camunda:resultVariable="result" camunda:decisionRef="bs-444-kwalitatief-voldoende-aanwezig" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="handmatigVaststellen">${result.handmatigVaststellen || false}</camunda:outputParameter>
          <camunda:outputParameter name="gegevenskwalitatiefVoldoendeAanwezig">${result.gegevenskwalitatiefVoldoendeAanwezig || false}</camunda:outputParameter>
