        <camunda:in sourceExpression="${execution.getVariable(&#34;gegevensAanvrager&#34;).achternaam}" target="achternaamAanvrager" />
        <camunda:in sourceExpression="${execution.getVariable(&#34;gegevensAanvrager&#34;).contactgegevens.email}" target="emailAanvrager" />
        <camunda:in sourceExpression="${execution.getVariable(&#34;gegevensAanvrager&#34;).voorvoegsel}" target="voorvoegselAanvrager" />
        <camunda:in source="datumOntvangstAanvraag" target="datumOntvangstAanvraag" />
        <camunda:in sourceExpression="${null}" target="prettyDeadline" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1i2w889</bpmn:incoming>
      <bpmn:outgoing>Flow_1bakwea</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="UpdateZaakstatusEnInterneStatusCallActivity" name="Update zaakstatus en interne status" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-update-zaakstatus-en-interne-status-plugin-v2">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
