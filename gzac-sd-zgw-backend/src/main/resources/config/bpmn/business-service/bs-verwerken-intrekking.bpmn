    <bpmn:sequenceFlow id="Flow_0moiwah" sourceRef="IntrekkingGeheleAanvraagOntvangenStartEvent" targetRef="VastleggenIntrekkingTask" />
    <bpmn:callActivity id="GenereerDocumentCallActivity" name="Genereer document" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="alo-genereer-document">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="zaaknummer" target="zaaknummer" />
        <camunda:in source="templateName" target="templateName" />
        <camunda:in source="templateGroup" target="templateGroup" />
        <camunda:in source="gegevensAanvrager" target="gegevensAanvrager" />
        <camunda:in source="gegevensPartner" target="gegevensPartner" />
        <camunda:in source="communicatievoorkeur" target="communicatievoorkeur" />
        <camunda:in source="verzendadres" target="verzendadres" />
        <camunda:in source="verzenddatum" target="verzenddatum" />
        <camunda:in source="ingetrokkenVia" target="ingetrokkenVia" />
        <camunda:in source="datumIngetrokken" target="datumIngetrokken" />
        <camunda:in source="documentTitle" target="documentTitle" />
        <camunda:in source="documentDescription" target="documentDescription" />
        <camunda:out source="gegenereerdeAloDocumentUrl" target="besluitDocumentUrl" />
        <camunda:inputOutput>
          <camunda:inputParameter name="verzenddatum">${now().toInstant().toString()}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1kjgg64</bpmn:incoming>
      <bpmn:outgoing>Flow_17x9ouf</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="VastleggenBesluitCallActivity" name="Vastleggen besluit" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-vastleggen-besluit">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="besluitDocumentUrl" target="besluitDocumentUrl" />
        <camunda:in source="besluitTypeDescription" target="besluitTypeDescription" />
        <camunda:in source="besluitIngangsdatum" target="besluitIngangsdatum" />
        <camunda:inputOutput>
          <camunda:inputParameter name="besluitTypeDescription">Intrekking</camunda:inputParameter>
          <camunda:inputParameter name="besluitIngangsdatum">${dateTime().toLocalDate().toString()}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17x9ouf</bpmn:incoming>
      <bpmn:outgoing>Flow_1i2w889</bpmn:outgoing>
