  <bpmn:process id="bs-verwerken-intrekking" name="BS verwerken intrekking gehele aanvraag" isExecutable="true">
    <bpmn:userTask id="VastleggenIntrekkingTask" name="Vastleggen intrekking" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="6">
      <bpmn:incoming>Flow_0moiwah</bpmn:incoming>
      <bpmn:outgoing>Flow_1kjgg64</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="IntrekkingGeheleAanvraagOntvangenStartEvent" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_0moiwah</bpmn:outgoing>
