      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1bakwea</bpmn:incoming>
      <bpmn:outgoing>Flow_0f6uucn</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_0f6uucn" sourceRef="UpdateZaakstatusEnInterneStatusCallActivity" targetRef="Event_0bp5bf2" />
    <bpmn:endEvent id="Event_0bp5bf2">
