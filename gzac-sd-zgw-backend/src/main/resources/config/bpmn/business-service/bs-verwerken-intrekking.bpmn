    <bpmn:callActivity id="InformerenBetrokkenenMetBriefCallActivity" name="Informeren betrokkenen met brief" camunda:asyncAfter="true" calledElement="generic-informeren-betrokkenen-met-brief">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in sourceExpression="${execution.getVariable(&#34;gegevensAanvrager&#34;).communicatievoorkeur}" target="communicatievoorkeur" />
        <camunda:in sourceExpression="${execution.getVariable(&#34;gegevensAanvrager&#34;).contactgegevens.email}" target="emailAanwezig" />
