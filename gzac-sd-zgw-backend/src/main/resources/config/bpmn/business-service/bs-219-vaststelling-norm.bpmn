  <bpmn:collaboration id="Collaboration_16wunda">
    <bpmn:participant id="BS219VaststellingNormParticipant" name="BS 219 vaststelling norm" processRef="bs-219-vaststelling-norm" />
    <bpmn:textAnnotation id="TextAnnotation_12olhhh">
      <bpmn:text>ophalen basiskostendelersnormbedrag uit normentabel</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0eo6s3g">
      <bpmn:text>optellen individuele basiskostendelersnormbedragen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0uggn2j">
      <bpmn:text>Input variabelen:
- aantalBelanghebbende
- leeftijdJongsteBelanghebbende
- leeftijdOudsteBelanghebbende
- tenlasteKomendeKinderenAanwezig
- leeftijdPersoonAanvrager
- leeftijdPersoonPartner
- vastgesteldeLeefsituatie
- aantalKostendelers
- vastgesteldeWoonsitutatie
- vastgesteldeLeefsituatie</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0rp2755">
      <bpmn:text>Output variabelen:
- isNormVastgesteld
- datumNormVastgesteld
- isAutomatischVastgesteld
- vastgesteldeBasisnorm
- vastgesteldNormbedrag
- vastgesteldeKostendelersnorm
- vastgesteldeKostendelersfactor
- vastgesteldKostendelersNormbedragIndividueel
- vastgesteldKostendelersNormbedragGezamenlijk</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0odqqt9" associationDirection="None" sourceRef="TextAnnotation_0uggn2j" targetRef="StartEvent_1" />
    <bpmn:association id="Association_0307bxk" associationDirection="None" sourceRef="TextAnnotation_12olhhh" targetRef="BepalenBasisnormbedragTask" />
    <bpmn:association id="Association_1a9wkhs" associationDirection="None" sourceRef="BepalenKostendelersnormbedragGezamelijkTask" targetRef="TextAnnotation_0eo6s3g" />
    <bpmn:association id="Association_0aa16uy" associationDirection="None" sourceRef="TextAnnotation_0rp2755" targetRef="Event_0r47i88" />
  </bpmn:collaboration>
  <bpmn:process id="bs-219-vaststelling-norm" name="BS 219 vaststelling norm" isExecutable="true">
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="ZijnErKostendelersGateway" targetRef="AantalRechthebbendenGateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aantalKostendelers &gt; 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="N2RechthebbendenSequenceFlow" name="2 belanghebbenden" sourceRef="AantalRechthebbendenGateway" targetRef="Gateway_0bgsc8a">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aantalBelanghebbende == 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_01p56tb" sourceRef="Gateway_0256vaw" targetRef="BepalenKostendelersnormbedragGezamelijkTask" />
