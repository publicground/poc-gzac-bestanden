<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1qa4dip" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <bpmn:collaboration id="Collaboration_06duyea">
    <bpmn:participant id="BSBehandelingAanvraagOpnieuwStartenParticipant" name="BS Behandeling aanvraag opnieuw starten" processRef="bs-behandeling-aanvraag-opnieuw-starten" />
    <bpmn:textAnnotation id="TextAnnotation_1y34p41">
      <bpmn:text>nieuw status: In behandeling genomen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1gqtxzn">
      <bpmn:text>het meest recente besluit</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0qwyt0k" associationDirection="None" sourceRef="UpdateZaakstatusEnInterneStatusCallActivity" targetRef="TextAnnotation_1y34p41" />
    <bpmn:association id="Association_1j48zsr" associationDirection="None" sourceRef="OphalenBesluitCallActivity" targetRef="TextAnnotation_1gqtxzn" />
  </bpmn:collaboration>
  <bpmn:process id="bs-behandeling-aanvraag-opnieuw-starten" name="BS Behandeling aanvraag opnieuw starten" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_14auuw1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_14auuw1" sourceRef="StartEvent_1" targetRef="Minimaal1BesluitAanwezigGateway" />
    <bpmn:sequenceFlow id="Flow_11sc6u5" sourceRef="OphalenBesluitCallActivity" targetRef="BesluitZonderVervaldatumGateway" />
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="Nee" sourceRef="BesluitZonderVervaldatumGateway" targetRef="Gateway_1nu3y8b" />
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="BesluitZonderVervaldatumGateway" targetRef="VastleggenVervaldatumEnVervalredenBesluitTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${besluit != null &amp;&amp; (besluit.get("vervaldatum") == null || besluit.get("vervaldatum").isNull())}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0fnfild" sourceRef="VastleggenVervaldatumEnVervalredenBesluitTask" targetRef="Gateway_1nu3y8b" />
    <bpmn:sequenceFlow id="Flow_0om5b9b" sourceRef="Gateway_1nu3y8b" targetRef="Gateway_0ojbgw9" />
    <bpmn:sequenceFlow id="Flow_0oomx3a" sourceRef="UpdateZaakstatusEnInterneStatusCallActivity" targetRef="Event_01txd19" />
    <bpmn:sequenceFlow id="JaSequenceFlow1" name="Ja" sourceRef="Minimaal1BesluitAanwezigGateway" targetRef="OphalenBesluitCallActivity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not empty besluiten and not empty besluiten[besluiten.size() - 1].genomenBesluit}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="NeeSequenceFlow1" name="Nee" sourceRef="Minimaal1BesluitAanwezigGateway" targetRef="Gateway_0ojbgw9" />
    <bpmn:sequenceFlow id="Flow_0uiceo4" sourceRef="Gateway_0ojbgw9" targetRef="UpdateZaakstatusEnInterneStatusCallActivity" />
    <bpmn:callActivity id="OphalenBesluitCallActivity" name="Ophalen besluit" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-ophalen-besluit">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:out source="besluit" target="besluit" />
      </bpmn:extensionElements>
      <bpmn:incoming>JaSequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>Flow_11sc6u5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="BesluitZonderVervaldatumGateway" name="Besluit zonder vervaldatum?" default="NeeSequenceFlow">
      <bpmn:incoming>Flow_11sc6u5</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="VastleggenVervaldatumEnVervalredenBesluitTask" name="vastleggen vervaldatum en vervalreden besluit" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="vervalreden">ingetrokken_overheid</camunda:inputParameter>
          <camunda:inputParameter name="vervaldatum">${dateTime().toLocalDate().toString("yyyy-MM-dd")}</camunda:inputParameter>
          <camunda:inputParameter name="besluitUrl">${besluit.get("url")}</camunda:inputParameter>
          <camunda:outputParameter name="vervalreden">${vervalreden}</camunda:outputParameter>
          <camunda:outputParameter name="vervaldatum">${vervaldatum}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_0fnfild</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0pv19ni">
        <bpmn:targetRef>OpenZaakDataStoreReference</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1nu3y8b">
      <bpmn:incoming>Flow_0fnfild</bpmn:incoming>
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_0om5b9b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataStoreReference id="OpenZaakDataStoreReference" name="Open zaak" />
    <bpmn:exclusiveGateway id="Minimaal1BesluitAanwezigGateway" name="Minimaal 1 besluit aanwezig?" default="NeeSequenceFlow1">
      <bpmn:incoming>Flow_14auuw1</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow1</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0ojbgw9">
      <bpmn:incoming>NeeSequenceFlow1</bpmn:incoming>
      <bpmn:incoming>Flow_0om5b9b</bpmn:incoming>
      <bpmn:outgoing>Flow_0uiceo4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_01txd19">
      <bpmn:incoming>Flow_0oomx3a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="UpdateZaakstatusEnInterneStatusCallActivity" name="Update zaakstatus en interne status" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-update-zaakstatus-en-interne-status-plugin-v2">
      <bpmn:extensionElements>
        <camunda:in sourceExpression="${&#34;In behandeling genomen&#34;}" target="zaakstatus" />
        <camunda:in sourceExpression="${&#34;in-behandeling-genomen&#34;}" target="interneStatus" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0uiceo4</bpmn:incoming>
      <bpmn:outgoing>Flow_0oomx3a</bpmn:outgoing>
    </bpmn:callActivity>
  </bpmn:process>
