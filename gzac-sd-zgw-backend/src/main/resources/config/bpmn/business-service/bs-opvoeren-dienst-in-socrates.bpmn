  <bpmn:collaboration id="Collaboration_0iq8p8w">
    <bpmn:participant id="BSOpvoerenDienstInSocratesParticipant" name="BS opvoeren dienst in Socrates" processRef="bs-opvoeren-dienst-in-socrates" />
    <bpmn:textAnnotation id="TextAnnotation_0ui3kez">
      <bpmn:text>Deze taak zet momenteel de procesvariabele isDienstAlAangemaakt op false, omdat het momenteel niet mogelijk is om te controleren of de dienst al is aangemaakt.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_078esdw" associationDirection="None" sourceRef="ControlerenOpAangemaaktDienstTask" targetRef="TextAnnotation_0ui3kez" />
  </bpmn:collaboration>
  <bpmn:process id="bs-opvoeren-dienst-in-socrates" name="BS opvoeren dienst in Socrates" isExecutable="true">
    <bpmn:startEvent id="Event_0k5a63i">
      <bpmn:outgoing>Flow_1cpu59p</bpmn:outgoing>
