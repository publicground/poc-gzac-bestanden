      <bpmn:outgoing>Flow_1gwb1gb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_00jvnra">
      <bpmn:incoming>Flow_1gwb1gb</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
