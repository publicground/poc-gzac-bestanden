      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ControlerenDienstInSocratesTask" name="controleren dienst in socrates" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="8">
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1mgj6fy</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ControlerenOpAangemaaktDienstTask" name="Controleren&#10;op aangemaakt dienst" camunda:asyncAfter="true" camunda:expression="${execution.setVariable(&#34;isDienstAlAangemaakt&#34;, false)}">
      <bpmn:incoming>Flow_1cpu59p</bpmn:incoming>
      <bpmn:outgoing>Flow_0s6cb04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="OpvoerenDienstInSocratesTask" name="Opvoeren dienst in socrates" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1vq74jn</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0gh0y5q">
