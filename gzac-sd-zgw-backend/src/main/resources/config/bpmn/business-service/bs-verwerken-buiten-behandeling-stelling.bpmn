  </bpmn:collaboration>
  <bpmn:process id="bs-verwerken-buiten-behandeling-stelling" name="BS Verwerken buiten behandeling stelling" isExecutable="true">
    <bpmn:userTask id="VastleggenBuitenBehandelingStellingTask" name="Vastleggen buiten behandeling stelling" camunda:asyncAfter="true" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="4">
      <bpmn:incoming>Flow_0moiwah</bpmn:incoming>
      <bpmn:outgoing>Flow_1uh3dt0</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="IntrekkingGeheleAanvraagOntvangenStartEvent" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_0moiwah</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0moiwah" sourceRef="IntrekkingGeheleAanvraagOntvangenStartEvent" targetRef="VastleggenBuitenBehandelingStellingTask" />
    <bpmn:sequenceFlow id="Flow_0phixeg" sourceRef="VastleggenBesluitCallActivity" targetRef="EmailAanwezigGateway" />
    <bpmn:sequenceFlow id="Flow_04dbrz8" sourceRef="VersturenEmailnotificatieTask" targetRef="Gateway_0oox71j" />
    <bpmn:sequenceFlow id="Flow_1uh3dt0" sourceRef="VastleggenBuitenBehandelingStellingTask" targetRef="GetBesluitDocumentUrlTask" />
    <bpmn:sequenceFlow id="Flow_0v87q46" sourceRef="GetBesluitDocumentUrlTask" targetRef="VastleggenBesluitCallActivity" />
    <bpmn:sequenceFlow id="Flow_1xmwyeq" sourceRef="Gateway_0oox71j" targetRef="UpdateZaakstatusEnInterneStatusCallActivity" />
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="Ja" sourceRef="EmailAanwezigGateway" targetRef="VersturenEmailnotificatieTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${emailAanvrager != null &amp;&amp; emailAanvrager != ""}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Nee" sourceRef="EmailAanwezigGateway" targetRef="Gateway_0oox71j" />
    <bpmn:sequenceFlow id="Flow_1ige7px" sourceRef="UpdateZaakstatusEnInterneStatusCallActivity" targetRef="Event_0bp5bf2" />
    <bpmn:serviceTask id="GetBesluitDocumentUrlTask" name="Get besluit document url " camunda:asyncAfter="true" camunda:expression="${resourceStorageDelegate.getMetadata(tempFileId,&#34;documentUrl&#34;)}" camunda:resultVariable="besluitDocumentUrl">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="tempFileId">${besluit.besluitDocumenten[0].id}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1uh3dt0</bpmn:incoming>
      <bpmn:outgoing>Flow_0v87q46</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="VastleggenBesluitCallActivity" name="Vastleggen besluit" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-vastleggen-besluit">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="besluitDocumentUrl" target="besluitDocumentUrl" />
        <camunda:in source="besluitTypeDescription" target="besluitTypeDescription" />
        <camunda:in source="besluitIngangsdatum" target="besluitIngangsdatum" />
        <camunda:inputOutput>
          <camunda:inputParameter name="besluitTypeDescription">Buiten behandeling gesteld</camunda:inputParameter>
          <camunda:inputParameter name="besluitIngangsdatum">${dateTime().toLocalDate().toString()}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0v87q46</bpmn:incoming>
      <bpmn:outgoing>Flow_0phixeg</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="VersturenEmailnotificatieTask" name="Versturen emailnotificatie" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_04dbrz8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="EmailAanwezigGateway" name="Email aanwezig?" default="JaSequenceFlow">
      <bpmn:incoming>Flow_0phixeg</bpmn:incoming>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0oox71j">
      <bpmn:incoming>Flow_04dbrz8</bpmn:incoming>
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1xmwyeq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="UpdateZaakstatusEnInterneStatusCallActivity" name="Update zaakstatus en interne status" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-update-zaakstatus-en-interne-status-plugin-v2">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="zaakstatus" target="zaakstatus" />
        <camunda:in source="interneStatus" target="interneStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1xmwyeq</bpmn:incoming>
      <bpmn:outgoing>Flow_1ige7px</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="Event_0bp5bf2">
      <bpmn:incoming>Flow_1ige7px</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
