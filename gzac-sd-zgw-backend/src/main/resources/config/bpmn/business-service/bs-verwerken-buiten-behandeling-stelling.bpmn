  <bpmn:collaboration id="Collaboration_1l94hsy">
    <bpmn:participant id="BSVerwerkenBuitenBehandelingStellingParticipant" name="BS Verwerken buiten behandeling stelling" processRef="bs-verwerken-buiten-behandeling-stelling" />
    <bpmn:textAnnotation id="TextAnnotation_0bed85w">
      <bpmn:text>Notificatie: Nieuw document op portaal</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_03cyoxg">
      <bpmn:text>Zaak en Interne status: Beslist</bpmn:text>
    </bpmn:textAnnotation>
