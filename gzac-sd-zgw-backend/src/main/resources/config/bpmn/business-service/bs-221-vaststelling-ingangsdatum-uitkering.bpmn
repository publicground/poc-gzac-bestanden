<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0vbmivt" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:collaboration id="Collaboration_0chfsgr">
    <bpmn:participant id="BS221VaststellingIngangsdatumUitkeringParticipant" name="BS 221 vaststelling ingangsdatum uitkering" processRef="bs-221-vaststelling-ingangsdatum-uitkering" />
    <bpmn:textAnnotation id="TextAnnotation_002huec">
      <bpmn:text>Input variabelen:
- ingangsdatumUitkeringVastgesteld
- datumMeldingVastgesteld
- datumAanvraagVastgesteld
- vastgesteldeIngangsdatumUitkering
- vastgesteldeDatumOntstaanRecht
- datumVaststellingIngangsdatumUitkering
- toelichtingVaststellingIngangsdatumConsulent

- handmatigVaststellen

- datumMelding
- datumAanvraag
- verzochteIngangsdatum
- redenVerzochteIngangsdatum
- redenAanvraag
- datumLaatsteSalaris
- datumUitkeringGestopt
- datumAlimentatieVerlaagd
- datumOpleidingStudieAfgerondGestopt
- datumRelatieVerbroken
- datumEigenBedrijfGestopt
- datumWeekgeldCOAGestopt
- datumlaatsteDagDetentie</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0moytxr">
      <bpmn:text>Output variabelen:
- ingangsdatumUitkeringVastgesteld
- datumMeldingVastgesteld
- datumAanvraagVastgesteld
- vastgesteldeIngangsdatumUitkering
- vastgesteldeDatumOntstaanRecht
- datumVaststellingIngangsdatumUitkering
- toelichtingVaststellingIngangsdatumConsulent</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ch5x0a">
      <bpmn:text>te tonen:
- meldingsdatum
- aanvraagdatum
- verzochte ingangsdatum (indien van toepassing) 
- reden verzochte ingangsdatum (indien van toepassing) 
- reden aanvraag 
- datum ontstaan recht (indien van toepassing) 

invoer:
- vastgestelde ingangsdatum (prefillen voorgestelde ingangsdatum. Als eerder vastgesteld, dan vastgestelde ingangsdatum)
- aangepaste meldingsdatum
- aangepaste aanvraagdatum
- aangepaste datum ontstaan recht 
- toelichting consulent</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1fpohmy" associationDirection="None" sourceRef="StartEvent_1" targetRef="TextAnnotation_002huec" />
    <bpmn:association id="Association_1315g0q" associationDirection="None" sourceRef="Event_09ho9fa" targetRef="TextAnnotation_0moytxr" />
    <bpmn:textAnnotation id="TextAnnotation_1jqd0qe">
      <bpmn:text>aan te passen zaak properties:
- startdatum
- datum uiterlijke afdoening</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_10wwuwv" associationDirection="None" sourceRef="AanpassenZaakProperiesTask" targetRef="TextAnnotation_1jqd0qe" />
  </bpmn:collaboration>
  <bpmn:process id="bs-221-vaststelling-ingangsdatum-uitkering" name="BS 221 Vaststelling Ingangdatum" isExecutable="true" camunda:historyTimeToLive="10">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1hbned3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_14kg0xa" sourceRef="BepalenHandmatigeBeoordelingTask" targetRef="HandmatigeBeoordelingGateway" />
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="HandmatigeBeoordelingGateway" targetRef="VaststellenIngangsdatumTask" />
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="Nee" sourceRef="HandmatigeBeoordelingGateway" targetRef="Gateway_0hoatha">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!handmatigeBeoordeling}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1lhpmsh" sourceRef="Gateway_0hoatha" targetRef="BepalenVastgesteldeIngangsdatumTask" />
    <bpmn:sequenceFlow id="Flow_16kf7dd" sourceRef="BepalenVastgesteldeIngangsdatumTask" targetRef="Event_09ho9fa" />
