    <bpmn:businessRuleTask id="BepalenVoorgesteldeIngangsdatumTask" name="Bepalen voorgestelde ingangsdatum" camunda:asyncAfter="true" camunda:resultVariable="resultaat" camunda:decisionRef="bs-221-bepalen-voorgestelde-ingangsdatum" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="voorgesteldeIngangsdatum">${resultaat.voorgesteldeIngangsdatum}</camunda:outputParameter>
          <camunda:outputParameter name="welkeDatumGebruikt">${resultaat.welkeDatumGebruikt}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hbned3</bpmn:incoming>
      <bpmn:outgoing>Flow_0lrsvrx</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0lrsvrx" sourceRef="BepalenVoorgesteldeIngangsdatumTask" targetRef="BepalenHandmatigeBeoordelingTask" />
    <bpmn:businessRuleTask id="BepalenHandmatigeBeoordelingTask" name="Bepalen handmatige beoordeling" camunda:asyncAfter="true" camunda:resultVariable="handmatigeBeoordeling" camunda:decisionRef="bs-221-bepalen-handmatige-beoordeling" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_0lrsvrx</bpmn:incoming>
      <bpmn:outgoing>Flow_14kg0xa</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0jdke0b" name="Nee" sourceRef="AanvraagdatumGewijzigdGateway" targetRef="Gateway_1w28284" />
    <bpmn:sequenceFlow id="Flow_040t9i4" sourceRef="Gateway_1w28284" targetRef="Gateway_0hoatha" />
    <bpmn:exclusiveGateway id="HandmatigeBeoordelingGateway" name="handmatige beoordeling?" default="JaSequenceFlow">
      <bpmn:incoming>Flow_14kg0xa</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="AanvraagdatumGewijzigdGateway" name="aanvraagdatum gewijzigd?" default="Flow_0jdke0b">
      <bpmn:incoming>Flow_1ism284</bpmn:incoming>
      <bpmn:outgoing>Flow_0jdke0b</bpmn:outgoing>
      <bpmn:outgoing>Flow_0wauttt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="VaststellenIngangsdatumTask" name="Vaststellen Ingangsdatum" camunda:asyncAfter="true" camunda:formKey="" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="32">
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1ism284</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0hoatha">
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:incoming>Flow_040t9i4</bpmn:incoming>
      <bpmn:outgoing>Flow_1lhpmsh</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_09ho9fa">
      <bpmn:incoming>Flow_16kf7dd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_1w28284">
      <bpmn:incoming>Flow_0jdke0b</bpmn:incoming>
      <bpmn:incoming>Flow_1fi07gv</bpmn:incoming>
      <bpmn:outgoing>Flow_040t9i4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0wauttt" name="Ja" sourceRef="AanvraagdatumGewijzigdGateway" targetRef="AanpassenZaakProperiesTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${wijzigAanvraagdatum}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1fi07gv" sourceRef="AanpassenZaakProperiesTask" targetRef="Gateway_1w28284" />
    <bpmn:serviceTask id="AanpassenZaakProperiesTask" name="Aanpassen zaak properies" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>Flow_0wauttt</bpmn:incoming>
      <bpmn:outgoing>Flow_1fi07gv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BepalenVastgesteldeIngangsdatumTask" name="Bepalen vastgestelde ingangsdatum" camunda:asyncAfter="true" camunda:resultVariable="vastgesteldeIngangsdatum" camunda:decisionRef="bs-221-bepalen-vastgestelde-ingangsdatum" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_1lhpmsh</bpmn:incoming>
      <bpmn:outgoing>Flow_16kf7dd</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:association id="Association_13ldrjb" associationDirection="None" sourceRef="VaststellenIngangsdatumTask" targetRef="TextAnnotation_0ch5x0a" />
  </bpmn:process>
