<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0mslttl" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:collaboration id="Collaboration_0a5o8ri">
    <bpmn:participant id="BS213VaststellingVerblijfstitelParticipant" name="BS 213 vaststelling verblijfstitel" processRef="bs-213-vaststelling-verblijfstitel" />
    <bpmn:textAnnotation id="TextAnnotation_1r2hgg0">
      <bpmn:text>Output variabelen
- verblijfstitelVastgesteld
- datumVerblijfstitelVastgesteld
- verblijfstitel
- rechtOpBijstand
- toelichtingConsulent</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1iuqb0r">
      <bpmn:text>Consulent voert handmatig de verblijfstitel in

te tonen informatie:
- In aanvraag opgegeven nationaliteit
- In aanvraag opgegeven activiteiten om verblijfsvergunning te krijgen / te houden
- Uit BRP opgehaalde nationaliteit(en) (per aanvraagdatum)
- Uit BRP opgehaalde verblijfstitel (per aanvraagdatum)

In te voeren informatie:
- vastgestelde verblijfstitel
- Indien verblijfstitel = 30 of 38, dan of er sprake is van gemeenschapsrecht (J/N)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ikcykd" associationDirection="None" sourceRef="Event_0d91tij" targetRef="TextAnnotation_1r2hgg0" />
    <bpmn:textAnnotation id="TextAnnotation_0uggn2j">
      <bpmn:text>Input variabelen:
- verblijfstitelVastgesteld
- datumVerblijfstitelVastgesteld
- handmatigVaststellen

- nationaliteitVerblijfstatusAanvraag
- actiesVerblijfstatus
- nationaliteitenBrp
- verblijfstitelBrp</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0xdc937" associationDirection="None" sourceRef="StartEvent_1" targetRef="TextAnnotation_0uggn2j" />
  </bpmn:collaboration>
  <bpmn:process id="bs-213-vaststelling-verblijfstitel" name="BS 213 vaststelling verblijfstitel" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0jw5bt5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0jw5bt5" sourceRef="StartEvent_1" targetRef="BepalenGegevensKwalitatiefVoldoendeAanwezigTask" />
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="Nee" sourceRef="GegevensKwalitatiefVoldoendeAanwezigGateway" targetRef="BepalenHandmatigeBeoordelingTask" />
    <bpmn:sequenceFlow id="Flow_17g5evr" sourceRef="BepalenHandmatigeBeoordelingTask" targetRef="HandmatigeBeoordelingNodigGateway" />
    <bpmn:sequenceFlow id="Flow_0iti4m8" sourceRef="BepalenGegevensKwalitatiefVoldoendeAanwezigTask" targetRef="GegevensKwalitatiefVoldoendeAanwezigGateway" />
    <bpmn:sequenceFlow id="Flow_1kzf47i" sourceRef="TaakTitelTask" targetRef="Gateway_0dos2vo" />
    <bpmn:sequenceFlow id="NeeSequenceFlow1" name="Nee" sourceRef="HandmatigeBeoordelingNodigGateway" targetRef="Gateway_0dos2vo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${handmatigBeoordelen == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11nj72e" sourceRef="Gateway_0dos2vo" targetRef="BepalenVerblijfstitelRechthebbendTask" />
    <bpmn:sequenceFlow id="Flow_005sqfg" sourceRef="BepalenVerblijfstitelRechthebbendTask" targetRef="Gateway_0aoybat" />
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="HandmatigeBeoordelingNodigGateway" targetRef="TaakTitelTask" />
    <bpmn:sequenceFlow id="JaSequenceFlow1" name="Ja" sourceRef="GegevensKwalitatiefVoldoendeAanwezigGateway" targetRef="Gateway_0aoybat">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kwalitatiefVoldoendeGegevens}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1yu2fu9" sourceRef="Gateway_0aoybat" targetRef="Event_0d91tij" />
    <bpmn:businessRuleTask id="BepalenGegevensKwalitatiefVoldoendeAanwezigTask" name="Bepalen gegevens kwalitatief voldoende aanwezig" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:resultVariable="resultVariable" camunda:decisionRef="bs-213-kwalitatief-voldoende-aanwezig" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="handmatigVaststellen">${resultVariable.handmatigVaststellen}</camunda:outputParameter>
          <camunda:outputParameter name="kwalitatiefVoldoendeGegevens">${resultVariable.kwalitatiefVoldoendeGegevens}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0jw5bt5</bpmn:incoming>
      <bpmn:outgoing>Flow_0iti4m8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GegevensKwalitatiefVoldoendeAanwezigGateway" name="Gegevens kwalitatief voldoende aanwezig?" default="NeeSequenceFlow">
      <bpmn:incoming>Flow_0iti4m8</bpmn:incoming>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="BepalenHandmatigeBeoordelingTask" name="Bepalen handmatige beoordeling" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:resultVariable="result" camunda:decisionRef="bs-213-bepalen-handmatige-beoordeling" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="handmatigBeoordelen">${result.handmatigBeoordelen}</camunda:outputParameter>
          <camunda:outputParameter name="nationaliteitNederlands">${result.nationaliteitNederlands}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_17g5evr</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="HandmatigeBeoordelingNodigGateway" name="Handmatige beoordeling nodig?" default="JaSequenceFlow">
      <bpmn:incoming>Flow_17g5evr</bpmn:incoming>
      <bpmn:outgoing>NeeSequenceFlow1</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0dos2vo">
      <bpmn:incoming>Flow_1kzf47i</bpmn:incoming>
      <bpmn:incoming>NeeSequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>Flow_11nj72e</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="BepalenVerblijfstitelRechthebbendTask" name="Bepalen verblijfstitel&#10;rechthebbend" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:resultVariable="rechtOpBijstand" camunda:decisionRef="bs-213-bepalen-verblijfstitel-rechthebbend" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="verblijfstitel.code">${verblijfstitel.code}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11nj72e</bpmn:incoming>
      <bpmn:outgoing>Flow_005sqfg</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_0aoybat">
      <bpmn:incoming>JaSequenceFlow1</bpmn:incoming>
      <bpmn:incoming>Flow_005sqfg</bpmn:incoming>
      <bpmn:outgoing>Flow_1yu2fu9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_0d91tij">
      <bpmn:incoming>Flow_1yu2fu9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="TaakTitelTask" name="${taakTitel}" camunda:asyncAfter="true" camunda:formRef="stelAdresVast" camunda:formRefBinding="latest" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="38">
      <bpmn:extensionElements />
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1kzf47i</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:association id="Association_1ppl8uq" associationDirection="None" sourceRef="TaakTitelTask" targetRef="TextAnnotation_1iuqb0r" />
  </bpmn:process>
