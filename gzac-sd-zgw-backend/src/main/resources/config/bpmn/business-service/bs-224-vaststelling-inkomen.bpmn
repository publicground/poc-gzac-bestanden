    <bpmn:sequenceFlow id="Flow_1ml5mdf" sourceRef="VrijstellingenTitelTask" targetRef="Gateway_1lp00lf" />
    <bpmn:userTask id="TaakTitelTask" name="${taakTitel}" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="20">
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_0qlj8m4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="InkomstenUitArbeidGateway" name="inkomsten uit arbeid?" default="NeeSequenceFlow1">
      <bpmn:incoming>Flow_0s04co5</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow1</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="VrijstellingenTitelTask" name="${vrijstellingenTitel}" camunda:asyncAfter="true" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="18">
      <bpmn:incoming>JaSequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>Flow_1ml5mdf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1lp00lf">
      <bpmn:incoming>NeeSequenceFlow1</bpmn:incoming>
      <bpmn:incoming>Flow_1ml5mdf</bpmn:incoming>
      <bpmn:outgoing>Flow_0x9e612</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_00v09el">
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:incoming>Flow_1vbtjyf</bpmn:incoming>
      <bpmn:incoming>Flow_0x9e612</bpmn:incoming>
      <bpmn:outgoing>Flow_1r1k6sj</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IsErInkomstenUitArbeidTask" name="Is er inkomsten uit arbeid" camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="isInkomstenUitArbeid">
      <bpmn:incoming>Flow_0qlj8m4</bpmn:incoming>
      <bpmn:outgoing>Flow_0s04co5</bpmn:outgoing>
      <bpmn:script>var isInkomstenUitArbeid = false;
var isInkomstenUitLoondienst = false;
var isInkomstenuitOnderneming = false;
var isInkomstenUitHobbyOfStage = false;

var arbeid = execution.getVariable("arbeid");
var onderneming = execution.getVariable("onderneming");
var overigeInkomsten = execution.getVariable("overigeInkomsten");

if (arbeid?.inkomstenComponenten) {
    isInkomstenUitLoondienst = arbeid.inkomstenComponenten.some(component =&gt; (component.primairInkomstencomponentType?.code === "3" || component.primairInkomstencomponentType?.code === "7"));
// - Bekijk of er een inkomsten component met code 3 of 7 aanwezig is
}

if (onderneming?.inkomstenComponenten) {
    isInkomstenuitOnderneming = onderneming.inkomstenComponenten.some(component =&gt; (component.primairInkomstencomponentType?.code === "9"));
// - Bekijk of er een inkomsten component met code 9 aanwezig is
}

if (overigeInkomsten?.inkomstenComponenten) {
    isInkomstenUitHobbyOfStage = overigeInkomsten.inkomstenComponenten.some(component =&gt; (component.primairInkomstencomponentType?.code === "8"));
// - Bekijk of er een inkomsten component met code 8 aanwezig is
}

isInkomstenUitArbeid = (isInkomstenUitLoondienst || isInkomstenUitHobbyOfStage || isInkomstenuitOnderneming);
isInkomstenUitArbeid;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0s04co5" sourceRef="IsErInkomstenUitArbeidTask" targetRef="InkomstenUitArbeidGateway" />
    <bpmn:endEvent id="InkomenVastgesteldEndEvent" name="inkomen vastgesteld">
      <bpmn:incoming>Flow_1r1k6sj</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
