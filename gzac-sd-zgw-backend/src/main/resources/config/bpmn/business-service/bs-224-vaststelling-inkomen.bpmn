  <bpmn:collaboration id="Collaboration_1oh4i48">
    <bpmn:participant id="Bs224VaststellingInkomenParticipant" name="bs 224 vaststelling inkomen" processRef="bs-224-vaststelling-inkomen" />
    <bpmn:textAnnotation id="TextAnnotation_0n8bz0d">
      <bpmn:text>gebruiker selecteert vrijlatingen [naam + % + ingangsdatum]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1jl9ash" associationDirection="None" sourceRef="VrijstellingenTitelTask" targetRef="TextAnnotation_0n8bz0d" />
  </bpmn:collaboration>
  <bpmn:process id="bs-224-vaststelling-inkomen" name="BS 224 vaststelling inkomen" isExecutable="true">
    <bpmn:startEvent id="Event_0cc0ha5">
      <bpmn:outgoing>Flow_0e52s74</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="BepalenInformatieKwalitatiefEnActueelAanwezigTask" name="Bepalen informatie kwalitatief en actueel aanwezig" camunda:asyncAfter="true" camunda:decisionRef="BS-224-KwalitatiefVoldoendeAanwezig">
      <bpmn:incoming>Flow_0e52s74</bpmn:incoming>
      <bpmn:outgoing>Flow_0y7mncq</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="InformatieActueelEnKwalitatiefBeschikbaarGateway" name="Informatie actueel en kwalitatief beschikbaar?" default="JaSequenceFlow">
      <bpmn:incoming>Flow_0y7mncq</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>Flow_1vbtjyf</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0e52s74" sourceRef="Event_0cc0ha5" targetRef="BepalenInformatieKwalitatiefEnActueelAanwezigTask" />
    <bpmn:sequenceFlow id="Flow_0y7mncq" sourceRef="BepalenInformatieKwalitatiefEnActueelAanwezigTask" targetRef="InformatieActueelEnKwalitatiefBeschikbaarGateway" />
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="InformatieActueelEnKwalitatiefBeschikbaarGateway" targetRef="Gateway_00v09el" />
