      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1r1k6sj" sourceRef="Gateway_00v09el" targetRef="InkomenVastgesteldEndEvent" />
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="Nee" sourceRef="InformatieActueelEnKwalitatiefBeschikbaarGateway" targetRef="TaakTitelTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0qlj8m4" sourceRef="TaakTitelTask" targetRef="IsErInkomstenUitArbeidTask" />
