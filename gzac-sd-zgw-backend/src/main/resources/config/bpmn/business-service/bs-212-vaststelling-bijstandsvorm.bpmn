- vastgesteldeVermogenscomponenten
- vastgesteldeLeefsituatie</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1r2hgg0">
      <bpmn:text>output variabelen
- IsBijstandsvormVastgesteld
- datumBijstandsvormVastgesteld
- vastgesteldeBijstandsvorm
- automatischVastgesteld</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1i84dzl" associationDirection="None" sourceRef="TextAnnotation_0uggn2j" targetRef="StartEvent_1" />
    <bpmn:association id="Association_0ikcykd" associationDirection="None" sourceRef="Event_0d91tij" targetRef="TextAnnotation_1r2hgg0" />
  </bpmn:collaboration>
  <bpmn:process id="bs-212-vaststelling-bijstandsvorm" name="BS 212 Vaststelling bijstandsvorm" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0b5t2pf</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_17g5evr" sourceRef="BS-211-persoonHandmatigVaststellen" targetRef="Event_0d91tij" />
    <bpmn:sequenceFlow id="Flow_0b5t2pf" sourceRef="StartEvent_1" targetRef="BerekenVermogen1018Task" />
    <bpmn:sequenceFlow id="Flow_1p85euf" sourceRef="BerekenVermogen1018Task" targetRef="BerekenHyptheek17Task" />
    <bpmn:scriptTask id="BerekenVermogen1018Task" name="bereken beleenbaarVermogen (10 &#38; 18)" camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="beleenbaarVermogen">
      <bpmn:incoming>Flow_0b5t2pf</bpmn:incoming>
      <bpmn:outgoing>Flow_1p85euf</bpmn:outgoing>
      <bpmn:script>var beleenbaarVermogen = 0;

var vermogenGroepen = execution.getVariable("vermogenGroepen");

if (vermogenGroepen !== null) {
    beleenbaarVermogen = vermogenGroepen.map(groep =&gt; groep.componenten || []).flat().filter(component =&gt; (component.soortVermogenscomponent?.code === "10" || component.soortVermogenscomponent?.code === "18")).reduce((sum, c) =&gt; sum + (c.waarde || 0), 0);;
// - Aandeel onverdeelde boedel (10)
// - Aanspraak op erfenis binnen zes maanden (18)
}

beleenbaarVermogen;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_0d91tij">
      <bpmn:incoming>Flow_17g5evr</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="BS-211-persoonHandmatigVaststellen" name="Bepalen bijstandsvorm" camunda:asyncAfter="true" camunda:resultVariable="verstrekkingsvorm" camunda:decisionRef="bs-212-bepalen-bijstandsvorm" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="beleenbaarVermogen">${beleenbaarVermogen}</camunda:inputParameter>
          <camunda:inputParameter name="overwaarde">${overwaarde}</camunda:inputParameter>
          <camunda:inputParameter name="dossierType">${dossierType}</camunda:inputParameter>
          <camunda:inputParameter name="totaalVermogen">${totaalVermogen}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0kgvxkc</bpmn:incoming>
      <bpmn:outgoing>Flow_17g5evr</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="BerekenHyptheek17Task" name="bereken overwaarde (1, 15 &#38; 17)" camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="overwaarde">
      <bpmn:incoming>Flow_1p85euf</bpmn:incoming>
      <bpmn:outgoing>Flow_0kgvxkc</bpmn:outgoing>
      <bpmn:script>var eigenWoning = 0;
var hypotheek = 0;
var spaarBelegging = 0;
var vermogenGroepen = execution.getVariable("vermogenGroepen");

if (vermogenGroepen !== null) {
    eigenWoning  = vermogenGroepen.map(groep =&gt; groep.componenten || []).flat().filter(component =&gt; component.soortVermogenscomponent?.code === "1").reduce((sum, c) =&gt; sum + (c.waarde || 0), 0);

    hypotheek = vermogenGroepen.map(groep =&gt; groep.componenten || []).flat().filter(component =&gt; component.soortVermogenscomponent?.code === "17").reduce((sum, c) =&gt; sum + (c.waarde || 0), 0);

    spaarBelegging = vermogenGroepen.map(groep =&gt; groep.componenten || []).flat().filter(component =&gt; component.soortVermogenscomponent?.code === "15").reduce((sum, c) =&gt; sum + (c.waarde || 0), 0);

// - Eigen woning (huis/woonschip/woonwagen in eigendom) (1)
// - Levensverzekering/belegging gekoppeld aan hypotheek (15)
// - Hypotheek eigen woning (17)
}

eigenWoning + spaarBelegging - hypotheek;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0kgvxkc" sourceRef="BerekenHyptheek17Task" targetRef="BS-211-persoonHandmatigVaststellen" />
  </bpmn:process>
