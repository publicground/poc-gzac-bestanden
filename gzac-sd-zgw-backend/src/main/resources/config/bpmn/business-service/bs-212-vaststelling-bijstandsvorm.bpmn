  <bpmn:collaboration id="Collaboration_15rska3">
    <bpmn:participant id="Participant_0s7yz7n" name="bs 212 vaststelling bijstandsvorm" processRef="bs-212-vaststelling-bijstandsvorm" />
    <bpmn:textAnnotation id="TextAnnotation_0uggn2j">
      <bpmn:text>input variabelen
- IsBijstandsvormVastgesteld
- datumBijstandsvormVastgesteld
