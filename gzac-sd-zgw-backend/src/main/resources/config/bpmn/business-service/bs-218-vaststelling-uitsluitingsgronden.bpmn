<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_09tielq" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:collaboration id="Collaboration_03g1h5j" isClosed="false">
    <bpmn:participant id="BS218VaststellinguitslUitingsgrondenParticipant" name="BS 218vaststelling uitsluitingsgronden" processRef="bs-218-vaststelling-uitsluitingsgronden" />
    <bpmn:textAnnotation id="TextAnnotation_1ijzg9w">
      <bpmn:text>output variabelen
Array van uitsluitingsgronden
- uitsluitingsgrond (String)
- onderbouwing (String)
- signalering (Boolean)
- toelichting (String)
- vanToepassing (Boolean)
- brontype = 2 (Professional)
- vastleggingsdatum = sysdate
- geimplementeerd

-handmatig of automatisch vastgesteld</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_06tut7p">
      <bpmn:text>input variabelen
- BSN
- brongegevens
- vastgesteldegegevens
- aanvraaggegevens
- handmatigVaststellen</bpmn:text>
    </bpmn:textAnnotation>
