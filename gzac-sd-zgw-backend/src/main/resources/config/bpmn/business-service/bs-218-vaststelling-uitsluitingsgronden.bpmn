    <bpmn:businessRuleTask id="BepalenGegevensKwalitatiefVoldoendeAanwezigTask" name="bepalen gegevens kwalitatief voldoende aanwezig" camunda:asyncAfter="true" implementation="##unspecified" camunda:resultVariable="result" camunda:decisionRef="bs-218-kwalitatief-voldoende-aanwezig" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
