    <bpmn:sequenceFlow id="Flow_1oznkv3" sourceRef="UitsluitingsgrondenTask" targetRef="Activity_02rta47" />
    <bpmn:sequenceFlow id="Flow_190i71p" sourceRef="BepalenGegevensKwalitatiefVoldoendeAanwezigTask" targetRef="GegevensKwalitatiefVoldoendeAanwezigGateway" />
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="GegevensKwalitatiefVoldoendeAanwezigGateway" targetRef="Gateway_1uoz24h" />
    <bpmn:sequenceFlow id="JaSequenceFlow1" name="Ja" sourceRef="IsErEenSignaleringGateway" targetRef="TaakTitelTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isSignalering || handmatigVaststellen}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="NeeSequenceFlow1" name="Nee" sourceRef="IsErEenSignaleringGateway" targetRef="Gateway_10q3d12" />
    <bpmn:sequenceFlow id="Flow_1gsxosf" sourceRef="Gateway_1uoz24h" targetRef="Event_1phfh4d" />
    <bpmn:sequenceFlow id="Flow_1hqu3cc" sourceRef="Gateway_10q3d12" targetRef="Gateway_1uoz24h" />
    <bpmn:sequenceFlow id="Flow_0ty8y0a" sourceRef="TaakTitelTask" targetRef="Gateway_10q3d12" />
    <bpmn:sequenceFlow id="Flow_1krsaam" sourceRef="Activity_02rta47" targetRef="IsErEenSignaleringGateway" />
    <bpmn:scriptTask id="Activity_02rta47" name="Zoek naar signalering" camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="isSignalering">
      <bpmn:incoming>Flow_1oznkv3</bpmn:incoming>
      <bpmn:outgoing>Flow_1krsaam</bpmn:outgoing>
      <bpmn:script>var isSignalering = false;
var uitsluitingsgronden= execution.getVariable("uitsluitingsgronden");
isSignalering = uitsluitingsgronden.some(uitsluiting =&gt; uitsluiting.signalering === true);

isSignalering;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IsErEenSignaleringGateway" name="Is er een signalering&#10;of handmatig vaststellen gewenst?" default="NeeSequenceFlow1">
      <bpmn:incoming>Flow_1krsaam</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow1</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1phfh4d">
