<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1qrvd0d" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.42.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:collaboration id="Collaboration_1w2exja">
    <bpmn:participant id="IOAWInitialiserenDossierParticipant" name="IOAW: Initialiseren dossier" processRef="ioaw-initialiseren-dossier" />
  </bpmn:collaboration>
  <bpmn:process id="ioaw-initialiseren-dossier" name="IOAW: Initialiseren dossier" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0t9v0ia</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0t9v0ia" sourceRef="StartEvent_1" targetRef="ZetOntvangsdatumInDocumentTask" />
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="Nee" sourceRef="HandmatigAangemaaktGateway" targetRef="OpslaanOFReferentieInDocumentTask" />
    <bpmn:sequenceFlow id="Flow_0mggdrb" sourceRef="ZetOntvangsdatumInDocumentTask" targetRef="OpslaanZaakindentificatieInDocumentTask" />
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="HandmatigAangemaaktGateway" targetRef="VastleggenRoltypeTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable("isDossierHandmatigAangemaakt") == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0szi8sx" sourceRef="VastleggenRoltypeTask" targetRef="Gateway_0imskjq" />
    <bpmn:sequenceFlow id="Flow_1y6wdbw" sourceRef="Gateway_0imskjq" targetRef="MapAanvraaggegevensTask" />
    <bpmn:sequenceFlow id="Flow_0mwtho6" sourceRef="MapAanvraaggegevensTask" targetRef="KopierenGegevensVanuitAanvraagTask" />
    <bpmn:serviceTask id="ZetOntvangsdatumInDocumentTask" name="Zet ontvangsdatum in document" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVanuitAanvraag/startDatum&#34;, now().toInstant().toString())}">
      <bpmn:incoming>Flow_0t9v0ia</bpmn:incoming>
      <bpmn:outgoing>Flow_0mggdrb</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="OpslaanZaakindentificatieInDocumentTask" name="Opslaan zaak-indentificatie in document" camunda:asyncAfter="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/openzaak/identificatie&#34;, zaakIdentificatie)}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="zaakIdentificatie">${valueResolverDelegateService.resolveValue(execution, "zaak:identificatie")}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0mggdrb</bpmn:incoming>
      <bpmn:outgoing>Flow_0idl5rn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0idl5rn" sourceRef="OpslaanZaakindentificatieInDocumentTask" targetRef="HandmatigAangemaaktGateway" />
    <bpmn:sequenceFlow id="Flow_1inunyn" sourceRef="OpslaanOFReferentieInDocumentTask" targetRef="Gateway_0imskjq" />
    <bpmn:exclusiveGateway id="HandmatigAangemaaktGateway" name="Handmatig aangemaakt?" default="NeeSequenceFlow">
      <bpmn:incoming>Flow_0idl5rn</bpmn:incoming>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OpslaanOFReferentieInDocumentTask" name="Opslaan OF referentie in document" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/publicReference&#34;, publicReference)}">
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1inunyn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0imskjq">
      <bpmn:incoming>Flow_0szi8sx</bpmn:incoming>
      <bpmn:incoming>Flow_1inunyn</bpmn:incoming>
      <bpmn:outgoing>Flow_1y6wdbw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="MapAanvraaggegevensTask" name="Map aanvraaggegevens" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>Flow_1y6wdbw</bpmn:incoming>
      <bpmn:outgoing>Flow_0mwtho6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="KopierenGegevensVanuitAanvraagTask" name="Kopieren gegevens vanuit aanvraag" camunda:asyncAfter="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling&#34;, valueResolverDelegateService.resolveValue(execution, &#34;doc:/gegevensVanuitAanvraag&#34;))}">
      <bpmn:incoming>Flow_0mwtho6</bpmn:incoming>
      <bpmn:outgoing>Flow_10t5kf6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="VastleggenRoltypeTask" name="vastleggen roltype" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_0szi8sx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0f8uun2">
      <bpmn:incoming>NeeSequenceFlow1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_1euw173">
      <bpmn:incoming>Flow_00janls</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="VerkorteAanvraagprocedureGateway" name="Verkorte aanvraagprocedure?" default="NeeSequenceFlow1">
      <bpmn:incoming>Flow_10t5kf6</bpmn:incoming>
      <bpmn:outgoing>NeeSequenceFlow1</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SetTagVerkorteAanvraagprocedureTask" name="Set tag &#39;Verkorte aanvraagprocedure&#39;" camunda:asyncAfter="true" camunda:expression="${documentDelegateService.addCaseTag(execution,&#34;verkorte-aanvraagprocedure&#34;)}">
      <bpmn:incoming>JaSequenceFlow1</bpmn:incoming>
      <bpmn:outgoing>Flow_00janls</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="NeeSequenceFlow1" name="Nee" sourceRef="VerkorteAanvraagprocedureGateway" targetRef="Event_0f8uun2" />
    <bpmn:sequenceFlow id="Flow_00janls" sourceRef="SetTagVerkorteAanvraagprocedureTask" targetRef="Event_1euw173" />
    <bpmn:sequenceFlow id="JaSequenceFlow1" name="Ja" sourceRef="VerkorteAanvraagprocedureGateway" targetRef="SetTagVerkorteAanvraagprocedureTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/redenAanvraag/aanvullendeGegevens/eerderInkomen/terugkeerder") == 'JA'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10t5kf6" sourceRef="KopierenGegevensVanuitAanvraagTask" targetRef="VerkorteAanvraagprocedureGateway" />
  </bpmn:process>
