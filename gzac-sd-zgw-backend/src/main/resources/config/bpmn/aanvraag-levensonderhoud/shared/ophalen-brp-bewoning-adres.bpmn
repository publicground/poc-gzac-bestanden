      <bpmn:scriptTask id="ToevoegenBewoningenTask" name="Toevoegen bewoningen" camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="bewoningen">
        <bpmn:incoming>Flow_0mt3oop</bpmn:incoming>
        <bpmn:outgoing>Flow_1pvwh5c</bpmn:outgoing>
        <bpmn:script>var bewoningen = execution.getVariable("bewoningen");
var bewoningenPv = execution.getVariable("bewoningenPv");

function mergeArrays(array1, array2) {
    array1 = array1 instanceof java.util.List ? Java.from(array1) : [];
    array2 = array2 instanceof java.util.List ? Java.from(array2) : [];

    var mergedArray = array1.concat(array2);

    return java.util.Arrays.asList(mergedArray);
}

mergeArrays(bewoningen, bewoningenPv);</bpmn:script>
      </bpmn:scriptTask>
