    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10kqm58" sourceRef="Gateway_0j09hyd" targetRef="AdresIsWelOfNietEenAdresMetVeelBewonersEndEvent" />
    <bpmn:scriptTask id="VergelijkInputAdresMetLijstTask" name="Vergelijk input adres met lijst" camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="matchResult">
      <bpmn:incoming>Flow_02ulk4l</bpmn:incoming>
      <bpmn:outgoing>Flow_1j4l5qs</bpmn:outgoing>
      <bpmn:script>var LinkedHashMap = Java.type("java.util.LinkedHashMap");

function findVeelBewonersMatch() {
  var javaAdreslijst = execution.getVariable("adreslijst");
  var javaAdresAanvrager = execution.getVariable("verblijfadres");

  var resultMap = new LinkedHashMap();
  resultMap.put("veelBewoners", false);
  resultMap.put("veelBewonersAdres", null);

  if (!(javaAdresAanvrager instanceof java.util.Map) ||
    !(javaAdreslijst instanceof java.util.List) ||
    javaAdreslijst.size() === 0) {
    return resultMap;
  }

  for (var item of javaAdreslijst) {
    var address = item.get("adressenMetVeelBewoners");
    if (address &amp;&amp; checkAddressMatch(address, javaAdresAanvrager)) {
      resultMap.put("veelBewoners", true);
      resultMap.put("veelBewonersAdres", address);
      break;
    }
  }

  return resultMap;
}

function checkAddressMatch(address, adresAanvrager) {
  function getProp(map, key) {
    var v = map.get(key);
    return v !== null
      ? v.toString()
      .toLowerCase()
      .replace(/\s+|['"]+/g, '') : '';
  }

  var basicMatches =
    getProp(address, "postcode") === getProp(adresAanvrager, "postcode") &amp;&amp;
    getProp(address, "huisnummer") === getProp(adresAanvrager, "huisnummer");

  var letterInput = getProp(adresAanvrager, "huisletter");
  var toevoegInput = getProp(adresAanvrager, "huisnummertoevoeging");

  var letterMatch = (letterInput === '') || (getProp(address, "huisletter") === letterInput);
  var toevoegMatch = (toevoegInput === '') || (getProp(address, "huisnummertoevoeging") === toevoegInput);

  return basicMatches &amp;&amp; letterMatch &amp;&amp; toevoegMatch;
}

findVeelBewonersMatch();</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_0j09hyd">
