<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1y9ob7p" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.28.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:collaboration id="Collaboration_0vdtc6x">
    <bpmn:participant id="VerwerkenBesluitIOAWParticipant" name="Verwerken besluit IOAW" processRef="ioaw-verwerken-besluit" />
  </bpmn:collaboration>
  <bpmn:process id="ioaw-verwerken-besluit" name="IOAW: Verwerken besluit" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:sequenceFlow id="Flow_1ksgoy8" sourceRef="BesluitVastgelegdStartEvent" targetRef="Activity_0th2rfr" />
    <bpmn:sequenceFlow id="Flow_0xf3bvf" sourceRef="VastleggenBesluitCallActivity" targetRef="ZetZaakeigenschapTask" />
    <bpmn:sequenceFlow id="Flow_1j4av1j" sourceRef="BepaalBesluittypeEnResultaattypeTask" targetRef="VastleggenBesluitCallActivity" />
    <bpmn:startEvent id="BesluitVastgelegdStartEvent" name="Besluit vastgelegd">
      <bpmn:outgoing>Flow_1ksgoy8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_18dorod" sourceRef="ZetZaakeigenschapTask" targetRef="AfsluitenZaakCallActivity" />
    <bpmn:sequenceFlow id="Flow_1h91lgb" sourceRef="AfsluitenZaakCallActivity" targetRef="ZaakAfgeslotenEndEvent" />
    <bpmn:sequenceFlow id="Flow_1pisem2" sourceRef="Activity_0th2rfr" targetRef="Activity_0ccr2ox" />
    <bpmn:sequenceFlow id="Flow_0i2vzqm" sourceRef="Activity_0ccr2ox" targetRef="BepaalBesluittypeEnResultaattypeTask" />
    <bpmn:businessRuleTask id="BepaalBesluittypeEnResultaattypeTask" name="Bepaal besluittype en resultaattype" camunda:asyncAfter="true" camunda:resultVariable="resultMap" camunda:decisionRef="ioaw-bepaal-besluittype-resultaattype" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="besluit">${valueResolverDelegateService.resolveValue(execution, "doc:besluit.genomenBesluit")}</camunda:inputParameter>
          <camunda:outputParameter name="besluitType">${resultMap.besluitType}</camunda:outputParameter>
          <camunda:outputParameter name="resultaatType">${resultMap.resultaatType}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0i2vzqm</bpmn:incoming>
      <bpmn:outgoing>Flow_1j4av1j</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="VastleggenBesluitCallActivity" name="Vastleggen besluit" camunda:asyncAfter="true" calledElement="generic-vastleggen-besluit">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:inputOutput>
          <camunda:inputParameter name="besluitIngangsdatum">${dateTime().toLocalDate().toString()}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:in source="besluitType" target="besluitTypeDescription" />
        <camunda:in source="besluitIngangsdatum" target="besluitIngangsdatum" />
        <camunda:in source="besluitDocumentUrl" target="besluitDocumentUrl" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1j4av1j</bpmn:incoming>
      <bpmn:outgoing>Flow_0xf3bvf</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="ZetZaakeigenschapTask" name="Zet zaakeigenschap" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="einddatum">${dateTime().toLocalDate().toString("yyyyMMdd")}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0xf3bvf</bpmn:incoming>
      <bpmn:outgoing>Flow_18dorod</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="AfsluitenZaakCallActivity" name="Afsluiten zaak" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-afsluiten-zaak-plugin">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="status" target="status" />
        <camunda:in source="resultaatType" target="resultaat" />
        <camunda:inputOutput>
          <camunda:inputParameter name="status">Afgehandeld</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18dorod</bpmn:incoming>
      <bpmn:outgoing>Flow_1h91lgb</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="ZaakAfgeslotenEndEvent" name="Zaak afgesloten">
      <bpmn:incoming>Flow_1h91lgb</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_04w0zup" camunda:expression="${correlationService.sendCatchEventMessage(&#34;ZAAK_AFGESLOTEN&#34;, execution.businessKey)}" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_0th2rfr" name="Get besluit document id" camunda:expression="${customInformatieobjectenService.getDocumentMetadataValue(tempFileId,&#34;documentId&#34;)}" camunda:resultVariable="besluitDocumentId">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="tempFileId">${documentDelegateService.findValueByJsonPointer("/besluit/besluitDocumenten", execution)[0].id}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ksgoy8</bpmn:incoming>
      <bpmn:outgoing>Flow_1pisem2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0ccr2ox" name="Get besluit document url " camunda:asyncAfter="true" camunda:expression="${customInformatieobjectenService.getDocumentUrlById(besluitDocumentId, execution.businessKey)}" camunda:resultVariable="besluitDocumentUrl">
      <bpmn:incoming>Flow_1pisem2</bpmn:incoming>
      <bpmn:outgoing>Flow_0i2vzqm</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
