<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.32.0" camunda:diagramRelationId="c1c21bad-48a8-4110-80b2-6350a80a9e03">
  <bpmn:collaboration id="Collaboration_0o2qrbx">
    <bpmn:participant id="VerlengenDeadlineInformatieverzoekParticipant" name="Verlengen deadline informatieverzoek" processRef="ioaw-verlengen-deadline-informatieverzoek" />
  </bpmn:collaboration>
  <bpmn:message id="Message_1qeuq56" name="SHV_OPVRAGEN_INFORMATIE_PORTAALTAAK_AFGEROND" />
  <bpmn:message id="Message_07ngnm5" name="SHV_OPVRAGEN_INFORMATIE_PORTAALTAAK_GEANNULEERD" />
  <bpmn:process id="ioaw-verlengen-deadline-informatieverzoek" name="IOAW: Verlengen deadline informatieverzoek" isExecutable="true">
    <bpmn:laneSet id="LaneSet_05ieiak" />
    <bpmn:startEvent id="DeadlineVerlengenGestartStartEvent" name="deadline verlengen gestart">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#34;informatieverzoeken&#34;, valueResolverDelegateService.resolveValue(execution, &#34;doc:/informatieverzoeken&#34;))}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0rsm9xf</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0rsm9xf" sourceRef="DeadlineVerlengenGestartStartEvent" targetRef="InvoerenNieuweDeadlineTask" />
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="HersteltermijnVanToepassingGateway" targetRef="BeeindigdBestaandeEinddatumBeslistermijnTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verzoek.hersteltermijn == 'JA'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="Nee" sourceRef="HersteltermijnVanToepassingGateway" targetRef="Gateway_0ycan9c" />
    <bpmn:sequenceFlow id="Flow_146035s" sourceRef="BepalenNieuwEinddatumBeslistermijnTask" targetRef="Gateway_0ycan9c" />
    <bpmn:sequenceFlow id="Flow_1ftsml9" sourceRef="UpdatenPortaaltaakTask" targetRef="DeadlineVerlengdEndEvent" />
    <bpmn:userTask id="InvoerenNieuweDeadlineTask" name="Invoeren nieuwe deadline" camunda:asyncAfter="true" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR">
      <bpmn:incoming>Flow_0rsm9xf</bpmn:incoming>
      <bpmn:outgoing>Flow_1xxzbe1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1xxzbe1" sourceRef="InvoerenNieuweDeadlineTask" targetRef="VoorbereidenVariabelenTask" />
    <bpmn:exclusiveGateway id="HersteltermijnVanToepassingGateway" name="hersteltermijn van toepassing?" default="NeeSequenceFlow">
      <bpmn:incoming>Flow_0eowxe5</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0eowxe5" sourceRef="VoorbereidenVariabelenTask" targetRef="HersteltermijnVanToepassingGateway" />
    <bpmn:serviceTask id="VoorbereidenVariabelenTask" name="Voorbereiden variabelen" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="informatieverzoeken">${valueResolverDelegateService.resolveValue(execution, "doc:/informatieverzoeken")}</camunda:inputParameter>
          <camunda:outputParameter name="verzoek">${informatieverzoeken[informatieverzoeken.size() - 1].verzoek}</camunda:outputParameter>
          <camunda:outputParameter name="prettyDeadline">${dateTime().parse(verzoek.deadlineInformatieverzoek).toLocalDate().toString("dd-MM-yyyy")}</camunda:outputParameter>
          <camunda:outputParameter name="verwerkerTaakId">${informatieverzoeken[informatieverzoeken.size() - 1].verzoek.verwerkerTaakId}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1xxzbe1</bpmn:incoming>
      <bpmn:outgoing>Flow_0eowxe5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BeeindigdBestaandeEinddatumBeslistermijnTask" name="Beëindigd bestaande einddatum beslistermijn" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements />
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1bfli09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1bfli09" sourceRef="BeeindigdBestaandeEinddatumBeslistermijnTask" targetRef="BepalenNieuwEinddatumBeslistermijnTask" />
    <bpmn:serviceTask id="BepalenNieuwEinddatumBeslistermijnTask" name="Bepalen nieuw einddatum beslistermijn" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="hersteltermijn">${verzoek.hersteltermijnInDagen}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1bfli09</bpmn:incoming>
      <bpmn:outgoing>Flow_146035s</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0ycan9c">
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:incoming>Flow_146035s</bpmn:incoming>
      <bpmn:outgoing>Flow_0myuwh2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="UpdatenPortaaltaakTask" name="updaten portaaltaak" camunda:asyncAfter="true" camunda:expression="${bbzTaskService.updatePortaalTaak(verwerkerTaakId, &#34;taak&#34;, newDeadline)}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="newDeadline">${verzoek.deadlineInformatieverzoek}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1qns18n</bpmn:incoming>
      <bpmn:outgoing>Flow_1ftsml9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="DeadlineVerlengdEndEvent" name="deadline verlengd">
      <bpmn:incoming>Flow_1ftsml9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="AanpassenDeadlineMessageSendEvent" name="Aanpassen deadline informatieverzoek" camunda:asyncBefore="true" camunda:asyncAfter="true">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="variablesMap">
            <camunda:map>
              <camunda:entry key="deadlineInformatieverzoek">${verzoek.deadlineInformatieverzoek}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0myuwh2</bpmn:incoming>
      <bpmn:outgoing>Flow_1qns18n</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0kg0afe" camunda:expression="${correlationService.sendCatchEventMessage(&#34;IOAW_OPVRAGEN_INFORMATIE_AANPASSEN_DEADLINE_MESSAGE&#34;, execution.businessKey, variablesMap )}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_0myuwh2" sourceRef="Gateway_0ycan9c" targetRef="AanpassenDeadlineMessageSendEvent" />
    <bpmn:sequenceFlow id="Flow_1qns18n" sourceRef="AanpassenDeadlineMessageSendEvent" targetRef="UpdatenPortaaltaakTask" />
  </bpmn:process>
