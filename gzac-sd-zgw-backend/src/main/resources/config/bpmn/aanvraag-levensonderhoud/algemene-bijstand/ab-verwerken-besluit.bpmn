        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_00w9ava_di" bpmnElement="VastleggenBesluitCallActivity">
        <dc:Bounds x="800" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
