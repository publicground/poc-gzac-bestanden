    <bpmn:serviceTask id="OpslaanReactieInformatieverzoekInDocumentTask" name="Opslaan reactie informatie-verzoek in document" camunda:asyncAfter="true" camunda:expression="${bbzTaskService.writeInformatiereactieToDocument(informatiereactieMap, execution.businessKey)}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="informatiereactieMap">
            <camunda:map>
