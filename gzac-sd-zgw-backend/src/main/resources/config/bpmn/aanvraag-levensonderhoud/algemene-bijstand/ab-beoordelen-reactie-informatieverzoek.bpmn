            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0tzekgi</bpmn:incoming>
      <bpmn:outgoing>Flow_1q7mutc</bpmn:outgoing>
