    <bpmn:callActivity id="UpdateZaakstatusCallActivity" name="Update zaakstatus" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-update-zaak-status-plugin">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:inputOutput>
          <camunda:inputParameter name="status">Aanvullende informatie ontvangen</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:in source="status" target="status" local="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0vy2nc0</bpmn:incoming>
      <bpmn:outgoing>Flow_1obceen</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="UploadenOntvangenDocumentenTask" name="Uploaden ontvangen documenten" camunda:candidateGroups="ROLE_ADMIN,ROLE_IV_BEHANDELAAR,ROLE_IV_RAADPLEGER">
      <bpmn:incoming>Flow_0g0hdrc</bpmn:incoming>
      <bpmn:outgoing>Flow_0vy2nc0</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="VoorbereidenVariabelenTask" name="Voorbereiden variabelen" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="informatieverzoeken">${valueResolverDelegateService.resolveValue(execution, "doc:/informatieverzoeken")}</camunda:inputParameter>
          <camunda:outputParameter name="verzoek">${informatieverzoeken[informatieverzoeken.size() - 1].verzoek}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1obceen</bpmn:incoming>
      <bpmn:outgoing>Flow_14kdicm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="HersteltermijnVanToepassingGateway" name="hersteltermijn van toepassing?" default="NeeSequenceFlow">
      <bpmn:incoming>Flow_14kdicm</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BepalenNieuwEinddatumBeslistermijnTask" name="Bepalen nieuw einddatum beslistermijn" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="hersteltermijn">${verzoek.hersteltermijnInDagen}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_0d0zjps</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1bpi4yx">
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:incoming>Flow_0d0zjps</bpmn:incoming>
      <bpmn:outgoing>Flow_1oglflb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_0skcmh4">
      <bpmn:incoming>Flow_16f1mfq</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="AnnulerenPortaaltaakEvent" name="annuleren portaaltaak" camunda:asyncAfter="true">
      <bpmn:incoming>Flow_1oglflb</bpmn:incoming>
      <bpmn:outgoing>Flow_0y3y8z4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0bo1wrz" camunda:expression="${correlationService.sendCatchEventMessage(&#34;ALO_OPVRAGEN_INFORMATIE_PORTAALTAAK_GEANNULEERD&#34;,execution.businessKey)}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:callActivity id="UpdateZaakstatusCallActivity1" name="Update zaakstatus" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="generic-update-zaak-status-plugin">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
