<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" camunda:diagramRelationId="c1c21bad-48a8-4110-80b2-6350a80a9e03">
  <bpmn:collaboration id="Collaboration_0o2qrbx">
    <bpmn:participant id="VastleggenReactieInformatieverzoekParticipant" name="Vastleggen reactie informatieverzoek" processRef="ab-vastleggen-reactie-informatieverzoek" />
    <bpmn:textAnnotation id="TextAnnotation_02m0f1q">
      <bpmn:text>formulier is functioneel indentiek (alleen file uploads) aan het formulier in de klantportaal</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1wwig9k">
      <bpmn:text>nieuwe zaakstatus: Aanvullende informatie ontvangen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1j640dz">
      <bpmn:text>nieuwe zaakstatus: in behandeling genomen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_12vvl17" associationDirection="None" sourceRef="UpdateZaakstatusCallActivity" targetRef="TextAnnotation_1wwig9k" />
    <bpmn:association id="Association_05zp8hk" associationDirection="None" sourceRef="TextAnnotation_1j640dz" targetRef="UpdateZaakstatusCallActivity1" />
  </bpmn:collaboration>
  <bpmn:message id="Message_1qeuq56" name="SHV_OPVRAGEN_INFORMATIE_PORTAALTAAK_AFGEROND" />
  <bpmn:message id="Message_07ngnm5" name="SHV_OPVRAGEN_INFORMATIE_PORTAALTAAK_GEANNULEERD" />
  <bpmn:process id="ab-vastleggen-reactie-informatieverzoek" name="AB: Vastleggen reactie informatieverzoek" isExecutable="true">
    <bpmn:startEvent id="HandmatigOntvangenStartEvent" name="handmatig ontvangen">
      <bpmn:outgoing>Flow_0g0hdrc</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0vy2nc0" sourceRef="UploadenOntvangenDocumentenTask" targetRef="UpdateZaakstatusCallActivity" />
    <bpmn:sequenceFlow id="Flow_1obceen" sourceRef="UpdateZaakstatusCallActivity" targetRef="VoorbereidenVariabelenTask" />
    <bpmn:sequenceFlow id="JaSequenceFlow" name="Ja" sourceRef="HersteltermijnVanToepassingGateway" targetRef="BepalenNieuwEinddatumBeslistermijnTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verzoek.hersteltermijn == 'JA'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="NeeSequenceFlow" name="Nee" sourceRef="HersteltermijnVanToepassingGateway" targetRef="Gateway_1bpi4yx" />
    <bpmn:sequenceFlow id="Flow_0d0zjps" sourceRef="BepalenNieuwEinddatumBeslistermijnTask" targetRef="Gateway_1bpi4yx" />
