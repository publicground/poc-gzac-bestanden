      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0y3y8z4</bpmn:incoming>
      <bpmn:outgoing>Flow_16f1mfq</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:association id="Association_040fy46" associationDirection="None" sourceRef="UploadenOntvangenDocumentenTask" targetRef="TextAnnotation_02m0f1q" />
  </bpmn:process>
