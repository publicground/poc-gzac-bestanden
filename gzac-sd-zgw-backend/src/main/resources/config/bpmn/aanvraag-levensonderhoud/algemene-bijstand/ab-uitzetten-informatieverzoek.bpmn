          <camunda:inputParameter name="verzenddatum">${now().toInstant().toString()}</camunda:inputParameter>
          <camunda:inputParameter name="opgevraagdeStukken">${verzoek.opTeVragenInformatie}</camunda:inputParameter>
          <camunda:inputParameter name="deadlineInformatieverzoek">${verzoek.deadlineInformatieverzoek}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:in source="templateGroup" target="templateGroup" />
