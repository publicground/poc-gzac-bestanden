    <bpmn:userTask id="VaststellenOpTeVragenInformatieTask" name="Vaststellen op te vragen informatie" camunda:asyncAfter="true" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_01sceda</bpmn:incoming>
      <bpmn:outgoing>Flow_0hhuxp5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="VoorbereidenVariabelenTask" name="Voorbereiden variabelen" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="informatieverzoeken">${valueResolverDelegateService.resolveValue(execution, "doc:/informatieverzoeken")}</camunda:inputParameter>
          <camunda:outputParameter name="verzoek">${informatieverzoeken[informatieverzoeken.size() - 1].verzoek}</camunda:outputParameter>
          <camunda:outputParameter name="prettyDeadline">${dateTime().parse(verzoek.deadlineInformatieverzoek).toLocalDate().toString("dd-MM-yyyy")}</camunda:outputParameter>
          <camunda:outputParameter name="documenten">${informatieverzoeken[informatieverzoeken.size() - 1].verzoek.documenten}</camunda:outputParameter>
          <camunda:outputParameter name="opgevraagdeStukken">
            <camunda:script scriptFormat="javascript">var verzoek = execution.getVariable("verzoek");

var result = Array.isArray(verzoek?.opTeVragenInformatie)
    ? verzoek.opTeVragenInformatie.map(function(item) {
        var informatieverzoekItem = item.informatieverzoekItem || {};
        return {
            omschrijvingAanvrager: informatieverzoekItem.omschrijvingAanvrager || "",
            toelichting: informatieverzoekItem.toelichting || ""
        };
    })
    : [];
JSON.stringify(result);</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="verlooptijdInDagen">
            <camunda:script scriptFormat="javascript">var ZoneId = Java.type('java.time.ZoneId');
var ChronoUnit = Java.type('java.time.temporal.ChronoUnit');
var ZonedDateTime = Java.type('java.time.ZonedDateTime');
var DateTimeFormatter = Java.type('java.time.format.DateTimeFormatter');

var dateTimeFormatter = DateTimeFormatter.ISO_OFFSET_DATE_TIME;
var deadlineString = execution.getVariable('verzoek').deadlineInformatieverzoek;
var deadlineDate = ZonedDateTime.parse(deadlineString, dateTimeFormatter).withHour(0).withMinute(0).withSecond(0).withNano(0);
var currentDate = ZonedDateTime.now(ZoneId.systemDefault()).withHour(0).withMinute(0).withSecond(0).withNano(0);

ChronoUnit.DAYS.between(currentDate, deadlineDate);</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0hhuxp5</bpmn:incoming>
      <bpmn:outgoing>Flow_14gae38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="GenereerDocumentCallActivity" name="Genereer document" camunda:asyncAfter="true" calledElement="alo-genereer-document">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="templateName" target="templateName" />
        <camunda:inputOutput>
          <camunda:inputParameter name="templateGroup">GZAC Sociaal domein / ALO</camunda:inputParameter>
          <camunda:inputParameter name="templateName">Gegevens sturen bijstandsuitkering</camunda:inputParameter>
