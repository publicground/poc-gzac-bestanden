    <bpmn:userTask id="AanleverenInformatieTask" name="Aanleveren informatie" camunda:asyncAfter="true" implementation="##unspecified" camunda:candidateGroups="ROLE_ADMIN">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${customPortaalTaakListener}" event="create" id="LISTENER_PORTAALTAAK_CREATED" />
        <camunda:taskListener expression="${valueResolverDelegateService.handleValue(execution, &#39;doc:/informatieverzoeken/&#39;.concat(currentIndex - 1).concat(&#39;/verzoek/verwerkerTaakId&#39;), verwerkerTaakId)}" event="create" id="LISTENER_PORTAALTAAK_CREATED" />
        <camunda:executionListener expression="${execution.setVariable(&#34;currentIndex&#34;, (documentDelegateService.findValueByJsonPointer(&#34;/informatieverzoeken&#34;,execution)).size())} " event="start" />
      </bpmn:extensionElements>
