<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_0v1ejyk" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.39.0">
  <bpmn:collaboration id="Collaboration_1hhep9j">
    <bpmn:extensionElements />
    <bpmn:participant id="ExterneKlanttaakVerwerkAfgerondeKlanttaakParticipant" name="Externe Klanttaak: Verwerk afgeronde klanttaak" processRef="externe-klanttaak-verwerk-afgeronde-klanttaak" />
    <bpmn:textAnnotation id="TextAnnotation_1vvc2d8">
      <bpmn:text>Gets taak object from objects api.

Input: pv:externeKlanttaakObjectUrl
Output: pv:taakObject</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ga6tzz" associationDirection="None" sourceRef="GetTaakObjectFromObjectenAPITask" targetRef="TextAnnotation_1vvc2d8" />
  </bpmn:collaboration>
  <bpmn:process id="externe-klanttaak-verwerk-afgeronde-klanttaak" name="Externe Klanttaak: Verwerk afgeronde klanttaak" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:sequenceFlow id="Flow_125lm4p" sourceRef="start-event" targetRef="GetTaakObjectFromObjectenAPITask" />
    <bpmn:sequenceFlow id="OoievaarspasSequenceFlow" name="ooievaarspas" sourceRef="Gateway_06hef9r" targetRef="OPASVerwerkExterneKlanttaakTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valueResolverDelegateService.resolveValue(execution, "case:definitionId.name") == "aanvraag-ooievaarspas"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="AanvraaglevensonderhoudSequenceFlow" name="aanvraag-levensonderhoud" sourceRef="Gateway_06hef9r" targetRef="ALOVerwerkExterneKlanttaakTask" />
    <bpmn:sequenceFlow id="ShvaanvraagSequenceFlow" name="shv-aanvraag" sourceRef="Gateway_06hef9r" targetRef="SHVVerwerkExterneKlanttaakTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valueResolverDelegateService.resolveValue(execution, "case:definitionId.name") == "aanvraag-schuldhulpverlening"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BbzkredietOpvragenInformatieSequenceFlow" name="bbz-krediet (opvragen informatie)" sourceRef="Gateway_06hef9r" targetRef="BBZKredietVerwerkOpvragenInformatieKlanttaakTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valueResolverDelegateService.resolveValue(execution, "case:definitionId.name") == "bbz-krediet" &amp;&amp; taakObject.get("titel").asText() == "Aanleveren informatie"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0kpy1te" sourceRef="ALOVerwerkExterneKlanttaakTask" targetRef="Gateway_1j5d9x7" />
    <bpmn:sequenceFlow id="Flow_0grf89m" sourceRef="SHVVerwerkExterneKlanttaakTask" targetRef="Gateway_1j5d9x7" />
    <bpmn:sequenceFlow id="Flow_1lh37wq" sourceRef="BBZAanvraagVerwerkExterneKlanttaakTask" targetRef="Gateway_1j5d9x7" />
    <bpmn:sequenceFlow id="Flow_1gm4977" sourceRef="OPASVerwerkExterneKlanttaakTask" targetRef="Gateway_1j5d9x7" />
    <bpmn:sequenceFlow id="Flow_04om4es" sourceRef="BBZKredietVerwerkOpvragenInformatieKlanttaakTask" targetRef="Gateway_1j5d9x7" />
    <bpmn:sequenceFlow id="Flow_1rejwfk" sourceRef="Gateway_1j5d9x7" targetRef="end-event" />
    <bpmn:sequenceFlow id="BbzkredietBevestigenVoldaanAanVoorwaardenSequenceFlow" name="bbz-krediet (Bevestigen voldaan aan voorwaarden)" sourceRef="Gateway_06hef9r" targetRef="BBZKredietVerwerkBevestigenVoldaanAanVoorwaardenKlanttaakTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valueResolverDelegateService.resolveValue(execution, "case:definitionId.name") == "bbz-krediet" &amp;&amp; taakObject.get("titel").asText() == "Bevestigen voorwaarden voldaan"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1k4mu9m" sourceRef="BBZKredietVerwerkBevestigenVoldaanAanVoorwaardenKlanttaakTask" targetRef="Gateway_1j5d9x7" />
    <bpmn:startEvent id="start-event">
      <bpmn:outgoing>Flow_125lm4p</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_06hef9r" default="AanvraaglevensonderhoudSequenceFlow">
      <bpmn:incoming>Flow_11tcsd5</bpmn:incoming>
      <bpmn:outgoing>OoievaarspasSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>AanvraaglevensonderhoudSequenceFlow</bpmn:outgoing>
