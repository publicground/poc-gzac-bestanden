    <bpmn:serviceTask id="ALOVerwerkExterneKlanttaakTask" name="ALO Verwerk externe klanttaak" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>AanvraaglevensonderhoudSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_0kpy1te</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SHVVerwerkExterneKlanttaakTask" name="SHV Verwerk externe klanttaak" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>ShvaanvraagSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_0grf89m</bpmn:outgoing>
