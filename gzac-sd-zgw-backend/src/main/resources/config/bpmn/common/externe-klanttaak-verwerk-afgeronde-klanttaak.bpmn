      <bpmn:outgoing>BbzaanvraagSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_11tcsd5" sourceRef="GetTaakObjectFromObjectenAPITask" targetRef="Gateway_06hef9r" />
    <bpmn:serviceTask id="GetTaakObjectFromObjectenAPITask" name="Get Taak Object from Objecten API" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>Flow_125lm4p</bpmn:incoming>
      <bpmn:outgoing>Flow_11tcsd5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="BbzaanvraagSequenceFlow" name="bbz-aanvraag" sourceRef="Gateway_06hef9r" targetRef="BBZAanvraagVerwerkExterneKlanttaakTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valueResolverDelegateService.resolveValue(execution, "case:definitionId.name") == "bbz-aanvraag"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="OPASVerwerkExterneKlanttaakTask" name="OPAS Verwerk externe klanttaak" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements />
      <bpmn:incoming>OoievaarspasSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1gm4977</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BBZKredietVerwerkBevestigenVoldaanAanVoorwaardenKlanttaakTask" name="BBZ Krediet Verwerk Bevestigen voldaan aan voorwaarden klanttaak" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>BbzkredietBevestigenVoldaanAanVoorwaardenSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1k4mu9m</bpmn:outgoing>
