      <bpmn:outgoing>Flow_1rejwfk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end-event">
      <bpmn:incoming>Flow_1rejwfk</bpmn:incoming>
    </bpmn:endEvent>
