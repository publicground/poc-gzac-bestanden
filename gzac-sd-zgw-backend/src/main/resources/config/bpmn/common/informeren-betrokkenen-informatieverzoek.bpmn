    <bpmn:exclusiveGateway id="EmailadresAanwezigGateway" name="Emailadres aanwezig?" default="NeeSequenceFlow">
      <bpmn:incoming>Flow_0rkzzjl</bpmn:incoming>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_0xxyiu1">
      <bpmn:incoming>Flow_0gnhtsj</bpmn:incoming>
