  <bpmn:process id="informeren-betrokkenen-informatieverzoek" name="Informeren betrokkenen informatieverzoek" isExecutable="true">
    <bpmn:startEvent id="Event_1rc1g1g">
      <bpmn:outgoing>Flow_0rkzzjl</bpmn:outgoing>
