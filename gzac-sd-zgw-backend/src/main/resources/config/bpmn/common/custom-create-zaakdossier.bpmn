      <bpmn:outgoing>Flow_1eu3hy4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="LinkDocumentToZaakTask" name="Link Document to Zaak" implementation="##WebService" camunda:expression="${true}">
      <bpmn:incoming>Flow_0evcldf</bpmn:incoming>
      <bpmn:outgoing>Flow_1gwaqz2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:asyncAfter="true" camunda:collection="documentUrls" camunda:elementVariable="documentUrl" />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="DeleteVerzoekFromObjectsAPITask" name="Delete Verzoek from ObjectsAPI" camunda:asyncAfter="true" implementation="##WebService" camunda:expression="${true}">
      <bpmn:incoming>Flow_1k5479s</bpmn:incoming>
      <bpmn:outgoing>Flow_1uhql59</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="StartHandlingProcessTask" name="Start handling process" camunda:asyncAfter="true" implementation="##WebService" camunda:expression="${processService.startProcessByProcessDefinitionKey(processDefinitionKey,execution.businessKey, execution.variables)}">
      <bpmn:incoming>Flow_1gwaqz2</bpmn:incoming>
      <bpmn:outgoing>Flow_1k5479s</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0z8m8k6">
      <bpmn:incoming>Flow_1uhql59</bpmn:incoming>
      <bpmn:incoming>Flow_0l0lsfn</bpmn:incoming>
      <bpmn:outgoing>Flow_0zrrj3n</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="DocumentSearchTask" name="Document search" camunda:asyncAfter="true" implementation="##WebService" camunda:expression="${true}">
      <bpmn:incoming>Flow_1ju01uk</bpmn:incoming>
      <bpmn:outgoing>Flow_0u51pbu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="DeleteDocumentTask" name="Delete document" camunda:asyncAfter="true" implementation="##WebService" camunda:expression="${customDocumentService.deleteDocument(execution.businessKey)}">
      <bpmn:incoming>JaSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_0l0lsfn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_19l1mml">
      <bpmn:incoming>Flow_0zrrj3n</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
