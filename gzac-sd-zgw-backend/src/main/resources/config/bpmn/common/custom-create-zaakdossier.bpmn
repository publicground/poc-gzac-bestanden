      <bpmn:outgoing>NeeSequenceFlow</bpmn:outgoing>
      <bpmn:outgoing>JaSequenceFlow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CreateZaakTask" name="Create Zaak" camunda:asyncAfter="true" implementation="##WebService" camunda:expression="${true}">
      <bpmn:incoming>NeeSequenceFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_1tgmdp6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CreateInitiatorZaakRolTask" name="Create Initiator ZaakRol" camunda:asyncAfter="true" implementation="##WebService" camunda:expression="${true}">
