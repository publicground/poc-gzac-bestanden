  <bpmn:collaboration id="Collaboration_0dix0as">
    <bpmn:participant id="UpdateZaakEnInterneStatusParticipant" name="Update zaak en interne status" processRef="generic-update-zaak-en-interne-status-plugin" />
    <bpmn:textAnnotation id="TextAnnotation_13xtzan">
      <bpmn:text>configureer plugin actie:
Zaken API plugin - Zaakstatus aanmaken</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1mzg7wg">
      <bpmn:text>configureer plugin actie:
Catalogi API plugin - Statustype ophalen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0380l2m" sourceRef="TextAnnotation_1mzg7wg" targetRef="OphalenZaakstatusTypeUrlTask" />
    <bpmn:association id="Association_049b2hy" sourceRef="ZetZaakstatusTask" targetRef="TextAnnotation_13xtzan" />
    <bpmn:textAnnotation id="TextAnnotation_104rm1u">
      <bpmn:text>Hier wordt de interne status gezet</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ebuyye" associationDirection="None" sourceRef="TextAnnotation_104rm1u" targetRef="ZetInterneStatusTask" />
  </bpmn:collaboration>
  <bpmn:process id="generic-update-zaak-en-interne-status-plugin" name="Generic: Update zaak  en interne status w/ plugin" isExecutable="true">
    <bpmn:sequenceFlow id="Flow_0wzjer7" sourceRef="StartEvent" targetRef="OphalenZaakstatusTypeUrlTask" />
    <bpmn:sequenceFlow id="Flow_081gm85" sourceRef="OphalenZaakstatusTypeUrlTask" targetRef="ZetZaakstatusTask" />
    <bpmn:sequenceFlow id="Flow_1x3dopr" sourceRef="ZetZaakstatusTask" targetRef="ZetInterneStatusTask" />
    <bpmn:sequenceFlow id="Flow_1unfq5n" sourceRef="UpdateZaakPropertiesInDocumentTask" targetRef="EndEvent" />
    <bpmn:startEvent id="StartEvent" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_0wzjer7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ZetZaakstatusTask" name="Zet zaakstatus" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>Flow_081gm85</bpmn:incoming>
      <bpmn:outgoing>Flow_1x3dopr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="OphalenZaakstatusTypeUrlTask" name="Ophalen zaakstatus type url" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>Flow_0wzjer7</bpmn:incoming>
      <bpmn:outgoing>Flow_081gm85</bpmn:outgoing>
      <bpmn:property id="Property_1qwjpqj" name="__targetRef_placeholder" />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="UpdateZaakPropertiesInDocumentTask" name="Update zaak properties in document" camunda:asyncAfter="true" camunda:expression="${zaakPropertiesService.storeSelectedZaakPropertiesInDocumentRoot(execution.businessKey,&#34;identificatie&#34;,&#34;statusOmschrijving&#34;,&#34;resultaatOmschrijving&#34;)}">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R30/PT2S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1it54b9</bpmn:incoming>
      <bpmn:outgoing>Flow_1unfq5n</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1it54b9" sourceRef="ZetInterneStatusTask" targetRef="UpdateZaakPropertiesInDocumentTask" />
    <bpmn:serviceTask id="ZetInterneStatusTask" name="Zet interne status" camunda:asyncAfter="true" camunda:expression="${documentDelegateService.setInternalStatus(execution, execution.getVariable(&#34;interneStatus&#34;))}">
      <bpmn:incoming>Flow_1x3dopr</bpmn:incoming>
      <bpmn:outgoing>Flow_1it54b9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent">
      <bpmn:incoming>Flow_1unfq5n</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
