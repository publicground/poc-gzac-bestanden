  <bpmn:collaboration id="Collaboration_0dix0as">
    <bpmn:participant id="UpdateZaakStatusPluginVParticipant" name="Update zaak status" processRef="generic-update-zaakstatus-plugin-v2" />
    <bpmn:textAnnotation id="TextAnnotation_13xtzan">
      <bpmn:text>plugin actie:
Zaken API plugin - Zaakstatus aanmaken</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1mzg7wg">
      <bpmn:text>plugin actie:
Catalogi API plugin - Statustype ophalen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0380l2m" sourceRef="TextAnnotation_1mzg7wg" targetRef="OphalenZaakstatusTypeUrlTask" />
    <bpmn:association id="Association_049b2hy" sourceRef="ZetZaakstatusTask" targetRef="TextAnnotation_13xtzan" />
  </bpmn:collaboration>
  <bpmn:process id="generic-update-zaakstatus-plugin-v2" name="Generic: Update zaakstatus plugin v2" isExecutable="true">
    <bpmn:sequenceFlow id="Flow_0wzjer7" sourceRef="StartEvent" targetRef="OphalenZaakstatusTypeUrlTask" />
    <bpmn:sequenceFlow id="Flow_081gm85" sourceRef="OphalenZaakstatusTypeUrlTask" targetRef="ZetZaakstatusTask" />
    <bpmn:sequenceFlow id="Flow_1x3dopr" sourceRef="ZetZaakstatusTask" targetRef="OpslaanZaakstatusInDocumentTask" />
    <bpmn:startEvent id="StartEvent" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_0wzjer7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ZetZaakstatusTask" name="Zet zaakstatus" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>Flow_081gm85</bpmn:incoming>
      <bpmn:outgoing>Flow_1x3dopr</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0vmwauk">
        <bpmn:targetRef>ZakenAPIDataStoreReference</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="OphalenZaakstatusTypeUrlTask" name="Ophalen zaakstatus type url" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:incoming>Flow_0wzjer7</bpmn:incoming>
      <bpmn:outgoing>Flow_081gm85</bpmn:outgoing>
      <bpmn:property id="Property_1qwjpqj" name="__targetRef_placeholder" />
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0uptv7v">
        <bpmn:targetRef>CatalogiAPIDataStoreReference</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="ZakenAPIDataStoreReference" name="Zaken API" />
    <bpmn:dataStoreReference id="CatalogiAPIDataStoreReference" name="Catalogi API" />
    <bpmn:sequenceFlow id="Flow_08bna8j" sourceRef="OpslaanZaakstatusInDocumentTask" targetRef="EndEvent" />
    <bpmn:endEvent id="EndEvent">
      <bpmn:incoming>Flow_08bna8j</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="OpslaanZaakstatusInDocumentTask" name="Opslaan zaakstatus in document" camunda:asyncAfter="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/openzaak/statusOmschrijving&#34;, zaakstatus)}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="zaakstatus">${valueResolverDelegateService.resolveValue(execution, "zaakstatus:omschrijving")}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1x3dopr</bpmn:incoming>
      <bpmn:outgoing>Flow_08bna8j</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
