    <bpmn:callActivity id="Bs218VaststellingUitsluitingsgrondenPartnerCallActivity" name="bs 218 vaststelling uitsluitingsgronden partner" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="bs-218-vaststelling-uitsluitingsgronden">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in sourceExpression="${gegevensVaststelling.partner.bsn}" target="bsn" />
        <camunda:in source="handmatigVaststellen" target="handmatigVaststellen" />
        <camunda:out source="uitsluitingsgronden" target="uitsluitingsgronden" />
        <camunda:out source="isSignalering" target="isSignalering" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15c7n3g</bpmn:incoming>
      <bpmn:outgoing>Flow_0ac0aux</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="WegschrijvenOutputUitsluitingsgrondenTask" name="wegschrijven output &#39;uitsluitingsgronden&#39;" camunda:asyncBefore="true" implementation="##WebService" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#39;doc:/besluiten/&#39;.concat(0).concat(&#39;/dienst/&#39;).concat(0).concat(&#39;/partner/uitsluitingsgronden&#39;), uitsluitingsgronden)}">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R30/PT2S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ac0aux</bpmn:incoming>
      <bpmn:outgoing>Flow_06zaumx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="WegschrijvenOutputAdditioneleVeldenTask" name="wegschrijven output &#39;additioneleVelden&#39;" camunda:asyncBefore="true" implementation="##WebService" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling/additioneleVeldenPartner/bs218Uitsluitingsgronden&#34;, additioneleVelden)}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="additioneleVelden">
            <camunda:map>
              <camunda:entry key="uitsluitingsgrondenVastgesteld">${true}</camunda:entry>
              <camunda:entry key="datumVastgesteld">${now().toInstant().toString()}</camunda:entry>
              <camunda:entry key="isHandmatigBeoordeeld">${isSignalering || handmatigVaststellen}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:failedJobRetryTimeCycle>R30/PT2S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06zaumx</bpmn:incoming>
      <bpmn:outgoing>Flow_195zchm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_195zchm" sourceRef="WegschrijvenOutputAdditioneleVeldenTask" targetRef="EndEvent" />
    <bpmn:endEvent id="EndEvent" camunda:asyncAfter="true">
      <bpmn:incoming>Flow_195zchm</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
