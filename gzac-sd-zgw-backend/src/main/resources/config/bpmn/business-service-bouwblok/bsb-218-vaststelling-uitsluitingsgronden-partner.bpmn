  <bpmn:process id="bsb-218-vaststelling-uitsluitingsgronden-partner" name="BSB 218 vaststelling uitsluitingsgronden partner" processType="None" isClosed="false" isExecutable="true">
    <bpmn:serviceTask id="OphalenInputTask" name="ophalen input" camunda:asyncAfter="true" implementation="##WebService" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="handmatigVaststellen">${execution.getVariable("handmatigVaststellen") ? handmatigVaststellen : false}</camunda:outputParameter>
          <camunda:outputParameter name="gegevensVanuitAanvraag">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag")}</camunda:outputParameter>
          <camunda:outputParameter name="gegevensVaststelling">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling")}</camunda:outputParameter>
          <camunda:outputParameter name="gegevensVanuitBronnen">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitBronnen")}</camunda:outputParameter>
          <camunda:outputParameter name="taakTitel">${'Vaststellen uitsluitingsgronden partner'}</camunda:outputParameter>
          <camunda:outputParameter name="vastgesteldeUitsluitingsgronden">${valueResolverDelegateService.resolveValue(execution, 'doc:/besluiten/'.concat(0).concat('/dienst/').concat(0).concat('/partner/uitsluitingsgronden'))}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1qz0lon</bpmn:incoming>
      <bpmn:outgoing>Flow_15c7n3g</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="StartEvent" camunda:asyncAfter="true">
