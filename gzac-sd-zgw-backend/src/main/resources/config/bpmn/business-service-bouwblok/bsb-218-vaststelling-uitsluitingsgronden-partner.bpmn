    <bpmn:sequenceFlow id="Flow_1qz0lon" sourceRef="StartEvent" targetRef="OphalenInputTask" />
    <bpmn:sequenceFlow id="Flow_15c7n3g" sourceRef="OphalenInputTask" targetRef="Bs218VaststellingUitsluitingsgrondenPartnerCallActivity" />
