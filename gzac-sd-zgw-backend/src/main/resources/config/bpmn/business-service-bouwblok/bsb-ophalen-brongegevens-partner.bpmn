    <bpmn:serviceTask id="VoorbereidenVariabelenTask" name="voorbereiden variabelen" camunda:asyncBefore="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="filteredKinderenInfo">
            <camunda:script scriptFormat="javascript">var ArrayList = Java.type('java.util.ArrayList');

// common script
function toJavaValue(value) {
    if (value == null) return null;

    var valueType = typeof value;

    if (valueType === 'string') return String(value);
    if (valueType === 'number') return Number(value);
    if (valueType === 'boolean') return value;

    if (Array.isArray(value)) {
        return toJavaList(value);
    }

    if (valueType === 'object') {
        return toJavaMap(value);
    }

    return String(value);
}

function toJavaMap(obj) {
    var map = new Packages.java.util.LinkedHashMap();

    for (var key in obj) {
        if (Object.prototype.hasOwnProperty.call(obj, key)) {
            map.put(String(key), toJavaValue(obj[key]));
        }
    }

    return map;
}

function toJavaList(arr) {
    var list = new Packages.java.util.ArrayList();

    for (var i = 0; i &lt; arr.length; i++) {
        list.add(toJavaValue(arr[i]));
    }
    return list;
}

function mapAdres(adres) {
    if (!adres) return null;
    return {
        straatnaam: adres.straatnaam != null ? String(adres.straatnaam) : '',
        huisnummer: adres.huisnr != null ? Number(adres.huisnr) : 0,
        huisletter: adres.huisletter != null ? String(adres.huisletter) : '',
        huisnummertoevoeging: adres.huisnrtoevoeging != null ? String(adres.huisnrtoevoeging) : '',
        postcode: adres.postcd != null ? String(adres.postcd) : '',
        woonplaatsnaam: adres.woonplaatsnaam != null ? String(adres.woonplaatsnaam) : '',
        aanduidingBijHuisnummer: adres.aanduidingBijHuisnr != null ? String(adres.aanduidingBijHuisnr) : '',
        locatieomschrijving: adres.locatieoms != null ? String(adres.locatieoms) : ''
    };
}

//filtered kinder script
var ChronoField = Java.type('java.time.temporal.ChronoField');

function adressenGelijk(adres1, adres2) {
  if (adres1 == null || adres2 == null) return false;
  return adres1.straatnaam === adres2.straatnaam &amp;&amp;
    adres1.huisnummer === adres2.huisnummer &amp;&amp;
    adres1.huisletter === adres2.huisletter &amp;&amp;
    adres1.huisnummertoevoeging === adres2.huisnummertoevoeging &amp;&amp;
    adres1.postcode === adres2.postcode &amp;&amp;
    adres1.woonplaatsnaam === adres2.woonplaatsnaam;
}

function getFilteredKinderen(kinderenList, persoon, caseCreatedDate) {
   var result = new ArrayList();

  if (kinderenList == null || kinderenList.length === 0 || persoon == null) return 
      result;

  var caseCreatedYear = caseCreatedDate.get(ChronoField.YEAR);
  for (var i = 0; i &lt; kinderenList.length; i++) {
    var kind = kinderenList[i];
    
    if (!adressenGelijk(kind.adresBrp, persoon.adresBrp)) continue;
    if (kind.datumOverlijden != null &amp;&amp; kind.datumOverlijden !== '') continue;
    var birthYear = kind.geboortedatum != null &amp;&amp; kind.geboortedatum !== ''
      ? parseInt(String(kind.geboortedatum).substring(0, 4), 10) : null;
    if (birthYear == null) continue;
    if (caseCreatedYear - birthYear &gt;= 100) continue;
   
  }
  return result;
}

getFilteredKinderen(brpPersoonsgegevensKinderenInfo, brpPersoonsgegevensInfo, caseCreatedDate);</camunda:script>
          </camunda:inputParameter>
          <camunda:outputParameter name="partner">
            <camunda:script scriptFormat="javascript">var HashMap = Java.type("java.util.HashMap");

var partnerInfoRaw = execution.getVariable("brpPersoonsgegevensInfo");
var partnerInfo = (partnerInfoRaw instanceof java.util.Map) ? partnerInfoRaw : new HashMap();

var partnerPartnerInfo = execution.getVariable("brpPersoonsgegevensPartnerInfo");
var kinderenInfo = execution.getVariable("filteredKinderenInfo");

if (partnerPartnerInfo !== null &amp;&amp; partnerPartnerInfo !== undefined) {
    partnerInfo.put("partner", partnerPartnerInfo);
}

if (kinderenInfo !== null &amp;&amp; kinderenInfo.size() &gt; 0) {
    partnerInfo.put("kinderen", kinderenInfo);
}

partnerInfo;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="vermogenPartner">
            <camunda:script scriptFormat="javascript">var HashMap = Java.type("java.util.HashMap");
var ArrayList = Java.type("java.util.ArrayList");

var vermogenPartner = new HashMap();
var rdw = execution.getVariable("rdwVoertuigen") || {};
var kad = execution.getVariable("kadastraleObjecten") || {};

vermogenPartner.put("motorVoertuigen", rdw.motorVoertuigen || new ArrayList());
vermogenPartner.put("onroerendeGoederen", kad.onroerendeGoederen || new ArrayList());

vermogenPartner;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="duoPartner">
            <camunda:script scriptFormat="javascript">var HashMap = Java.type("java.util.HashMap");

var duoPartner = new HashMap();
var persoonsInformatieDuo = execution.getVariable("duoPersoonsInformatie") || new HashMap();

duoPartner.put("opleiding", persoonsInformatieDuo);
duoPartner;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="mappedUwvInfo">${uwvProcessDocumentService.mapUwvInfo(uwvInfo)}</camunda:outputParameter>
          <camunda:outputParameter name="duoStudiefinancieringPartner">
            <camunda:script scriptFormat="javascript">var HashMap = Java.type("java.util.HashMap");

var duoStudiefinancieringPartner = execution.getVariable("duoStudiefinancieringInfo") || new HashMap();

duoStudiefinancieringPartner;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="svbUitkeringenPartner">
            <camunda:script scriptFormat="javascript">var HashMap = Java.type("java.util.HashMap");

var svbUitkeringenPartner = execution.getVariable("svbUitkeringen") || new HashMap();

svbUitkeringenPartner;</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
