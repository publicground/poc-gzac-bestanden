              <camunda:entry key="svbUitkeringenPartner">${svbUitkeringenPartner}</camunda:entry>
              <camunda:entry key="duoPartner">${duoPartner}</camunda:entry>
              <camunda:entry key="duoStudiefinancieringPartner">${duoStudiefinancieringPartner}</camunda:entry>
              <camunda:entry key="vermogenPartner">${vermogenPartner}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:failedJobRetryTimeCycle>R30/PT2S</camunda:failedJobRetryTimeCycle>
