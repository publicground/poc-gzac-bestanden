    <bpmn:serviceTask id="WegschrijvenOutputTask" name="wegschrijven output" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling/vastleggenVoorschot&#34;,vastleggenVoorschot)}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="vastleggenVoorschot">
            <camunda:script scriptFormat="javascript">var vastleggenVoorschotArray = execution.getVariable("vastleggenVoorschotArray");
var voorschotData = execution.getVariable("voorschotData");

function addToArray(existingArray, newData) {
    existingArray = existingArray instanceof java.util.List ? Java.from(existingArray) : [];

    existingArray.push(newData);

    return java.util.Arrays.asList(existingArray);
}

addToArray(vastleggenVoorschotArray, voorschotData);</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:failedJobRetryTimeCycle>R30/PT2S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
