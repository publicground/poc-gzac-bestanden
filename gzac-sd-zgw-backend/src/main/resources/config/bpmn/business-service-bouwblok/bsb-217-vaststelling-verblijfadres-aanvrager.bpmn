        <camunda:in source="aanvragerVerblijfadres" target="verblijfadres" />
        <camunda:in source="adresBrp" target="brpWoonadres" />
        <camunda:in source="taakTitel" target="taakTitel" />
        <camunda:in source="vastgesteldVerblijfadres" target="vastgesteldVerblijfadres" />
        <camunda:in source="postadresBrp" target="postadresBrp" />
        <camunda:in source="toelichtingConsulent" target="toelichtingConsulent" />
        <camunda:in source="handmatigVaststellen" target="handmatigVaststellen" />
        <camunda:in source="teGebruikenAdres" target="teGebruikenAdres" />
        <camunda:in source="prefillHandmatigIngevoerdAdres" target="prefillHandmatigIngevoerdAdres" />
        <camunda:in source="opgegevenVerblijfadres" target="opgegevenVerblijfadres" />
        <camunda:out source="verblijfadresVastgesteld" target="verblijfadresVastgesteld" />
        <camunda:out source="datumVastgesteld" target="datumVastgesteld" />
        <camunda:out source="toelichtingConsulent" target="toelichtingConsulent" />
        <camunda:out source="vastgesteldVerblijfadres" target="vastgesteldVerblijfadres" />
        <camunda:out source="teGebruikenAdres" target="teGebruikenAdres" />
        <camunda:out source="isHandmatigBeoordeeld" target="isHandmatigBeoordeeld" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1n8c6ww</bpmn:incoming>
      <bpmn:outgoing>Flow_1vt0mho</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="WegschrijvenOutputVerblijfadresTask" name="wegschrijven output &#39;verblijfadres&#39;" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling/aanvrager/verblijfadres&#34;, vastgesteldVerblijfadres)}">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R30/PT2S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1vt0mho</bpmn:incoming>
      <bpmn:outgoing>Flow_0kp4yds</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="VerblijfadresAanvragerVastgesteldEndEvent" name="Verblijfadres aanvrager vastgesteld">
      <bpmn:incoming>Flow_0khy473</bpmn:incoming>
