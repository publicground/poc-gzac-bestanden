    <bpmn:sequenceFlow id="Flow_1vt0mho" sourceRef="Bs217VaststellingVerblijfadresCallActivity" targetRef="WegschrijvenOutputVerblijfadresTask" />
    <bpmn:serviceTask id="OphalenInputTask" name="ophalen input" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="isVerblijfadresVastgesteld">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/additioneleVeldenAanvrager/verblijfadres/verblijfadresVastgesteld")}</camunda:inputParameter>
          <camunda:outputParameter name="verblijfadresVastgesteld">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/additioneleVeldenAanvrager/verblijfadres/verblijfadresVastgesteld")}</camunda:outputParameter>
          <camunda:outputParameter name="datumVastgesteld">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/additioneleVeldenAanvrager/verblijfadres/datumVastgesteld")}</camunda:outputParameter>
          <camunda:outputParameter name="aanvragerToelichtingVerblijftElders">${isVerblijfadresVastgesteld ? valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/aanvrager/verblijfadres/toelichtingNietIngeschrevenOpVerblijfadres") : valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/aanvrager/verblijfadres/toelichtingNietIngeschrevenOpVerblijfadres")}</camunda:outputParameter>
          <camunda:outputParameter name="aanvragerVerblijfadres">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/aanvrager/woonsituatie") == "ELDERS" ||  valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/aanvrager/woonsituatie") == "DETENTIE" ? valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/aanvrager/verblijfadres") : valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/aanvrager/adresBrp")}</camunda:outputParameter>
          <camunda:outputParameter name="adresBrp">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitBronnen/aanvrager/adresBrp")}</camunda:outputParameter>
          <camunda:outputParameter name="taakTitel">Selecteren verblijfadres aanvrager</camunda:outputParameter>
          <camunda:outputParameter name="vastgesteldVerblijfadres">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/aanvrager/verblijfadres")}</camunda:outputParameter>
          <camunda:outputParameter name="postadresBrp">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitBronnen/aanvrager/postadresBrp")}</camunda:outputParameter>
          <camunda:outputParameter name="toelichtingConsulent">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/additioneleVeldenAanvrager/verblijfadres/toelichtingConsulent")}</camunda:outputParameter>
          <camunda:outputParameter name="handmatigVaststellen">${execution.getVariable("handmatigVaststellen") ? handmatigVaststellen : false}</camunda:outputParameter>
          <camunda:outputParameter name="teGebruikenAdres">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/additioneleVeldenAanvrager/verblijfadres/teGebruikenAdres")}</camunda:outputParameter>
          <camunda:outputParameter name="prefillHandmatigIngevoerdAdres">${teGebruikenAdres == "anders" ? vastgesteldVerblijfadres : null}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0fido0a</bpmn:incoming>
      <bpmn:outgoing>Flow_1n8c6ww</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Bs217VaststellingVerblijfadresCallActivity" name="bs 217 vaststelling verblijfadres" camunda:asyncAfter="true" calledElement="bs-217-vaststelling-verblijfadres">
