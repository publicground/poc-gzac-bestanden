    <bpmn:serviceTask id="WegschrijvenOutputAdditioneleVeldenAanvragerTask" name="wegschrijven output &#39;additioneleVeldenAanvrager&#39;" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling/additioneleVeldenAanvrager/verblijfadres&#34;,additioneleVeldenAanvrager)}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="additioneleVeldenAanvrager">
