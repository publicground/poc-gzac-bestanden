      <bpmn:outgoing>Flow_0fido0a</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0fido0a" sourceRef="StartVaststellingVerblijfadresAanvragerStartEvent" targetRef="OphalenInputTask" />
    <bpmn:sequenceFlow id="Flow_1n8c6ww" sourceRef="OphalenInputTask" targetRef="Bs217VaststellingVerblijfadresCallActivity" />
