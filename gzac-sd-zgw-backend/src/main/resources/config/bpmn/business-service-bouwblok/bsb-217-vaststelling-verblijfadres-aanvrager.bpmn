  <bpmn:collaboration id="Collaboration_1b2fl1n">
    <bpmn:participant id="BSB217VaststellingVerblijfadresAanvragerParticipant" name="BSB 217 vaststelling verblijfadres aanvrager" processRef="bsb-217-vaststelling-verblijfadres-aanvrager" />
