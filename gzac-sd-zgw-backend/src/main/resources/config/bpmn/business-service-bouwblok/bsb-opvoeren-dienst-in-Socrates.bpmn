    <bpmn:serviceTask id="VoorbereidenRedenAanvraagTask" name="Voorbereiden &#10;&#39;redenAanvraag&#39;" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="redenAanvraag">${valueResolverDelegateService.resolveValue(execution, "doc:gegevensVanuitAanvraag.redenAanvraag")}</camunda:inputParameter>
          <camunda:outputParameter name="redenAanvraagLevensonderhoud">
            <camunda:map>
              <camunda:entry key="onvoldoendeInkomen">${(redenAanvraag.gestopteDetentie != null &amp;&amp; redenAanvraag.gestopteDetentie.size() &gt; 0    &amp;&amp; redenAanvraag.gestopteDetentie[redenAanvraag.gestopteDetentie.size() - 1].detentieDuur != null)  ? "10"  : (      (redenAanvraag.andereRedenVerzoek != null &amp;&amp; redenAanvraag.andereRedenVerzoek.size() &gt; 0         &amp;&amp; redenAanvraag.andereRedenVerzoek[redenAanvraag.andereRedenVerzoek.size() - 1].geldtekortSpecificatie != null)      ? "11"      : (redenAanvraag.onvoldoendeInkomen != null ? redenAanvraag.onvoldoendeInkomen.code : null)    )}</camunda:entry>
              <camunda:entry key="verblijfstatus">${redenAanvraag.verblijfstatus.code}</camunda:entry>
              <camunda:entry key="wijzigingGezin">${redenAanvraag.wijzigingGezin.code}</camunda:entry>
              <camunda:entry key="zelfstandige">${redenAanvraag.zelfstandige.code}</camunda:entry>
              <camunda:entry key="gestopteUitkering">${redenAanvraag.gestopteUitkering[redenAanvraag.gestopteUitkering.size() - 1].uitkering.code}</camunda:entry>
            </camunda:map>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0dl95mi</bpmn:incoming>
      <bpmn:outgoing>Flow_1ddrqqg</bpmn:outgoing>
    </bpmn:serviceTask>
