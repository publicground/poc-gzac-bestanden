    <bpmn:scriptTask id="VoorbereidenAdresTask" name="Voorbereiden &#10;&#39;Adres&#39;" camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="adresList">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_0ncl701</bpmn:incoming>
      <bpmn:outgoing>Flow_1use7sh</bpmn:outgoing>
      <bpmn:script>var HashMap = Java.type("java.util.HashMap");
var ArrayList = Java.type("java.util.ArrayList");

// Property accessor
function getProp(obj, name) {
  if (obj == null) return null;
  if (typeof obj.get === 'function') return obj.get(name);
  if (obj[name] !== undefined) return obj[name];
  var getter = 'get' + name.charAt(0).toUpperCase() + name.slice(1);
  if (typeof obj[getter] === 'function') return obj[getter]();
  return null;
}

function hasAddressData(addr) {
  if (addr == null) return false;
  if (typeof addr.get === 'function') {
    try {
      if (typeof addr.isEmpty === 'function') return !addr.isEmpty();
      if (typeof addr.keySet === 'function') return Java.from(addr.keySet()).length &gt; 0;
    } catch (e) { /* ignore */ }
    return true;
  }
  if (typeof addr === 'object') return Object.keys(addr).length &gt; 0;
  return true;
}

// --- minimal cleanAddress: remove empty-string properties and always remove aanduidingBijHuisnummer
function cleanAddress(addr) {
  if (addr == null) return;
  var it = addr.keySet().iterator();
  while (it.hasNext()) {
    var key = it.next();
    var val = addr.get(key);
    // remove empty-string properties
    if (typeof val === 'string' &amp;&amp; val.trim() === '') {
      it.remove();
      continue;
    }
    // remove aanduidingBijHuisnummer (case-insensitive)
    if (String(key).trim().toLowerCase() === 'aanduidingbijhuisnummer') {
      it.remove();
    }
  }
}

// set SoortAdres explicitly
function setSoortAdres(addr, soort) {
  if (!hasAddressData(addr)) return;
  if (typeof addr.get === 'function') {
    try { addr.put('SoortAdres', soort); } catch (e) { /* ignore */ }
  } else if (typeof addr === 'object') {
    addr.SoortAdres = soort;
  }
}

// normalize comparison key: postcode;huisnummer;huisletter;huisnummertoevoeging (no spaces, upper)
function normalizeAddressKey(addr) {
  if (!hasAddressData(addr)) return "";
  try {
    var postcode = getProp(addr, 'postcode') || "";
    var huisnummer = getProp(addr, 'huisnummer');
    huisnummer = (huisnummer === null || huisnummer === undefined) ? "" : String(huisnummer);
    var huisletter = getProp(addr, 'huisletter') || "";
    var huisnummertoevoeging = getProp(addr, 'huisnummertoevoeging') || "";

    var raw = postcode + ";" + huisnummer + ";" + huisletter + ";" + huisnummertoevoeging;
    return String(raw).replace(/\s+/g, "").toUpperCase();
  } catch (e) {
    return "";
  }
}

// --- variables
var requestDate = execution.getVariable('aanvraagdatum');
var applicant = execution.getVariable('bronGegevensAanvrager') || {};
var partner = execution.getVariable('bronGegevensMedeaanvrager') || {};
var aanvragerVerblijfadres = execution.getVariable('aanvragerVerblijfadres') || {};
var medeaanvragerVerblijfadres = execution.getVariable('medeaanvragerVerblijfadres') || {};

var applicantAddresses = new ArrayList();
var partnerAddresses = new ArrayList();

function addAddressIfPresent(entity, fieldName, roleCode, list, soort) {
  var addr = getProp(entity, fieldName);
  if (!hasAddressData(addr)) return;
  setSoortAdres(addr, soort);
  cleanAddress(addr);
  var entry = new HashMap();
  entry.put('codeFunctieAdres', roleCode);
  entry.put('begindatum', requestDate);
  entry.put('adres', addr);
  list.add(entry);
}

// add verblijfadres only if not equal to entity.adresBrp (compare normalized key)
// if adresBrp missing/empty add the verblijfadres
function addVerblijfIfUniqueAgainstAdresBrp(verblijfAddr, ownerEntity, roleCode, list) {
  if (!hasAddressData(verblijfAddr)) return;

  var adresBrp = getProp(ownerEntity, 'adresBrp');
  var keyBrp = normalizeAddressKey(adresBrp);
  var keyVerblijf = normalizeAddressKey(verblijfAddr);

  // if adresBrp has a meaningful key and matches the verblijf key =&gt; skip
  if (keyBrp &amp;&amp; keyVerblijf &amp;&amp; keyBrp === keyVerblijf) return;

  setSoortAdres(verblijfAddr, '1'); // verblijfadressen are SoortAdres = '1'
  cleanAddress(verblijfAddr);
  var entry = new HashMap();
  entry.put('codeFunctieAdres', roleCode);
  entry.put('begindatum', requestDate);
  entry.put('adres', verblijfAddr);
  list.add(entry);
}

// build lists
// adresBrp -&gt; W, SoortAdres = '1'
// postadresBrp -&gt; B, SoortAdres = '1'
addAddressIfPresent(applicant, 'adresBrp', 'W', applicantAddresses, '1');
addAddressIfPresent(applicant, 'postadresBrp', 'B', applicantAddresses, '1');
addAddressIfPresent(partner, 'adresBrp', 'W', partnerAddresses, '1');
addAddressIfPresent(partner, 'postadresBrp', 'B', partnerAddresses, '1');

// add verblijfadres only when unique vs adresBrp (compare against adresBrp only)
addVerblijfIfUniqueAgainstAdresBrp(aanvragerVerblijfadres, applicant, 'A', applicantAddresses);
addVerblijfIfUniqueAgainstAdresBrp(medeaanvragerVerblijfadres, partner, 'A', partnerAddresses);

// result
var result = new HashMap();
result.put('aanvragerAdresList', applicantAddresses);
result.put('medeaanvragerAdresList', partnerAddresses);

result;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="VoorbereidenHuishoudingTask" name="Voorbereiden &#39;huishouding&#39;" scriptFormat="javascript" camunda:resultVariable="huishouding">
      <bpmn:incoming>Flow_1163glh</bpmn:incoming>
      <bpmn:outgoing>Flow_0dl95mi</bpmn:outgoing>
      <bpmn:script>var HashMap = Java.type("java.util.HashMap");
var ArrayList = Java.type("java.util.ArrayList");

function getField(obj, name) {
  if (obj == null) return null;
  if (typeof obj.get === 'function') {
    try { return obj.get(name); } catch (e) { /* ignore */ }
  }
  if (obj[name] !== undefined) return obj[name];
  var getter = 'get' + name.charAt(0).toUpperCase() + name.slice(1);
  if (typeof obj[getter] === 'function') {
    try { return obj[getter](); } catch (e) { /* ignore */ }
  }
  return null;
}

function toDateOnly(iso) {
  if (iso == null) return null;
  var s = String(iso).trim();
  if (s.length === 0) return null;
  var t = s.indexOf('T');
  var datePart = t &gt; -1 ? s.substring(0, t) : s;
  if (/^\d{4}-\d{2}-\d{2}$/.test(datePart)) return datePart;
  if (datePart.length &gt;= 10 &amp;&amp; /^\d{4}/.test(datePart)) return datePart.substring(0, 10);
  return null;
}

function toInt(v, def) {
  if (v == null || v === '') return def;
  var n = parseInt(String(v), 10);
  return isNaN(n) ? def : n;
}

function firstInitialUpper(name) {
  if (name == null) return "";
  var t = String(name).trim();
  return t.length === 0 ? "" : t.substring(0,1).toUpperCase();
}

function mapPrivacyCode(code) {
  if (code == null) return 0;
  return String(code).trim() === 'GEEN_GEHEIMHOUDING' ? 0 : 1;
}

function mapNationaliteiten(nationaliteiten) {
  var out = new ArrayList();
  if (nationaliteiten == null) return out;
  if (typeof java !== 'undefined' &amp;&amp; nationaliteiten instanceof java.util.List) {
    for (var i = 0; i &lt; nationaliteiten.size(); i++) {
      var item = nationaliteiten.get(i);
      var code = getField(item, 'code');
      var num = toInt(code, null);
      if (num != null) out.add(num);
    }
  } else if (Array.isArray(nationaliteiten)) {
    for (var j = 0; j &lt; nationaliteiten.length; j++) {
      var it = nationaliteiten[j];
      var c = it &amp;&amp; (it.code !== undefined ? it.code : getField(it, 'code'));
      var nn = toInt(c, null);
      if (nn != null) out.add(nn);
    }
  }
  return out;
}

function mapPersoon(src, opgegevenPartner, bronGegevensPersoon, aanvraagDateForPartner) {
  var person = new HashMap();

  var aNummer = getField(src, 'anummer') || getField(src, 'aNummer') || "";
  person.put('aNummer', aNummer);

  var bsn = getField(src, 'bsn') || "";
  person.put('burgerservicenummer', bsn);

  var geboortedatum = toDateOnly(getField(src, 'geboortedatum'));
  person.put('geboortedatum', geboortedatum || "");

  var partnerMap = new HashMap();
  var ingangsHuwelijkRaw = getField(bronGegevensPersoon, 'ingangsdatumHuwelijk');
  var ingangsHuwelijk = toDateOnly(ingangsHuwelijkRaw);

  var opgegevenPartnerBsn = getField(opgegevenPartner, 'bsn');
  var bronPartnerBsn = getField(bronGegevensPersoon, 'partnerBsn');

var hasIngangsHuwelijk = ingangsHuwelijk != null &amp;&amp; ingangsHuwelijk !== "";

// only map partner when a partner was provided
if (opgegevenPartnerBsn) {
  // defaults
  var partnerRelatietype = 3;                 // 3 = ongehuwd
  var ingangsDatum = aanvraagDateForPartner; // fallback

  // if the provided BSN matches the source, treat as partner (gehuwd)
  if (opgegevenPartnerBsn === bronPartnerBsn) {
    partnerRelatietype = 1; // 1 = gehuwd / partner
    ingangsDatum = ingangsHuwelijk ? ingangsHuwelijk : aanvraagDateForPartner;
  }

  partnerMap.put('partnerRelatietype', partnerRelatietype);
  partnerMap.put('ingangsdatumRelatie', ingangsDatum);
  person.put('partner', partnerMap);
}

  var ga = getField(src, 'geslachtsAanduiding') || getField(src, 'geslachtsaanduiding');
  person.put('geslachtsaanduiding', toInt(ga, 0));

  var achternaam = getField(src, 'achternaam') || getField(src, 'geslachtsnaamstam') || "";
  person.put('geslachtsnaamstam', achternaam);

  var voornamen = getField(src, 'voornamen') || "";
  person.put('voorlettersAanschrijving', firstInitialUpper(voornamen));
  person.put('voornamen', voornamen);

  person.put('voorvoegsel', getField(src, 'voorvoegsel') || "");
  person.put('naamgebruik', toInt(getField(src, 'naamgebruik'), 0));
  person.put('geslachtsnaamPartner', getField(src, 'geslachtsnaamPartner') || "");
  person.put('codeBrpGegevensGeheim', mapPrivacyCode(getField(bronGegevensPersoon, 'codeBrpGegevensGeheim')));

  var natList = mapNationaliteiten(getField(src, 'nationaliteiten'));
  person.put('nationaliteit', natList);

  return person;
}

// --- main mapping
var aanvraagdatumRaw = execution.getVariable('aanvraagdatum');
var aanvraagdatum = toDateOnly(aanvraagdatumRaw) || "";

var aanvragerSrc = execution.getVariable('aanvrager') || {};
var medeaanvragerSrc = execution.getVariable('medeaanvrager');

var opgegevenPartnerAanvrager = execution.getVariable('medeaanvrager') || {};
var opgegevenPartnerMedeaanvrager = execution.getVariable('aanvrager') || {};

var bronGegevensAanvrager = execution.getVariable('bronGegevensAanvrager') || {};
var bronGegevensMedeaanvrager = execution.getVariable('bronGegevensMedeaanvrager') || {};

var uitbetalingUitkering = execution.getVariable('uitbetalingUitkering') || {};

var aanvragerMapped = mapPersoon(aanvragerSrc,opgegevenPartnerAanvrager, bronGegevensAanvrager, aanvraagdatum);
var medeaanvragerMapped = medeaanvragerSrc != null ? mapPersoon(medeaanvragerSrc, opgegevenPartnerMedeaanvrager, bronGegevensMedeaanvrager, aanvraagdatum) : null;

// --- adreshouding mapping
var adresList = execution.getVariable('adresList') || {};
var aanvragerAdresFromVar = getField(adresList, 'aanvragerAdresList') || new ArrayList();
var medeaanvragerAdresFromVar = getField(adresList, 'medeaanvragerAdresList') || new ArrayList();

if (aanvragerAdresFromVar &amp;&amp; (typeof java !== 'undefined' ? aanvragerAdresFromVar.size &amp;&amp; aanvragerAdresFromVar.size() &gt; 0 : aanvragerAdresFromVar.length &gt; 0)) {
  aanvragerMapped.put('adreshouding', aanvragerAdresFromVar);
}

if (medeaanvragerMapped != null &amp;&amp; medeaanvragerAdresFromVar &amp;&amp; (typeof java !== 'undefined' ? medeaanvragerAdresFromVar.size &amp;&amp; medeaanvragerAdresFromVar.size() &gt; 0 : medeaanvragerAdresFromVar.length &gt; 0)) {
  medeaanvragerMapped.put('adreshouding', medeaanvragerAdresFromVar);
}

var huishouding = new HashMap();
huishouding.put('aanvrager', aanvragerMapped);
huishouding.put('medeaanvrager', medeaanvragerMapped);

if(execution.getVariable('uitBetalingObjectFlag')) {
   huishouding.put('uitbetalingUitkering', 
   uitbetalingUitkering);
}

huishouding</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask id="OpnieuwProberenOpvoerenDienstInSocratesTask" name="Opnieuw proberen opvoeren dienst in socrates" camunda:candidateGroups="ROLE_ADMIN, ROLE_IV_BEHANDELAAR, ROLE_IV_SENIOR, ROLE_IV_MANAGEMENT, ROLE_IV_SUPERUSER, ROLE_IV_FUNCTIONEEL_BEHEER" camunda:priority="10">
      <bpmn:incoming>Flow_1opuz7n</bpmn:incoming>
      <bpmn:outgoing>Flow_1voeppl</bpmn:outgoing>
