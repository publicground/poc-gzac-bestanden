    <bpmn:scriptTask id="VoorbreidenUitbetalingUitkeringTask" name="Voorbreiden&#10;&#39;uitbetalingUitkering&#39;" scriptFormat="javascript" camunda:resultVariable="uitbetalingUitkering">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1use7sh</bpmn:incoming>
      <bpmn:outgoing>Flow_1163glh</bpmn:outgoing>
      <bpmn:script>var LinkedHashMap = Java.type("java.util.LinkedHashMap");

function getProp(obj, key) {
  if (obj == null) return null;
  if (typeof obj.get === 'function') {
    try { return obj.get(key); } catch (e) { /* ignore */ }
  }
  return obj[key] !== undefined ? obj[key] : null;
}

var bankrekeningAanvrager = execution.getVariable('bankrekeningAanvrager') || {};
var bankrekeningPartner = execution.getVariable('bankrekeningPartner') || {};
var wijzeVanUitbetaling = execution.getVariable('wijzeVanUitbetaling') || '';

var uitBetalingObjectFlag = false;

if(Object.keys(bankrekeningAanvrager).length &gt; 0 
    || Object.keys(bankrekeningPartner).length &gt; 0 ) {
  uitBetalingObjectFlag = true;
}


if(!wijzeVanUitbetaling &amp;&amp; uitBetalingObjectFlag) {
  
  // check bank account presence
  if(Object.keys(bankrekeningAanvrager).length &gt; 0 
    &amp;&amp; Object.keys(bankrekeningPartner).length === 0 ) {
     wijzeVanUitbetaling = 'VOLLEDIG_AANVRAGER'
  }
}

var result = new LinkedHashMap();

// set flag
execution.setVariable('uitBetalingObjectFlag', uitBetalingObjectFlag);

if (wijzeVanUitbetaling === 'VOLLEDIG_AANVRAGER') {
  result.put('bankrekening', getProp(bankrekeningAanvrager, 'iban'));
  result.put('rekeninghouder', getProp(bankrekeningAanvrager, 'tenaamstelling'));
  result.put('soortUitbetaling', '01');
} else if (wijzeVanUitbetaling === 'VOLLEDIG_PARTNER') {
  result.put('bankrekeningPartner', getProp(bankrekeningPartner, 'iban'));
  result.put('rekeninghouderPartner', getProp(bankrekeningPartner, 'tenaamstelling'));
  result.put('soortUitbetaling', '02');
} else if (wijzeVanUitbetaling === 'VERDEELD_AANVRAGER_PARTNER') {
  result.put('bankrekening', getProp(bankrekeningAanvrager, 'iban'));
  result.put('rekeninghouder', getProp(bankrekeningAanvrager, 'tenaamstelling'));
  result.put('bankrekeningPartner', getProp(bankrekeningPartner, 'iban'));
  result.put('rekeninghouderPartner', getProp(bankrekeningPartner, 'tenaamstelling'));
  result.put('soortUitbetaling', '03');
}

result;</bpmn:script>
    </bpmn:scriptTask>
