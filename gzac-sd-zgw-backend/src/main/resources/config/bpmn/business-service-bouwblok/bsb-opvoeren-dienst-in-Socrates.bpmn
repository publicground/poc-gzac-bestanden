      <bpmn:script>var HashMap = Java.type("java.util.HashMap");
var ArrayList = Java.type("java.util.ArrayList");

var result = new ArrayList();

// first element
var item1 = new HashMap();
item1.put("Naam", "9");

var rolList1 = new ArrayList();
var rol1 = new HashMap();
rol1.put("Rolomschrijving", "BehandelaarAfdeling");
rolList1.add(rol1);

item1.put("Rol", rolList1);
result.add(item1);

// second element
var item2 = new HashMap();
item2.put("Naam", "21");

var rolList2 = new ArrayList();
var rol2 = new HashMap();
rol2.put("Rolomschrijving", "BehandelaarTeam");
rolList2.add(rol2);

item2.put("Rol", rolList2);
result.add(item2);

result</bpmn:script>
