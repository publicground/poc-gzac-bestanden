            <camunda:script scriptFormat="javascript">var UUID = Java.type('java.util.UUID');
var id = UUID.randomUUID().toString();
id;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="codeOntvangendeGemeente">0518</camunda:outputParameter>
          <camunda:outputParameter name="ingangBijstandsuitkering">
            <camunda:map>
              <camunda:entry key="datumMeldingBijGemeente">${dateTime().parse(gegevensVanuitAanvraag.startDatum).toLocalDate().toString("yyyy-MM-dd")}</camunda:entry>
              <camunda:entry key="gewensteStartdatumUitkering">${dateTime().parse(gegevensVanuitAanvraag.startDatum).toLocalDate().toString("yyyy-MM-dd")}</camunda:entry>
            </camunda:map>
          </camunda:outputParameter>
          <camunda:outputParameter name="aanvragerVerblijfadres">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/aanvrager/woonsituatie") == "ELDERS" ||  valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/aanvrager/woonsituatie") == "DETENTIE" ? valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/aanvrager/verblijfadres") : null}</camunda:outputParameter>
          <camunda:outputParameter name="medeaanvragerVerblijfadres">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/partner/woonsituatie") == "ELDERS" ||  valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/partner/woonsituatie") == "DETENTIE" ? valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/partner/verblijfadres") : null}</camunda:outputParameter>
          <camunda:outputParameter name="bankrekeningAanvrager">
            <camunda:script scriptFormat="javascript">var gegevens = execution.getVariable("gegevensVanuitAanvraag");

var bankrekening = gegevens
  &amp;&amp; gegevens.uitbetaling
  &amp;&amp; gegevens.uitbetaling.aanvrager
  &amp;&amp; gegevens.uitbetaling.aanvrager.bankrekening;

if (bankrekening &amp;&amp; bankrekening.iban) {
  var sanitizedBankAccountNumber = String(bankrekening.iban)
    .replace(/\s+/g, "")
    .toUpperCase();

  bankrekening.iban = sanitizedBankAccountNumber;
}

bankrekening;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="bankrekeningPartner">
            <camunda:script scriptFormat="javascript">var gegevens = execution.getVariable("gegevensVanuitAanvraag");

var bankrekening = gegevens
  &amp;&amp; gegevens.uitbetaling
  &amp;&amp; gegevens.uitbetaling.partner
  &amp;&amp; gegevens.uitbetaling.partner.bankrekening;

if (bankrekening &amp;&amp; bankrekening.iban) {
  var sanitizedBankAccountNumber = String(bankrekening.iban)
    .replace(/\s+/g, "")
    .toUpperCase();

  bankrekening.iban = sanitizedBankAccountNumber;
}

bankrekening;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="wijzeVanUitbetaling">${gegevensVanuitAanvraag.uitbetaling.wijzeVanUitbetaling}</camunda:outputParameter>
          <camunda:outputParameter name="aanvrager">${gegevensVaststelling.aanvrager}</camunda:outputParameter>
          <camunda:outputParameter name="medeaanvrager">${gegevensVaststelling.partner}</camunda:outputParameter>
          <camunda:outputParameter name="bronGegevensAanvrager">${gegevensVanuitBronnen.aanvrager}</camunda:outputParameter>
          <camunda:outputParameter name="bronGegevensMedeaanvrager">${gegevensVanuitBronnen.partner}</camunda:outputParameter>
        </camunda:inputOutput>
