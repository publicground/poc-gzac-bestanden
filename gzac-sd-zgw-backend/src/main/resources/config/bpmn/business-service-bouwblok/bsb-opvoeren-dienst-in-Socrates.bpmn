    <bpmn:serviceTask id="OphalenInputTask" name="Ophalen input" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="gegevensVanuitBronnen">${valueResolverDelegateService.resolveValue(execution, "doc:gegevensVanuitBronnen")}</camunda:inputParameter>
