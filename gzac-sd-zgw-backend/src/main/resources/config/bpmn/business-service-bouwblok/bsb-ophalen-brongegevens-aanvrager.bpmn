    <bpmn:serviceTask id="WegschrijvenLogOphalenBrongegevensTask" name="wegschrijven log ophalen brongegevens" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/ophalenBronGegevens&#34;, nieuwBrongegevensArray)}">
