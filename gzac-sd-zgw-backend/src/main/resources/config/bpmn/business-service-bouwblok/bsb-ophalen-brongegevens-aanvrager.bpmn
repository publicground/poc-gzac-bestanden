              <camunda:entry key="duoStudiefinancieringAanvrager">${duoStudiefinancieringAanvrager}</camunda:entry>
              <camunda:entry key="vermogenAanvrager">${vermogenAanvrager}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
