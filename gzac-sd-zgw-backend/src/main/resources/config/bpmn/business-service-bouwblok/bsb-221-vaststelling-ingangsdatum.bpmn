        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_00p8ikz_di" bpmnElement="IngangsdatumUitkeringVastgesteldEndEvent">
        <dc:Bounds x="1224" y="187" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1211" y="230" width="70" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_0wnigc3" bpmnElement="Flow_1wsndi2">
        <di:waypoint x="390" y="205" />
        <di:waypoint x="430" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_1q04wot" bpmnElement="Flow_0cq6a0r">
        <di:waypoint x="680" y="205" />
        <di:waypoint x="730" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0s4o3zt_di" bpmnElement="Flow_0s4o3zt">
        <di:waypoint x="830" y="205" />
        <di:waypoint x="890" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1m7c3jf_di" bpmnElement="Flow_1m7c3jf">
        <di:waypoint x="530" y="205" />
        <di:waypoint x="580" y="205" />
      </bpmndi:BPMNEdge>
