        <di:waypoint x="990" y="205" />
        <di:waypoint x="1050" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10zz0ay_di" bpmnElement="Flow_10zz0ay">
