          <camunda:outputParameter name="opgegevenNationaliteitOfVerblijfsstatus">${valueResolverDelegateService.resolveValue(execution,"doc:/gegevensVanuitAanvraag/partner/nationaliteitOfVerblijfsstatus")}</camunda:outputParameter>
          <camunda:outputParameter name="actiesVerblijfstatus">${isVerblijfstitelVastgesteld ? valueResolverDelegateService.resolveValue(execution,"doc:/gegevensVaststelling/partner/actiesVerblijfstatus") : valueResolverDelegateService.resolveValue(execution,"doc:/gegevensVanuitAanvraag/partner/actiesVerblijfstatus")}</camunda:outputParameter>
