    <bpmn:serviceTask id="WegschrijvenOutputTask" name="wegschrijven output &#39;vaststellingInformatie&#39;" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling/additioneleVeldenPartner/bs213verblijfstitel&#34;, vaststellingInformatie)}">
