    <bpmn:serviceTask id="OphalenInputTask" name="ophalen input" camunda:asyncAfter="true" camunda:expression="${true}" camunda:resultVariable="OphalenInputTask">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="vermogen">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/vermogen")}</camunda:inputParameter>
