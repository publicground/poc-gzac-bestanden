          <camunda:inputParameter name="isVermogenVastgesteld">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/additioneleVeldenAanvrager/bs214vermogen/vermogenVastgesteld")}</camunda:inputParameter>
          <camunda:outputParameter name="aanvraagBankrekeningen">
            <camunda:script scriptFormat="javascript">var ArrayList = Java.type("java.util.ArrayList");
var HashMap = Java.type("java.util.HashMap");

var vermogen = execution.getVariable("vermogen") || {};
var bankrekeningen = vermogen.bankrekeningen || [];

var result = new ArrayList();

  for (var i = 0; i &lt; bankrekeningen.length; i++) {
    var bankRekening = bankrekeningen[i] || {};

    var iban = null;
    if (bankRekening.ibanNederland !== null &amp;&amp; bankRekening.ibanNederland !== undefined) {
      iban = bankRekening.ibanNederland;
    } else if (bankRekening.ibanBuitenland !== null &amp;&amp; bankRekening.ibanBuitenland !== undefined) {
      iban = bankRekening.ibanBuitenland;
    }

    if (bankRekening.saldoRekening === null || bankRekening.saldoRekening === undefined) {
      continue;
    }

    var row = new HashMap();

    if (iban !== null) {
      row.put("iban", iban);
    }

    row.put("waarde", bankRekening.saldoRekening);

    if (bankRekening.saldoDatum !== null &amp;&amp; bankRekening.saldoDatum !== undefined) {
      row.put("datumVaststelling", bankRekening.saldoDatum);
    }

    result.add(row);
  }

result</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="aanvraagBezittingen">
            <camunda:script scriptFormat="javascript">var ArrayList = Java.type("java.util.ArrayList");
var HashMap = Java.type("java.util.HashMap");

var v = execution.getVariable("vermogen") || {};

var soort = {
  contanten: { code: "2", name: "Contanten" },
  onroerend: { code: "4", name: "Overig onroerend goed" },
  motor: { code: "6", name: "Motorvoertuigen" },
  caravan: { code: "7", name: "Caravans" },
  belegging: { code: "16", name: "Beleggingsproduct (Aandeel, Lease, Effect, Obligatie, e.d.)" },
  crypto: { code: "19", name: "Digitale valuta (cryptomunten)" },
  overig: { code: "9", name: "Overige bezittingen" }
};

var result = new ArrayList();

function add(soortObj, waarde, omschrijving, identificatie) {
  if (waarde === null || waarde === undefined || waarde === "") return;

  var row = new HashMap();

  // Keep soortVermogenscomponent but as a Java map (not JS object)
  var soortMap = new HashMap();
  soortMap.put("code", soortObj.code);
  soortMap.put("name", soortObj.name);

  row.put("soortVermogenscomponent", soortMap);
  row.put("waarde", waarde);

  if (omschrijving) row.put("omschrijving", omschrijving);
  if (identificatie) row.put("kenteken", identificatie);

  result.add(row);
}

// contantGeld
if (v.contantGeld !== null &amp;&amp; v.contantGeld !== undefined) {
  add(soort.contanten, v.contantGeld, "Contanten", null);
}

// grond[]
var grond = v.grond || [];
for (var i = 0; i &lt; grond.length; i++) {
  var g = grond[i] || {};
  add(soort.onroerend, g.waarde, "Grond", null);
}

// motorVoertuigen[]
var motoren = v.motorVoertuigen || [];
for (var j = 0; j &lt; motoren.length; j++) {
  var m = motoren[j] || {};
  add(soort.motor, m.dagwaarde, "Motorvoertuig", m.kenteken || "");
}

// caravans[]
var caravans = v.caravans || [];
for (var k = 0; k &lt; caravans.length; k++) {
  var c = caravans[k] || {};
  add(soort.caravan, c.dagwaarde, "Caravan", null);
}

// vaartuigen[]
var vaartuigen = v.vaartuigen || [];
for (var l = 0; l &lt; vaartuigen.length; l++) {
  var b = vaartuigen[l] || {};
  add(soort.overig, b.waarde, "Vaartuig", null);
}

// cryptoCurrencies[]
var crypto = v.cryptoCurrencies || [];
for (var n = 0; n &lt; crypto.length; n++) {
  var cc = crypto[n] || {};
  add(soort.crypto, cc.waarde, "Crypto", null);
}

// beleggingsproducten[]
var beleggingen = v.beleggingsproducten || [];
for (var p = 0; p &lt; beleggingen.length; p++) {
  var bp = beleggingen[p] || {};
  add(soort.belegging, bp.waarde, "Beleggingsproduct", null);
}

result</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="aanvraagSchulden">
            <camunda:script scriptFormat="javascript">var ArrayList = Java.type("java.util.ArrayList");
var HashMap = Java.type("java.util.HashMap");

var vermogen = execution.getVariable("vermogen") || {};
var schulden = vermogen.schulden || [];

var result = new ArrayList();

for (var i = 0; i &lt; schulden.length; i++) {
  var s = schulden[i] || {};

  // skip empty values
  if (s.hoogteSchuld === null || s.hoogteSchuld === undefined || s.hoogteSchuld === "") {
    continue;
  }

  var row = new HashMap();

  // soortVermogenscomponent as Java Map
  var soortMap = new HashMap();
  soortMap.put("code", "12");
  soortMap.put("name", "Schulden uitgezonderd studieschuld");

  row.put("soortVermogenscomponent", soortMap);
  row.put("waarde", s.hoogteSchuld);

  if (s.schuldEiser !== null &amp;&amp; s.schuldEiser !== undefined &amp;&amp; s.schuldEiser !== "") {
    row.put("omschrijving", s.schuldEiser);
  }

  result.add(row);
}

// last expression = outputParameter value
result</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="aanvraagEigenWoning">
            <camunda:script scriptFormat="javascript">var ArrayList = Java.type("java.util.ArrayList");
var HashMap = Java.type("java.util.HashMap");

var v = execution.getVariable("vermogen") || {};
var koopwoningen = v.koopwoningen || [];

var soort = {
  eigenWoning: { code: "1", name: "Eigen woning (huis/woonschip/woonwagen in eigendom)" },
  gekoppeldProduct: { code: "15", name: "Levensverzekering/belegging gekoppeld aan hypotheek" },
  hypotheek: { code: "17", name: "Hypotheek eigen woning" }
};

var result = new ArrayList();

function add(soortObj, waarde, omschrijving, identificatie) {
  if (waarde === null || waarde === undefined || waarde === "") return;

  var row = new HashMap();

  var soortMap = new HashMap();
  soortMap.put("code", soortObj.code);
  soortMap.put("name", soortObj.name);

  row.put("soortVermogenscomponent", soortMap);
  row.put("waarde", waarde);

  if (omschrijving !== null &amp;&amp; omschrijving !== undefined &amp;&amp; omschrijving !== "") {
    row.put("omschrijving", omschrijving);
  }
  if (identificatie !== null &amp;&amp; identificatie !== undefined &amp;&amp; identificatie !== "") {
    row.put("identificatie", identificatie);
  }

  result.add(row);
}

for (var i = 0; i &lt; koopwoningen.length; i++) {
  var koopwoning = koopwoningen[i] || {};

  // Eigen woning (WOZ)
  add(soort.eigenWoning, koopwoning.woz, "Koopwoning (WOZ)", null);

  // Hypotheek eigen woning
  add(soort.hypotheek, koopwoning.hypotheekWaarde, "Hypotheek", null);
}

result</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="vastgesteldeVermogen">${vastgesteldeVermogen}</camunda:outputParameter>
          <camunda:outputParameter name="vastgesteldeBankrekeningen">
            <camunda:script scriptFormat="javascript">var ArrayList = Java.type("java.util.ArrayList");
var HashMap = Java.type("java.util.HashMap");

var isVermogenVastgesteld = execution.getVariable("isVermogenVastgesteld");
var vastgesteldeVermogen = execution.getVariable("vastgesteldeVermogen") || [];

var result = new ArrayList();

if (isVermogenVastgesteld) {
  var collected = [];

  if (typeof java !== 'undefined' &amp;&amp; vastgesteldeVermogen instanceof java.util.List) {
    for (var vi = 0; vi &lt; vastgesteldeVermogen.size(); vi++) {
      var item = vastgesteldeVermogen.get(vi) || {};
      var commentaar = item.commentaar !== undefined ? item.commentaar : (typeof item.get === 'function' ? item.get('commentaar') : null);
      if (commentaar === 'Bankrekeningen') {
        var comps = item.componenten !== undefined ? item.componenten : (typeof item.get === 'function' ? item.get('componenten') : []);
        if (typeof java !== 'undefined' &amp;&amp; comps instanceof java.util.List) {
          for (var ci = 0; ci &lt; comps.size(); ci++) {
            collected.push(comps.get(ci));
          }
        }
      }
    }
  }

  for (var e = 0; e &lt; collected.length; e++) {
    result.add(collected[e]);
  }

}

result</camunda:script>
          </camunda:outputParameter>
