          <camunda:outputParameter name="bankrekeningenToelichting">
            <camunda:script scriptFormat="javascript">var vastgesteldeVermogen = execution.getVariable("vastgesteldeVermogen");
var toelichting = null;

function getField(obj, name) {
  if (obj == null) return null;
  if (obj[name] !== undefined) return obj[name];
  if (typeof obj.get === 'function') return obj.get(name);
  return null;
}

if (typeof java !== 'undefined' &amp;&amp; vastgesteldeVermogen instanceof java.util.List) {
  for (var i = 0; i &lt; vastgesteldeVermogen.size(); i++) {
    var item = vastgesteldeVermogen.get(i);
    if (getField(item, 'commentaar') === 'Bankrekeningen') {
      toelichting = getField(item, 'toelichting');
      break;
    }
  }
}
toelichting;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="bezittingenToelichting">
            <camunda:script scriptFormat="javascript">var vastgesteldeVermogen = execution.getVariable("vastgesteldeVermogen");
var toelichting = null;

function getField(obj, name) {
  if (!obj) return null;
  if (typeof obj.get === 'function') {
    var v = obj.get(name);
    return v == null ? null : v;
  }
  return obj[name] == null ? null : obj[name];
}

if (vastgesteldeVermogen &amp;&amp; typeof vastgesteldeVermogen.size === 'function') {
  for (var i = 0; i &lt; vastgesteldeVermogen.size(); i++) {
    var item = vastgesteldeVermogen.get(i);
    var comment = String(getField(item, 'commentaar') || '');
    var t = getField(item, 'toelichting');

    if (comment === 'Bezittingen met vrijlatingen' || comment === 'Overige bezittingen') {
      toelichting = t;
      break;
    }
  }
}

toelichting;</camunda:script>
          </camunda:outputParameter>
