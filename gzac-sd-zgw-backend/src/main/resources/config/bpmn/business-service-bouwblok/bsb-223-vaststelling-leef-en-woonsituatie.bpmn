          <camunda:outputParameter name="woonsituatie">${isLeefEnWoonsituateVastgesteld ? valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/woonsituatie/woonsituatie") : valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag/woonsituatie/woonsituatie")}</camunda:outputParameter>
          <camunda:outputParameter name="toelichtingWoonsituatie">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/additioneleVeldenAanvraag/leefEnWoonsituatie/toelichtingWoonsituatie")} </camunda:outputParameter>
