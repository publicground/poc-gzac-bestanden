    <bpmn:scriptTask id="ControlerenOpTenlasteKomendeKinderenTask" name="controleren op tenlaste komende kinderen" camunda:asyncAfter="true" scriptFormat="javascript" camunda:resultVariable="tenlasteKomendeKinderen">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_00qqsf3</bpmn:incoming>
      <bpmn:outgoing>Flow_1iimltk</bpmn:outgoing>
      <bpmn:script>var kinderen = execution.getVariable("kinderen");
var aanvragerThuiswonendeKinderen = execution.getVariable("aanvragerThuiswonendeKinderen");
kinderen = kinderen instanceof java.util.List ? Java.from(kinderen) : [];

var result = 'NEE';
if (aanvragerThuiswonendeKinderen === 'JA') {
  result = tenlasteKomendeKinderen();
}

function isKindOnder18(geboortedatum) {
  const geboortedatumKind = new Date(geboortedatum);
  if (isNaN(geboortedatumKind)) return null;
  const today = new Date();

  const datumOnder18 = new Date(today.getFullYear() - 18, today.getMonth(), today.getDate());

  if (geboortedatumKind &gt; datumOnder18) {
    return true;
  } else {
    return false;
  }
}

function tenlasteKomendeKinderen() {
  for (var i = 0; i &lt; kinderen.length; i++) {
    var kind = kinderen[i];
    if (kind.geboortedatum &amp;&amp; kind.kinderbijslag === 'JA') {
      var isOnder18 = isKindOnder18(kind.geboortedatum);
      if (isOnder18) {
        return 'JA';
        break;
      }
    }
  }
  return 'NEE';
}

result;
</bpmn:script>
    </bpmn:scriptTask>
