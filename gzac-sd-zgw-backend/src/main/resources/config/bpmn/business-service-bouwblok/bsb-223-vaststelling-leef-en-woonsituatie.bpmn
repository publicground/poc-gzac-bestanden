          <camunda:outputParameter name="art23Lid3VanToepassing">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/additioneleVeldenAanvraag/leefEnWoonsituatie/art23Lid3VanToepassing")} </camunda:outputParameter>
          <camunda:outputParameter name="aanvragerThuiswonendeKinderen">${valueResolverDelegateService.resolveValue(execution,(isLeefEnWoonsituateVastgesteld ? "doc:/gegevensVaststelling" : "doc:/gegevensVanuitAanvraag").concat("/aanvrager/heeftThuiswonendeKinderen"))}</camunda:outputParameter>
          <camunda:outputParameter name="kinderen">${ valueResolverDelegateService.resolveValue(execution,(isLeefEnWoonsituateVastgesteld ? "doc:/gegevensVaststelling" : "doc:/gegevensVanuitAanvraag").concat("/kinderen"))}</camunda:outputParameter>
