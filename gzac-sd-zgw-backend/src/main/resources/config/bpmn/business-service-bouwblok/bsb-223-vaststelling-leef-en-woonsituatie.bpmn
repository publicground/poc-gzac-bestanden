              <camunda:entry key="toelichtingLeefsituatie">${toelichtingLeefsituatie}</camunda:entry>
              <camunda:entry key="datumVastgesteld">${now().toInstant().toString()}</camunda:entry>
              <camunda:entry key="leefEnWoonsituateVastgesteld">${true}</camunda:entry>
              <camunda:entry key="isHandmatigBeoordeeld">${handmatigVaststellenWoon || handmatigVaststellenLeef ? true : false}</camunda:entry>
              <camunda:entry key="tenlasteKomendeKinderen">${tenlasteKomendeKinderen}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
