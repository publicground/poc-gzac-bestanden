    <bpmn:serviceTask id="VerwijderenMedebewonersUitVaststellingTask" name="verwijderen medebewoners uit vaststelling" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling/medebewoners&#34;, null)}" camunda:resultVariable="">
