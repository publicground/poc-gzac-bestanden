  <bpmn:collaboration id="Collaboration_0z8k1j7">
    <bpmn:participant id="Bsb216VaststellingRelatiesParticipant" name="bsb 216 vaststelling relaties" processRef="bsb-216-vaststelling-relaties" />
    <bpmn:textAnnotation id="TextAnnotation_0mane03">
      <bpmn:text>Personen die verblijven op het vastgestelde verblijfadres van de aanvrager
- partner (uit aanvraag en BRP)
- alle medebewoners op verblijfadres aanvrager (uit aanvraag en BRP)
- alle kinderen van de aanvrager (uit aanvraag en BRP)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1oqzx7r" associationDirection="None" sourceRef="OphalenInputTask" targetRef="TextAnnotation_0mane03" />
  </bpmn:collaboration>
  <bpmn:process id="bsb-216-vaststelling-relaties" name="BSB 216 vaststelling relaties" isExecutable="true">
    <bpmn:startEvent id="Event_0tbrgkr">
      <bpmn:outgoing>Flow_1qz0lon</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="OphalenInputTask" name="ophalen input" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="gegevensVaststelling">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling")}</camunda:outputParameter>
          <camunda:outputParameter name="gegevensVanuitAanvraag">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVanuitAanvraag")}</camunda:outputParameter>
          <camunda:outputParameter name="relaties">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/aanvrager/relaties")}</camunda:outputParameter>
          <camunda:outputParameter name="toelichting">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/additioneleVeldenAanvrager/bs216relaties/toelichting")}</camunda:outputParameter>
          <camunda:outputParameter name="partnerRelaties">${valueResolverDelegateService.resolveValue(execution, "doc:/gegevensVaststelling/partner/relaties")}</camunda:outputParameter>
          <camunda:outputParameter name="aanvraagDatum">${valueResolverDelegateService.resolveValue(execution, "case:createdOn")}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1qz0lon</bpmn:incoming>
      <bpmn:outgoing>Flow_15c7n3g</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Bs216VaststellingRelatiesCallActivity" name="bs 216 vaststelling relaties" camunda:asyncAfter="true" calledElement="bs-216-vaststelling-relaties">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="gegevensVaststelling" target="gegevensVaststelling" />
        <camunda:in source="gegevensVanuitAanvraag" target="gegevensVanuitAanvraag" />
        <camunda:in source="relaties" target="vastgesteldeRelaties" />
        <camunda:in source="toelichting" target="toelichting" />
        <camunda:in source="partnerRelaties" target="partnerRelaties" />
        <camunda:in source="aanvraagDatum" target="aanvraagDatum" />
        <camunda:out source="relaties" target="relaties" />
        <camunda:out source="toelichting" target="toelichting" />
        <camunda:out source="partnerRelaties" target="partnerRelaties" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15c7n3g</bpmn:incoming>
      <bpmn:outgoing>Flow_0ac0aux</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="WegschrijvenOutputVastgesteldeRelatiesTask" name="wegschrijven output vastgestelde relaties" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling/aanvrager/relaties&#34;, relaties)}" camunda:resultVariable="">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R30/PT2S</camunda:failedJobRetryTimeCycle>
