    <bpmn:serviceTask id="WegschrijvenOutputVastgesteldePartnerRelatiesTask" name="wegschrijven output vastgestelde partner relaties" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling/partner/relaties&#34;, partnerRelaties)}" camunda:resultVariable="">
