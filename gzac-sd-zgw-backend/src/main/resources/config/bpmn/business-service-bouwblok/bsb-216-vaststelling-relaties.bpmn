    <bpmn:serviceTask id="WegschrijvenOutputVaststellingTask" name="wegschrijven output vaststelling" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling/additioneleVeldenAanvrager/bs216relaties&#34;, additioneleVelden)}" camunda:resultVariable="">
