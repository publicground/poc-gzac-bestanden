              <camunda:entry key="isHandmatigBeoordeeld">${true}</camunda:entry>
              <camunda:entry key="toelichting">${toelichting}</camunda:entry>
              <camunda:entry key="relatieVastgesteld">${true}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:failedJobRetryTimeCycle>R30/PT2S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yr9p7o</bpmn:incoming>
      <bpmn:outgoing>Flow_0mxm75v</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="VerwijderenKinderenUitVaststellingTask" name="verwijderen kinderen uit vaststelling" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling/kinderen&#34;, null)}" camunda:resultVariable="">
