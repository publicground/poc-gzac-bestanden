    <bpmn:serviceTask id="WegschrijvenOutputVoorzieningenTask" name="wegschrijven output &#39;voorzieningen&#39;" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#39;doc:/besluiten/&#39;.concat(0).concat(&#39;/dienst/&#39;).concat(0).concat(&#39;/aanvrager/voorliggendeVoorzieningen&#39;), voorzieningen)}">
      <bpmn:extensionElements>
