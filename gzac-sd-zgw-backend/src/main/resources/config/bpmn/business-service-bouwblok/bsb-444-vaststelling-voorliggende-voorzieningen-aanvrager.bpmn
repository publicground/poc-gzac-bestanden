    <bpmn:serviceTask id="WegschrijvenOutputAdditioneleVeldenTask" name="wegschrijven output &#39;additioneleVelden&#39;" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/gegevensVaststelling/additioneleVeldenAanvrager/bs444VoorliggendeVoorzieningen&#34;, additioneleVelden)}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
