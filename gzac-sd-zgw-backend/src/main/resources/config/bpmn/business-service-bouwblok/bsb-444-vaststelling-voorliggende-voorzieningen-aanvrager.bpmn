  <bpmn:process id="bsb-444-vaststelling-voorliggende-voorzieningen-aanvrager" name="BSB 444 vaststelling voorliggende voorzieningen aanvrager" isExecutable="true">
    <bpmn:serviceTask id="OphalenInputTask" name="ophalen input" camunda:asyncAfter="true" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
