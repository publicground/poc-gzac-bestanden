          <camunda:outputParameter name="vastgesteldeVoorliggendeVoorzieningen">${valueResolverDelegateService.resolveValue(execution, 'doc:/besluiten/'.concat(0).concat('/dienst/').concat(0).concat('/aanvrager/voorliggendeVoorzieningen'))}</camunda:outputParameter>
