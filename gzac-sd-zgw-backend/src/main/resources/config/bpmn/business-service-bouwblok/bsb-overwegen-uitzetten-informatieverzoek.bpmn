    <bpmn:serviceTask id="WegschrijvenOutputTask" name="Wegschrijven output" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/informatieverzoeken&#34;, newInformatieverzoeken)}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="newInformatieverzoeken">
            <camunda:script scriptFormat="javascript">var informatieverzoekenArray = execution.getVariable("informatieverzoekenArray");
var verzoek = execution.getVariable("verzoek");

function addToArray(existingArray, newData) {
    existingArray = existingArray instanceof java.util.List ? Java.from(existingArray) : [];

    var map = new java.util.HashMap();
    map.put("verzoek", newData);

    existingArray.push(map);

    return java.util.Arrays.asList(existingArray);
}

addToArray(informatieverzoekenArray, verzoek);</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:failedJobRetryTimeCycle>R30/PT2S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1bq2l7g</bpmn:incoming>
      <bpmn:outgoing>Flow_0z8phua</bpmn:outgoing>
    </bpmn:serviceTask>
