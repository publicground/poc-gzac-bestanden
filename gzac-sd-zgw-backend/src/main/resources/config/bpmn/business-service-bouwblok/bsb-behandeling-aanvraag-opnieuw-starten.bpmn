  <bpmn:process id="bsb-behandeling-aanvraag-opnieuw-starten" name="BSB Behandeling aanvraag opnieuw starten" isExecutable="true">
    <bpmn:serviceTask id="OphalenInputTask" name="ophalen input" camunda:asyncAfter="true" camunda:expression="${true}" camunda:resultVariable="test">
      <bpmn:extensionElements>
