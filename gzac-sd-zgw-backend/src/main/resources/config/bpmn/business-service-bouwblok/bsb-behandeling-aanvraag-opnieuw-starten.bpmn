      <bpmn:outgoing>Flow_19ih433</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="BsBehandelingAanvraagOpnieuwStartenCallActivity" name="bs behandeling aanvraag opnieuw starten" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="bs-behandeling-aanvraag-opnieuw-starten">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out source="vervaldatum" target="vervaldatum" />
        <camunda:out source="vervalreden" target="vervalreden" />
        <camunda:inputOutput>
          <camunda:inputParameter name="besluit">${besluiten.get(besluiten.size()-1)}</camunda:inputParameter>
          <camunda:outputParameter name="besluit">
            <camunda:script scriptFormat="javascript">var besluit = execution.getVariable("besluit");
var vervaldatum = execution.getVariable("vervaldatum");
var vervalreden = execution.getVariable("vervalreden");

if (!!vervaldatum) {
    besluit.vervaldatum = vervaldatum;
}
if (!!vervalreden) {
    besluit.vervalreden = vervalreden;
}

if (!!besluit.versneldBeslist) {
    besluit.versneldBeslist = false;
}

result = besluit;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="versneldBeslist">false</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0y5mlxe</bpmn:incoming>
      <bpmn:outgoing>Flow_0eurcds</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="WegschrijvenOutputTask" name="wegschrijven output" camunda:asyncBefore="true" camunda:expression="${valueResolverDelegateService.handleValue(execution, &#34;doc:/besluiten&#34;, besluiten)}" camunda:resultVariable="">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="besluiten">
            <camunda:script scriptFormat="javascript">var besluiten = execution.getVariable("besluiten");
var besluit = execution.getVariable("besluit");

besluiten = besluiten instanceof java.util.List ? Java.from(besluiten) : [];

if (besluiten.length &gt; 0) {
  besluiten.pop();
}

besluiten.push(besluit);
result = java.util.Arrays.asList(besluiten);</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:failedJobRetryTimeCycle>R30/PT2S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0eurcds</bpmn:incoming>
      <bpmn:outgoing>Flow_04minvh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_10euerk">
      <bpmn:incoming>Flow_04minvh</bpmn:incoming>
      <bpmn:incoming>Flow_19ih433</bpmn:incoming>
      <bpmn:outgoing>Flow_0v9gsap</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1bmp3er">
      <bpmn:incoming>Flow_0v9gsap</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
