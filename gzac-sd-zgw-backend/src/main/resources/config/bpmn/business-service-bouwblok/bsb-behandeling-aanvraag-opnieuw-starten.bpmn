    <bpmn:sequenceFlow id="Flow_0eurcds" sourceRef="BsBehandelingAanvraagOpnieuwStartenCallActivity" targetRef="WegschrijvenOutputTask" />
    <bpmn:sequenceFlow id="Flow_04minvh" sourceRef="WegschrijvenOutputTask" targetRef="Gateway_10euerk" />
    <bpmn:sequenceFlow id="Flow_0y5mlxe" name="Ja" sourceRef="Gateway_03627qe" targetRef="BsBehandelingAanvraagOpnieuwStartenCallActivity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${not empty besluiten and not empty besluiten[besluiten.size() - 1].genomenBesluit}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0v9gsap" sourceRef="Gateway_10euerk" targetRef="Event_1bmp3er" />
    <bpmn:sequenceFlow id="Flow_19ih433" name="Nee" sourceRef="Gateway_03627qe" targetRef="Gateway_10euerk" />
    <bpmn:exclusiveGateway id="Gateway_03627qe" name="Besluit aanwezig?" default="Flow_19ih433">
